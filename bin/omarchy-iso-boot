#!/bin/bash

set -e

ISO=""
REUSE=""
SSH_HOST="${OMARCHY_VM_SSH_HOST:-127.0.0.1}"
SSH_PORT="${OMARCHY_VM_SSH_PORT:-2222}"
NETWORK="${OMARCHY_VM_NETWORK:-1}"
DISK="${OMARCHY_VM_DISK:-/tmp/omarchy-iso-boot.qcow2}"
HOST_ARCH=$(uname -m)
# The VM runs the host's architecture under KVM: an aarch64 host boots
# aarch64 ISOs in a virt machine, an x86_64 host boots x86_64 ISOs in q35.
if [[ $HOST_ARCH == aarch64 ]]; then
  OVMF_VARS="${OMARCHY_VM_OVMF_VARS:-/tmp/QEMU_VARS.aarch64.fd}"
else
  OVMF_VARS="${OMARCHY_VM_OVMF_VARS:-/tmp/OVMF_VARS.4m.fd}"
fi
EXTRA_QEMU_ARGS=()

usage() {
  cat <<USAGE
Usage: omarchy-iso-boot [options] [release/omarchy.iso] [reuse]

Options:
  --reuse              Reuse the existing VM disk
  --ssh-port PORT      Forward host PORT to guest port 22 (default: $SSH_PORT)
  --ssh-host HOST      Host address for SSH forwarding (default: $SSH_HOST)
  --no-network         Boot without a virtual NIC
  --disk PATH          VM disk path (default: $DISK)
  --ovmf-vars PATH     UEFI vars path (default: $OVMF_VARS)
  -h, --help           Show this help
  --                   Pass the remaining arguments directly to QEMU

SSH access after starting sshd in the guest:
  ssh -p $SSH_PORT root@localhost
  scp -P $SSH_PORT /path/to/system-manifest root@localhost:/tmp/
USAGE
}

while (( $# > 0 )); do
  case "$1" in
    --reuse|reuse)
      REUSE="reuse"
      shift
      ;;
    --ssh-port)
      SSH_PORT="${2:-}"
      shift 2
      ;;
    --ssh-port=*)
      SSH_PORT="${1#*=}"
      shift
      ;;
    --ssh-host)
      SSH_HOST="${2:-}"
      shift 2
      ;;
    --ssh-host=*)
      SSH_HOST="${1#*=}"
      shift
      ;;
    --no-network|--no-net)
      NETWORK=0
      shift
      ;;
    --disk)
      DISK="${2:-}"
      shift 2
      ;;
    --disk=*)
      DISK="${1#*=}"
      shift
      ;;
    --ovmf-vars)
      OVMF_VARS="${2:-}"
      shift 2
      ;;
    --ovmf-vars=*)
      OVMF_VARS="${1#*=}"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      EXTRA_QEMU_ARGS+=("$@")
      break
      ;;
    *)
      if [[ -z $ISO ]]; then
        ISO="$1"
      else
        echo "Unexpected argument: $1" >&2
        usage >&2
        exit 1
      fi
      shift
      ;;
  esac
done

if [[ -z $ISO && -t 0 ]]; then
  ISO=$(ls -t release/*.iso 2>/dev/null | gum choose --header "Select ISO to boot")
  if gum confirm --default=false "Reuse existing disk?"; then
    REUSE="reuse"
  fi
fi

if [[ -z $ISO ]]; then
  usage
  exit 1
fi

if [[ -z $DISK || -z $OVMF_VARS ]]; then
  echo "Disk and OVMF vars paths must not be empty" >&2
  exit 1
fi

if [[ $HOST_ARCH == aarch64 ]]; then
  # Arch Linux ARM carries QEMU but no aarch64 UEFI firmware; Arch's own
  # edk2-aarch64 is architecture-independent and provides it.
  omarchy-pkg-add qemu-desktop
  UEFI_CODE=/usr/share/edk2/aarch64/QEMU_EFI.fd
  UEFI_VARS_TEMPLATE=/usr/share/edk2/aarch64/QEMU_VARS.fd
  if [[ ! -f $UEFI_CODE || ! -f $UEFI_VARS_TEMPLATE ]]; then
    echo "Missing aarch64 UEFI firmware ($UEFI_CODE)." >&2
    echo "Install Arch's edk2-aarch64 (arch=any) from https://archlinux.org/packages/extra/any/edk2-aarch64/" >&2
    echo "after checking its signature with pacman-key --verify, then: sudo pacman -U edk2-aarch64-*.pkg.tar.zst" >&2
    exit 1
  fi
else
  omarchy-pkg-add qemu-full edk2-ovmf
  UEFI_CODE=/usr/share/edk2/x64/OVMF_CODE.4m.fd
  UEFI_VARS_TEMPLATE=/usr/share/edk2/x64/OVMF_VARS.4m.fd
fi

if [[ -z ${WAYLAND_DISPLAY:-} && -z ${DISPLAY:-} ]]; then
  while IFS='=' read -r name value; do
    case "$name" in
      WAYLAND_DISPLAY|DISPLAY|XAUTHORITY|XDG_SESSION_TYPE)
        export "$name=$value"
        ;;
    esac
  done < <(systemctl --user show-environment 2>/dev/null || true)
fi

if [[ -z ${WAYLAND_DISPLAY:-} && -z ${DISPLAY:-} ]]; then
  echo "Unable to find a graphical session for QEMU." >&2
  echo "Run omarchy-iso-boot from the Omarchy desktop session." >&2
  exit 1
fi

if [[ ! -f $DISK || $REUSE != "reuse" ]]; then
  qemu-img create -f qcow2 "$DISK" 40G
  cp "$UEFI_VARS_TEMPLATE" "$OVMF_VARS"
fi

NET_ARGS=()
if [[ $NETWORK != "0" && $NETWORK != "false" && $NETWORK != "no" ]]; then
  if [[ -n $SSH_PORT && $SSH_PORT != "0" ]]; then
    NET_ARGS=(-netdev "user,id=net0,hostfwd=tcp:${SSH_HOST}:${SSH_PORT}-:22" -device virtio-net-pci,netdev=net0)
    echo "SSH forwarding enabled: ssh -p $SSH_PORT root@localhost"
    echo "SCP example: scp -P $SSH_PORT /path/to/system-manifest root@localhost:/tmp/"
  else
    NET_ARGS=(-netdev user,id=net0 -device virtio-net-pci,netdev=net0)
    echo "Networking enabled without SSH port forwarding."
  fi
else
  echo "Networking disabled."
fi

# One core type only: KVM vCPUs that move between big and little cores see
# different CPU IDs and counters. Use the fastest cores the host has.
fastest_cores() {
  local cpu fastest=0 freq
  local -a cores=()
  for cpu in /sys/devices/system/cpu/cpu[0-9]*; do
    freq=$(<"$cpu/cpufreq/cpuinfo_max_freq")
    if (( freq > fastest )); then
      fastest=$freq
      cores=("${cpu##*cpu}")
    elif (( freq == fastest )); then
      cores+=("${cpu##*cpu}")
    fi
  done
  local IFS=,
  echo "${cores[*]}"
}

# Boot from ISO before we've installed, then boot from drive after
if [[ $HOST_ARCH == aarch64 ]]; then
  cores=$(fastest_cores)
  core_count=$(tr ',' '\n' <<<"$cores" | wc -l)
  if [[ ${OMARCHY_VM_GL:-1} == "0" ]]; then
    DISPLAY_ARGS=(-device virtio-gpu-pci -display gtk)
  else
    DISPLAY_ARGS=(-device virtio-gpu-gl-pci -display sdl,gl=on)
  fi
  taskset -c "$cores" qemu-system-aarch64 \
    -machine virt,gic-version=host -accel kvm -cpu host,pmu=off \
    -smp "$((core_count < 8 ? core_count : 8))" \
    -m 8192 \
    -drive if=pflash,format=raw,readonly=on,file="$UEFI_CODE" \
    -drive if=pflash,format=raw,file="$OVMF_VARS" \
    -drive file="$DISK",format=qcow2,if=none,id=drive0 \
    -device virtio-blk-pci,drive=drive0,bootindex=1 \
    -device virtio-scsi-pci,id=scsi0 \
    -drive file="$ISO",media=cdrom,if=none,format=raw,readonly=on,id=cdrom0 \
    -device scsi-cd,bus=scsi0.0,drive=cdrom0,bootindex=2 \
    "${DISPLAY_ARGS[@]}" \
    -device qemu-xhci,id=xhci -device usb-kbd,bus=xhci.0 -device usb-tablet,bus=xhci.0 \
    -device virtio-rng-pci \
    -serial file:/tmp/omarchy-iso-boot-serial.log \
    "${NET_ARGS[@]}" \
    -boot menu=on \
    "${EXTRA_QEMU_ARGS[@]}"
else
  qemu-system-x86_64 \
    -cpu host -enable-kvm -machine q35,accel=kvm \
    -smp "$(($(nproc) < 8 ? $(nproc) : 8))" \
    -m 8192 \
    -drive if=pflash,format=raw,readonly=on,file="$UEFI_CODE" \
    -drive if=pflash,format=raw,file="$OVMF_VARS" \
    -drive file="$DISK",format=qcow2,if=none,id=drive0 \
    -device virtio-blk-pci,drive=drive0,bootindex=1 \
    -drive file="$ISO",media=cdrom,if=none,format=raw,id=cdrom0 \
    -device ide-cd,drive=cdrom0,bootindex=2 \
    -device virtio-vga-gl \
    -display sdl,gl=on \
    -usb -device usb-tablet \
    -serial none \
    "${NET_ARGS[@]}" \
    -boot menu=on \
    "${EXTRA_QEMU_ARGS[@]}"
fi
