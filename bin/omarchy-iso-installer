#!/usr/bin/env bash
# Preview the shipped Omarchy installer dashboard without building an ISO.
#
#   OMI_KIT=<omi-kit folder>   try another Omi kit (default: the one the ISO ships)
#   PREVIEW_TIME=<seconds>     how long the simulated install takes (about 12)
#   PREVIEW_FAIL=<phase>       stop in that phase, for the failure screen
#   OMARCHY_OMI_TURN=<seconds> how long each of Omi's turns lasts, at least (15)
set -euo pipefail

# The dashboard drives the package phase from the target's pacman database, so
# fake one here; without it the preview falls back to its time curve and the bar
# barely moves, which reads as a bug.
PREVIEW_PACKAGES="${PREVIEW_PACKAGES:-925}"

write_simulation_state() {
  local state_file="$1" started_at="$2" phase_started_at="$3" current_phase="$4"
  local target="$5" index="$6" total="$7"
  local finished_at="${8:-null}" temporary="${state_file}.tmp"

  jq -n \
    --argjson started_at "$started_at" \
    --argjson phase_started_at "$phase_started_at" \
    --arg current_phase "$current_phase" \
    --arg target "$target" \
    --argjson current_index "$index" \
    --argjson total_phases "$total" \
    --argjson finished_at "$finished_at" \
    '{
      started_at: $started_at,
      phase_started_at: $phase_started_at,
      current_phase: $current_phase,
      target: $target,
      current_index: $current_index,
      total_phases: $total_phases
    } + if $finished_at == null then {} else {finished_at: $finished_at} end' \
    >"$temporary"
  mv -f -- "$temporary" "$state_file"
}

# Fill the fake database over the phase's duration, so the bar is driven by the
# same count it uses on a real install.
simulate_packages() {
  local db="$1" duration="$2" total="$3" steps=25 i n made=0
  for ((i = 1; i <= steps; i++)); do
    n=$(( total * i / steps ))
    while (( made < n )); do
      mkdir -p "$db/preview-$made-1.0-1"
      made=$((made + 1))
    done
    sleep "$(awk -v d="$duration" -v s="$steps" 'BEGIN { printf "%.3f", d / s }')"
  done
}

simulate_install() {
  local state_file="$1"
  local started_at="$EPOCHREALTIME"
  local phase phase_started_at finished_at duration i index total
  local target db
  target="$(dirname -- "$state_file")/target"
  db="$target/var/lib/pacman/local"
  mkdir -p "$db"
  local -a phases=(
    "Starting installation" 0.5
    "Preparing live environment" 0.8
    "Preparing install target" 0.3
    "Installing Arch + Omarchy" 5.0
    "Configuring hibernation" 0.4
    "Configuring system" 1.2
    "Finalizing Limine boot" 1.0
    "Finalizing user" 1.0
    "Configuring login" 0.6
    "Configuring DNS resolver" 0.3
    "Validating boot setup" 0.8
  )
  total=$(( ${#phases[@]} / 2 ))

  # PREVIEW_TIME stretches (or shrinks) every phase alike so the whole install
  # takes that many seconds, long enough to watch Omi's loops play through.
  local scale=1 sum=0
  for ((i = 1; i < ${#phases[@]}; i += 2)); do
    sum=$(awk -v a="$sum" -v b="${phases[i]}" 'BEGIN { print a + b }')
  done
  if [[ -n ${PREVIEW_TIME:-} ]]; then
    scale=$(awk -v t="$PREVIEW_TIME" -v s="$sum" 'BEGIN { print t / s }')
  fi

  for ((i = 0; i < ${#phases[@]}; i += 2)); do
    phase="${phases[i]}"
    duration=$(awk -v d="${phases[i + 1]}" -v k="$scale" 'BEGIN { printf "%.3f", d * k }')
    index=$(( i / 2 ))
    phase_started_at="$EPOCHREALTIME"
    write_simulation_state "$state_file" "$started_at" "$phase_started_at" \
      "$phase" "$target" "$index" "$total"
    if [[ $phase == "Installing Arch + Omarchy" ]]; then
      simulate_packages "$db" "$duration" "$PREVIEW_PACKAGES"
    else
      sleep "$duration"
    fi
    # PREVIEW_FAIL names a phase to stop in, for the failure screen.
    if [[ $phase == "${PREVIEW_FAIL:-}" ]]; then
      jq --arg phase "$phase" '.phases = [{name: $phase, status: "failed", error: "preview failure"}]' \
        "$state_file" >"$state_file.tmp" && mv -f -- "$state_file.tmp" "$state_file"
      echo "Preview failure in $phase" >&2
      exit 1
    fi
  done

  finished_at="$EPOCHREALTIME"
  write_simulation_state "$state_file" "$started_at" "$finished_at" \
    "Installation complete" "$target" "$(( total - 1 ))" "$total" "$finished_at"
  sleep 0.3
}

if [[ ${1:-} == "--simulate-install" ]]; then
  (( $# == 2 )) || exit 2
  simulate_install "$2"
  exit
fi

if (( $# > 0 )); then
  echo "Usage: $0" >&2
  exit 2
fi

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
dashboard="$repo_root/configs/airootfs/usr/local/bin/omarchy-install-dashboard"

if [[ ! -x $dashboard ]]; then
  echo "Installer dashboard is not executable: $dashboard" >&2
  exit 1
fi

if [[ -z ${OMARCHY_PATH:-} ]]; then
  for candidate in "$repo_root/../omarchy" /usr/share/omarchy; do
    if [[ -f $candidate/logo.txt ]]; then
      export OMARCHY_PATH="$candidate"
      break
    fi
  done
fi

if [[ -z ${OMARCHY_PATH:-} || ! -f $OMARCHY_PATH/logo.txt ]]; then
  echo "Unable to find Omarchy logo.txt; set OMARCHY_PATH to an Omarchy checkout." >&2
  exit 1
fi

preview_dir="$(mktemp -d)"
cleanup() {
  rm -rf "$preview_dir"
}
trap cleanup EXIT

# Omi: the dashboard runs its player from OMARCHY_OMI_DIR (omi.awk, omi.jq and
# omi.json), here the ones the ISO ships. OMI_KIT swaps in another kit, an
# omi-kit folder (an omi checkout's kit/), to try it before it's copied in.
omi_dir="$repo_root/configs/airootfs/usr/share/omarchy-iso/omi"
if [[ -z ${OMARCHY_OMI_DIR:-} && -n ${OMI_KIT:-} ]]; then
  mkdir -p "$preview_dir/omi"
  cp "$omi_dir"/omi.{awk,jq} "$OMI_KIT/omi.json" "$preview_dir/omi/"
  export OMARCHY_OMI_DIR="$preview_dir/omi"
fi
export OMARCHY_OMI_DIR="${OMARCHY_OMI_DIR:-$omi_dir}"

# The live system's console palette (Tokyo Night, from .automated_script.sh),
# so the preview looks like the console; the terminal's own comes back after.
# A Linux console can't be asked with an escape, so its sixteen colors are read
# with the kernel's GIO_CMAP before they change (as \e]P sequences to put them
# back); without that, \e]R puts back the console's default palette.
saved_palette=""
if [[ ${TERM:-linux} == linux ]]; then
  saved_palette="$(python3 -I -c '
import fcntl, sys
cmap = bytearray(48)
with open("/dev/tty", "rb", buffering=0) as tty:
    fcntl.ioctl(tty, 0x4B70, cmap)  # GIO_CMAP
sys.stdout.write("".join("\033]P%X%02x%02x%02x" % (i, *cmap[3 * i:3 * i + 3]) for i in range(16)))
' 2>/dev/null)" || saved_palette=""
fi
console_palette() {
  local i colors=(1a1b26 f7768e 9ece6a e0af68 7aa2f7 bb9af7 7dcfff a9b1d6
    414868 f7768e 9ece6a e0af68 7aa2f7 bb9af7 7dcfff c0caf5)
  if [[ ${TERM:-linux} == linux ]]; then
    for i in "${!colors[@]}"; do printf '\e]P%X%s' "$i" "${colors[i]}"; done
  else
    for i in "${!colors[@]}"; do printf '\e]4;%d;#%s\a' "$i" "${colors[i]}"; done
    printf '\e]10;#a9b1d6\a\e]11;#1a1b26\a'
  fi
}
terminal_palette() {
  if [[ ${TERM:-linux} == linux ]]; then
    printf '%s' "${saved_palette:-$'\e]R'}"
  else
    printf '\e]104\a\e]110\a\e]111\a'
  fi
}
console_palette
trap 'terminal_palette; cleanup' EXIT

log_file="$preview_dir/install.log"
state_file="$preview_dir/state.json"
touch "$log_file"

# Match what the simulated database will reach, so the preview shows the
# package-driven bar rather than the missing-signal fallback.
printf '%s\n' "$PREVIEW_PACKAGES" >"$preview_dir/expected-packages"

OMARCHY_UI_AUTO_REBOOT=no \
  OMARCHY_EXPECTED_PACKAGES_FILE="$preview_dir/expected-packages" \
  PREVIEW_PACKAGES="$PREVIEW_PACKAGES" \
  PREVIEW_FAIL="${PREVIEW_FAIL:-}" \
  PREVIEW_TIME="${PREVIEW_TIME:-}" \
  "$dashboard" "$log_file" "$state_file" -- \
  "$0" --simulate-install "$state_file"
