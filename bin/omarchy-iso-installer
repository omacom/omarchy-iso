#!/usr/bin/env bash
# Preview the shipped Omarchy installer dashboard without building an ISO.
#
# The dashboard reads the systemd phase-unit graph as the install's state,
# so the preview stands a fixture of it up: fake unit files for the roster,
# a stub systemctl that answers `show` from a playback directory, and a
# simulator that advances the playback the way the real graph latches.
set -euo pipefail

# The dashboard drives the package phase from the target's pacman database, so
# fake one here; without it the preview falls back to its time curve and the bar
# barely moves, which reads as a bug.
PREVIEW_PACKAGES="${PREVIEW_PACKAGES:-925}"

# Display name, duration. The unpack publishes stream progress the way the
# real phase does (sd_notify STATUS=, here the playback's status file).
PHASES=(
  "Preparing live environment" 0.8
  "Preparing install target" 0.3
  "Unpacking root image" 3.0
  "Installing Arch + Omarchy" 5.0
  "Configuring hibernation" 0.4
  "Configuring system" 1.2
  "Finalizing Limine boot" 1.0
  "Finalizing user" 1.0
  "Configuring login" 0.6
  "Configuring DNS resolver" 0.3
  "Validating boot setup" 0.8
)

slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z' '-' | tr -s '-'
}

# Fill the fake database over the phase's duration, so the bar is driven by the
# same count it uses on a real install.
simulate_packages() {
  local db="$1" duration="$2" total="$3" steps=25 i n
  for ((i = 1; i <= steps; i++)); do
    n=$(( total * i / steps ))
    while (( $(ls -1 "$db" 2>/dev/null | wc -l) < n )); do
      mkdir -p "$db/preview-$(( $(ls -1 "$db" 2>/dev/null | wc -l) ))-1.0-1"
    done
    sleep "$(awk -v d="$duration" -v s="$steps" 'BEGIN { printf "%.3f", d / s }')"
  done
}

simulate_stream_progress() {
  local dir="$1" duration="$2" steps=20 i
  for ((i = 1; i <= steps; i++)); do
    awk -v i="$i" -v s="$steps" 'BEGIN { printf "progress=%.4f", i / s }' >"$dir/status"
    sleep "$(awk -v d="$duration" -v s="$steps" 'BEGIN { printf "%.3f", d / s }')"
  done
}

simulate_install() {
  local dir="$1" i n phase duration
  local db="$dir/target/var/lib/pacman/local"
  mkdir -p "$db"
  # Before any unit runs the dashboard names the pre-graph work itself.
  sleep 0.5
  n=$(( ${#PHASES[@]} / 2 ))
  for ((i = 0; i < n; i++)); do
    phase="${PHASES[i * 2]}"
    duration="${PHASES[i * 2 + 1]}"
    printf '%s\n' "$i" >"$dir/current"
    : >"$dir/status"
    case "$phase" in
      "Installing Arch + Omarchy") simulate_packages "$db" "$duration" "$PREVIEW_PACKAGES" ;;
      "Unpacking root image") simulate_stream_progress "$dir" "$duration" ;;
      *) sleep "$duration" ;;
    esac
  done
  printf '%s\n' "$n" >"$dir/current"
  sleep 0.3
}

if [[ ${1:-} == "--simulate-install" ]]; then
  (( $# == 2 )) || exit 2
  simulate_install "$2"
  exit 0
fi

if (( $# > 0 )); then
  echo "Usage: $0" >&2
  exit 2
fi

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
dashboard="$repo_root/configs/airootfs/usr/local/bin/omarchy-install-dashboard"

if [[ ! -x $dashboard ]]; then
  echo "Installer dashboard is not executable: $dashboard" >&2
  exit 1
fi

if [[ -z ${OMARCHY_PATH:-} ]]; then
  for candidate in "$repo_root/../omarchy" /usr/share/omarchy; do
    if [[ -f $candidate/logo.txt ]]; then
      export OMARCHY_PATH="$candidate"
      break
    fi
  done
fi

if [[ -z ${OMARCHY_PATH:-} || ! -f $OMARCHY_PATH/logo.txt ]]; then
  echo "Unable to find Omarchy logo.txt; set OMARCHY_PATH to an Omarchy checkout." >&2
  exit 1
fi

preview_dir="$(mktemp -d)"
cleanup() {
  rm -rf "$preview_dir"
}
trap cleanup EXIT

log_file="$preview_dir/install.log"
touch "$log_file"

# The unit-graph fixture: one fake unit file per phase, chained by Requires=
# the way the real graph is, listed in order for the stub's index lookup.
units_dir="$preview_dir/units"
mkdir -p "$units_dir" "$preview_dir/bin"
: >"$preview_dir/order"
prev=""
for ((i = 0; i < ${#PHASES[@]}; i += 2)); do
  phase="${PHASES[i]}"
  unit="omarchy-install-$(slugify "$phase").service"
  {
    echo "[Service]"
    [[ -n $prev ]] && printf 'Requires=%s\n' "$prev"
    printf 'ExecStart=/usr/bin/env run-phase sim_phase "%s"\n' "$phase"
  } >"$units_dir/$unit"
  printf '%s\n' "$unit" >>"$preview_dir/order"
  prev=$unit
done
printf '%s\n' "-1" >"$preview_dir/current"

# The stub systemctl: answers `show <units...> -p ActiveState,StatusText`
# from the playback directory, in real systemctl's block format.
cat >"$preview_dir/bin/systemctl" <<EOF
#!/bin/bash
dir="$preview_dir"
[[ \${1:-} == show ]] || exit 0
cur=\$(cat "\$dir/current" 2>/dev/null || echo -1)
status=\$(cat "\$dir/status" 2>/dev/null || echo "")
first=1
for u in "\$@"; do
  [[ \$u == omarchy-install-*.service ]] || continue
  n=\$(grep -nxF "\$u" "\$dir/order" | cut -d: -f1) || continue
  n=\$((n - 1))
  (( first )) || echo
  first=0
  if (( n < cur )); then
    echo "ActiveState=active"; echo "StatusText="
  elif (( n == cur )); then
    echo "ActiveState=activating"; echo "StatusText=\$status"
  else
    echo "ActiveState=inactive"; echo "StatusText="
  fi
done
EOF
chmod +x "$preview_dir/bin/systemctl"

# Match what the simulated database will reach, so the preview shows the
# package-driven bar rather than the missing-signal fallback.
printf '%s\n' "$PREVIEW_PACKAGES" >"$preview_dir/expected-packages"

OMARCHY_UI_AUTO_REBOOT=no \
  OMARCHY_EXPECTED_PACKAGES_FILE="$preview_dir/expected-packages" \
  OMARCHY_INSTALL_UNITS_DIR="$units_dir" \
  OMARCHY_INSTALL_TARGET="$preview_dir/target" \
  OMARCHY_INSTALL_STATE_DIR="$preview_dir" \
  PATH="$preview_dir/bin:$PATH" \
  PREVIEW_PACKAGES="$PREVIEW_PACKAGES" \
  "$dashboard" "$log_file" -- \
  "$0" --simulate-install "$preview_dir"
