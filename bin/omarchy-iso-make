#!/bin/bash

set -e

NO_CACHE=""
KEEP_PKG_CACHE=""
LOCAL_OMARCHY_PATH=""
LOCAL_PKGS_PATH=""
N1X_DEV_SSH_KEY=""
PACKAGE_DIR=""
LOCAL_REPO_PATH=""
while [[ $# -gt 0 ]]; do
  case $1 in
  --arch|--media-target)
    if [[ -z ${2:-} || $2 == --* ]]; then
      echo "Error: $1 requires a value" >&2
      exit 1
    fi
    if [[ $1 == --arch ]]; then
      OMARCHY_ARCH=$2
    else
      OMARCHY_MEDIA_TARGET=$2
    fi
    shift 2
    ;;
  --platform)
    # The NVIDIA N1x image, the same as --media-target aarch64/n1x: it selects
    # the linux-omarchy-n1x kernel and the hardware-probe recovery entry.
    if [[ ${2:-} != n1x ]]; then
      echo "Error: --platform must be n1x" >&2
      exit 1
    fi
    OMARCHY_MEDIA_TARGET=aarch64/n1x
    shift 2
    ;;
  --dev-ssh)
    # DEV ONLY: bakes the given public key into an N1x image for key-only root
    # SSH on the live ISO and the installed system (builder/n1x-dev-ssh/).
    N1X_DEV_SSH_KEY="${2:-}"
    if [[ -z $N1X_DEV_SSH_KEY ]]; then
      echo "Error: --dev-ssh requires a public key file" >&2
      exit 1
    fi
    shift 2
    ;;
  --package-dir)
    # The platform's own aarch64 packages, which no repository publishes: its
    # kernel and headers, plus anything pinned to a version proven on the
    # hardware. The directory must carry a SHA256SUMS covering every archive.
    PACKAGE_DIR="${2:-}"
    if [[ -z $PACKAGE_DIR ]]; then
      echo "Error: --package-dir requires a directory" >&2
      exit 1
    fi
    shift 2
    ;;
  --local-repo)
    LOCAL_REPO_PATH="${2:-}"
    if [[ -z $LOCAL_REPO_PATH ]]; then
      echo "Error: --local-repo requires a directory holding a built [omarchy] repo (omarchy.db + packages)" >&2
      exit 1
    fi
    shift 2
    ;;
  --no-cache)
    NO_CACHE=1
    shift
    ;;
  --keep-pkg-cache)
    KEEP_PKG_CACHE=1
    shift
    ;;
  --no-boot-offer)
    NO_BOOT_OFFER=1
    shift
    ;;
  --debug)
    OMARCHY_INSTALL_DEBUG=1
    shift
    ;;
  --edge)
    OMARCHY_ISO_REF=edge
    OMARCHY_MIRROR=edge
    shift
    ;;
  --local-source)
    LOCAL_OMARCHY_PATH="${2:-}"
    LOCAL_PKGS_PATH="${3:-}"
    if [[ -z $LOCAL_OMARCHY_PATH || -z $LOCAL_PKGS_PATH ]]; then
      echo "Error: --local-source requires two args: <omarchy-checkout> <pkgs-checkout>" >&2
      exit 1
    fi
    OMARCHY_MIRROR=edge
    OMARCHY_ISO_REF=local
    shift 3
    ;;
  --dev)
    OMARCHY_ISO_REF=dev
    OMARCHY_MIRROR=edge
    shift
    ;;
  --quattro)
    OMARCHY_INSTALLER_REF=quattro
    OMARCHY_MIRROR=edge
    shift
    ;;
  --rc)
    OMARCHY_ISO_REF=rc
    OMARCHY_MIRROR=rc
    shift
    ;;
  *)
    echo "Unknown option: $1"
    echo "Usage: $0 [--arch x86_64|aarch64] [--media-target x86_64/pc|aarch64/snapdragon|aarch64/generic|aarch64/n1x] [--no-cache] [--keep-pkg-cache] [--no-boot-offer] [--debug] [--edge] [--dev|--rc] [--local-source <omarchy-checkout> <pkgs-checkout>] [--local-repo <repo-dir>]"
    echo "       $0 --arch aarch64 --platform n1x [--dev-ssh <pubkey>] --package-dir DIR --local-source <omarchy-checkout> <pkgs-checkout> [...]"
    exit 1
    ;;
  esac
done

BUILD_ROOT=$(cd "${BASH_SOURCE[0]%/*}/.." && pwd)
source "$BUILD_ROOT/builder/architecture.sh"

if [[ -n $LOCAL_OMARCHY_PATH ]]; then
  [[ -d $LOCAL_OMARCHY_PATH ]] || { echo "Error: Omarchy checkout not found at $LOCAL_OMARCHY_PATH" >&2; exit 1; }
  [[ -d $LOCAL_PKGS_PATH ]]    || { echo "Error: pkgs checkout not found at $LOCAL_PKGS_PATH" >&2; exit 1; }
  LOCAL_OMARCHY_PATH=$(realpath "$LOCAL_OMARCHY_PATH")
  LOCAL_PKGS_PATH=$(realpath "$LOCAL_PKGS_PATH")
fi

if [[ -n $LOCAL_REPO_PATH ]]; then
  [[ -f $LOCAL_REPO_PATH/omarchy.db ]] || { echo "Error: no omarchy.db in $LOCAL_REPO_PATH (build one with omarchy-pkgs: bin/repo build + bin/repo update)" >&2; exit 1; }
  LOCAL_REPO_PATH=$(realpath "$LOCAL_REPO_PATH")
fi

# The N1x image is built against Omarchy's edge aarch64 repository, needs the
# platform package bundle, and builds the omarchy* packages from --local-source
# because the platform support is not in the published ones.
if [[ $OMARCHY_ARM_PLATFORM == n1x ]]; then
  if [[ -z $PACKAGE_DIR ]]; then
    echo "Error: --platform n1x requires --package-dir DIR" >&2
    exit 1
  fi
  if [[ -z $LOCAL_OMARCHY_PATH ]]; then
    echo "Error: --platform n1x requires --local-source; the published omarchy packages lack the platform support" >&2
    exit 1
  fi
  if [[ $OMARCHY_MIRROR != edge ]]; then
    echo "Error: --platform n1x builds use the edge channel, the only one Omarchy publishes for aarch64; drop --rc" >&2
    exit 1
  fi
  [[ -d $PACKAGE_DIR ]] || { echo "Error: package directory not found at $PACKAGE_DIR" >&2; exit 1; }
  PACKAGE_DIR=$(realpath "$PACKAGE_DIR")
  if [[ ! -f $PACKAGE_DIR/SHA256SUMS ]]; then
    echo "Error: $PACKAGE_DIR must contain SHA256SUMS" >&2
    exit 1
  fi
  if ! (cd "$PACKAGE_DIR" && sha256sum --check --strict --quiet SHA256SUMS); then
    echo "Error: package bundle checksum verification failed in $PACKAGE_DIR" >&2
    exit 1
  fi
  if [[ -n $N1X_DEV_SSH_KEY ]]; then
    [[ -f $N1X_DEV_SSH_KEY ]] || { echo "Error: SSH public key not found at $N1X_DEV_SSH_KEY" >&2; exit 1; }
    N1X_DEV_SSH_KEY=$(realpath "$N1X_DEV_SSH_KEY")
    if ! grep -Eq '^(ssh-|ecdsa-|sk-)' "$N1X_DEV_SSH_KEY" || grep -Evq '^(ssh-|ecdsa-|sk-|#|$)' "$N1X_DEV_SSH_KEY"; then
      echo "Error: $N1X_DEV_SSH_KEY must hold public keys only, one per line" >&2
      exit 1
    fi
  fi
elif [[ -n $PACKAGE_DIR || -n $N1X_DEV_SSH_KEY ]]; then
  echo "Error: --package-dir and --dev-ssh are only valid with --platform n1x" >&2
  exit 1
fi

cd "$BUILD_ROOT"

lint_file_permissions() {
  local profiledef="configs/profiledef.sh"
  local declared
  local missing=()

  declared=$(sed -n 's/^[[:space:]]*\["\([^"]*\)"\].*/\1/p' "$profiledef")

  while IFS= read -r f; do
    [[ -f $f ]] || continue

    local rel="${f#configs/airootfs}"
    local mode
    mode=$(git ls-files --stage -- "$f" | awk '{print $1}')

    if [[ $mode != 100755 && $(head -c 2 "$f") != "#!" ]]; then
      continue
    fi

    if ! grep -Fxq -- "$rel" <<<"$declared"; then
      missing+=("$rel")
    fi
  done < <(find configs/airootfs/usr/local/bin configs/airootfs/root -type f 2>/dev/null)

  if (( ${#missing[@]} > 0 )); then
    echo "ERROR: the following executable files are missing from $profiledef file_permissions:" >&2
    printf '  %s\n' "${missing[@]}" >&2
    echo "Add entries like [\"<path>\"]=\"0:0:755\" to profiledef.sh and retry." >&2
    exit 1
  fi
}

lint_file_permissions

# Purging the host package cache needs interactive sudo; --keep-pkg-cache
# skips it so unattended builds (test rigs, agents) can run without a prompt.
# A cache of another architecture is never shared with the build (see below),
# so there is nothing to purge then.
if [[ -z $KEEP_PKG_CACHE && $(uname -s) == Linux && $(uname -m) == "$ISO_ARCH" ]]; then
  sudo rm -rf /var/cache/pacman/pkg/*
fi
git submodule update --init --recursive --jobs=8

BUILD_SCRIPT="builder/build-iso.sh"
BUILD_RELEASE_PATH="$BUILD_ROOT/release"
mkdir -p "$BUILD_RELEASE_PATH"

OMARCHY_ISO_REF="${OMARCHY_ISO_REF:-quattro}"
OMARCHY_MIRROR="${OMARCHY_MIRROR:-stable}"

DOCKER_ARGS=(
  --rm
  --privileged
  --platform "$DOCKER_PLATFORM"
  -e "OMARCHY_ARCH=$OMARCHY_ARCH"
  -e "OMARCHY_MEDIA_TARGET=$OMARCHY_MEDIA_TARGET"
  -e "OMARCHY_ISO_REF=$OMARCHY_ISO_REF"
  -e "OMARCHY_MIRROR=$OMARCHY_MIRROR"
  -e "OMARCHY_INSTALL_DEBUG=${OMARCHY_INSTALL_DEBUG:-}"
  -e "OMARCHY_N1X_DEV_SSH=${N1X_DEV_SSH_KEY:+1}"
  # Optional overrides of the Omarchy package pair build-iso.sh installs, e.g.
  # the release recipes (omarchy, omarchy-settings) built from --local-source
  # instead of the -dev ones that track quattro.
  -e "OMARCHY_RUNTIME_PACKAGE=${OMARCHY_RUNTIME_PACKAGE:-}"
  -e "OMARCHY_SETTINGS_PACKAGE=${OMARCHY_SETTINGS_PACKAGE:-}"
  -e "HOST_UID=$(id -u)"
  -e "HOST_GID=$(id -g)"
  -v "$BUILD_RELEASE_PATH/:/out/"
  -v "$BUILD_ROOT/$BUILD_SCRIPT:/$BUILD_SCRIPT:ro"
  -v "$BUILD_ROOT/archiso:/archiso:ro"
  -v "$BUILD_ROOT/builder:/builder:ro"
  -v "$BUILD_ROOT/configs:/configs:ro"
)

if [[ -n $LOCAL_OMARCHY_PATH ]]; then
  DOCKER_ARGS+=(
    -v "$LOCAL_OMARCHY_PATH:/omarchy-source:ro"
    -v "$LOCAL_PKGS_PATH:/omarchy-pkgs:ro"
  )
fi

if [[ $OMARCHY_ARM_PLATFORM == n1x ]]; then
  DOCKER_ARGS+=(-v "$PACKAGE_DIR:/packages:ro")
fi

if [[ -n $N1X_DEV_SSH_KEY ]]; then
  DOCKER_ARGS+=(-v "$N1X_DEV_SSH_KEY:/dev-ssh/authorized_keys:ro")
fi

# Mount a locally built Omarchy package repository when requested.
if [[ -n $LOCAL_REPO_PATH ]]; then
  DOCKER_ARGS+=(-v "$LOCAL_REPO_PATH:/omarchy-repo:ro")
fi

# The host pacman cache belongs to the host architecture; sharing it with a
# container of another one would leak foreign packages into the offline mirror.
if [[ $(uname -s) == Linux && $(uname -m) == "$ISO_ARCH" && -d /var/cache/pacman/pkg ]]; then
  DOCKER_ARGS+=(-v "/var/cache/pacman/pkg:/var/cache/pacman/pkg")
fi

# Mount the build cache directory where packages are downloaded. Channels and
# architectures use different package snapshots and must never share an
# offline mirror cache.
if [[ -z "$NO_CACHE" ]]; then
  case $OMARCHY_MEDIA_TARGET in
    # Keep the historical cache paths of the x86_64 and N1x builds.
    x86_64/pc) OFFLINE_REPO_BUILD_CACHE_DIR="$HOME/.cache/omarchy/iso_${OMARCHY_MIRROR}/airootfs/var/cache/omarchy" ;;
    aarch64/n1x) OFFLINE_REPO_BUILD_CACHE_DIR="$HOME/.cache/omarchy/iso_${OMARCHY_MIRROR}_${OMARCHY_ARCH}/airootfs/var/cache/omarchy" ;;
    *) OFFLINE_REPO_BUILD_CACHE_DIR="$HOME/.cache/omarchy/iso_${OMARCHY_MIRROR}/${OMARCHY_MEDIA_TARGET}/airootfs/var/cache/omarchy" ;;
  esac
  mkdir -p "$OFFLINE_REPO_BUILD_CACHE_DIR"
  DOCKER_ARGS+=(-v "$OFFLINE_REPO_BUILD_CACHE_DIR:/var/cache/airootfs/var/cache/omarchy")
else
  # The locally cached :latest image is a cache too — docker run never
  # re-checks the registry for it, so refresh it when building cold.
  DOCKER_ARGS+=(--pull=always)
fi

# The docker group is root-equivalent, so Omarchy operators stay out of it on
# purpose. When the socket refuses the calling user, run the client through
# sudo instead of requiring group membership.
DOCKER=(docker)
if ! docker version &>/dev/null; then
  DOCKER=(sudo docker)
fi

"${DOCKER[@]}" run "${DOCKER_ARGS[@]}" "$BUILD_IMAGE" /$BUILD_SCRIPT

latest_iso=$(\ls -t "$BUILD_RELEASE_PATH/$OMARCHY_ISO_NAME"-????.??.??-"$ISO_ARCH".iso | head -n1)
[[ -n $latest_iso ]] || { echo "No $OMARCHY_MEDIA_TARGET ISO produced" >&2; exit 1; }
if [[ $OMARCHY_ARM_PLATFORM == n1x ]]; then
  iso_ref="${latest_iso%.*}-n1x${N1X_DEV_SSH_KEY:+-devssh}-$OMARCHY_ISO_REF.iso"
else
  iso_ref="${latest_iso%.*}-$OMARCHY_ISO_REF.iso"
fi
mv -f "$latest_iso" "$iso_ref"

# omarchy-iso-boot runs the host's architecture under KVM.
if [[ -z "${NO_BOOT_OFFER:-}" && $(uname -m) == "$ISO_ARCH" ]]; then
  echo
  gum confirm "Boot $iso_ref?" && "$BUILD_ROOT/bin/omarchy-iso-boot" "$iso_ref"
fi
