#!/bin/bash

# A failed step must stop the release: without this, a make that dies (say,
# docker permission denied) falls through to signing and uploading whatever
# stale ISO release/ already holds, under the new release's name.
set -e

MAKE_ARGS=()
ISO_REF=quattro
RELEASE_SUFFIX=""
ARCH=x86_64

while [[ $# -gt 0 ]]; do
  case $1 in
  --no-make)
    MAKE_ARGS+=("$1")
    shift
    ;;
  --rc)
    MAKE_ARGS+=("$1")
    ISO_REF=rc
    RELEASE_SUFFIX="-rc"
    RC=1
    shift
    ;;
  --stable-from-rc)
    # The final release's ISO, built from rc before rc is promoted to stable,
    # and installed onto stable (omarchy-iso-make --stable-from-rc).
    MAKE_ARGS+=("$1")
    ISO_REF=release
    STABLE_FROM_RC=1
    shift
    ;;
  --arch)
    ARCH="${2:-}"
    case "$ARCH" in
    x86_64 | aarch64) ;;
    *)
      echo "Error: --arch must be x86_64 or aarch64" >&2
      exit 1
      ;;
    esac
    shift 2
    ;;
  -*)
    echo "Unknown option: $1"
    echo "Usage: omarchy-iso-release [--no-make] [--rc|--stable-from-rc] [--arch x86_64|aarch64] [version]"
    exit 1
    ;;
  *)
    if [[ -n "${BUILD_VERSION-}" ]]; then
      echo "Usage: omarchy-iso-release [--no-make] [--rc|--stable-from-rc] [--arch x86_64|aarch64] [version]"
      exit 1
    fi
    BUILD_VERSION="$1"
    shift
    ;;
  esac
done

if [[ -z "${BUILD_VERSION-}" ]]; then
  echo "Usage: omarchy-iso-release [--no-make] [--rc|--stable-from-rc] [--arch x86_64|aarch64] [version]"
  exit 1
fi

if [[ -n ${STABLE_FROM_RC:-} ]]; then
  if [[ -n ${RC:-} ]]; then
    echo "Error: --stable-from-rc builds a final release; it can't be combined with --rc" >&2
    exit 1
  fi
  if [[ $BUILD_VERSION == *rc* ]]; then
    echo "Error: --stable-from-rc builds a final release, not a candidate ($BUILD_VERSION)" >&2
    exit 1
  fi
fi

# The release's own packages have to be on rc before an ISO that installs them
# onto stable is built from it. Otherwise the ISO carries the last candidate,
# and the machines it installs move to whatever stable serves on their first
# update.
rc_serves_release() {
  local db_dir db listing package missing=()
  db_dir=$(mktemp -d)
  db="$db_dir/omarchy.db.tar.zst"
  if ! curl -fsSL "https://pkgs.omarchy.org/rc/$ARCH/omarchy.db.tar.zst" -o "$db" ||
    ! listing=$(tar -t --zstd -f "$db"); then
    rm -rf "$db_dir"
    echo "Error: could not read rc's $ARCH package database" >&2
    return 1
  fi
  rm -rf "$db_dir"
  for package in omarchy omarchy-settings; do
    grep -Eq "^$package-${BUILD_VERSION//./\\.}-[0-9]+/\$" <<<"$listing" || missing+=("$package")
  done
  if ((${#missing[@]})); then
    echo "Error: rc's $ARCH repository doesn't serve ${missing[*]} $BUILD_VERSION yet. Publish the release to rc first (release-rc.yml)." >&2
    return 1
  fi
}

# A version that already numbers its candidate (4.0.2rc2) is the complete
# artifact name; the bare -rc suffix exists only for an unnumbered candidate.
# Without this, every candidate of a train uploads over the same
# omarchy-X.Y.Z-rc.iso and testers cannot tell which rc they are holding.
if [[ $BUILD_VERSION == *rc* ]]; then
  RELEASE_SUFFIX=""
fi

# The x86_64 ISO keeps the plain name every download link already uses. Any
# other architecture says so, as the nightly's do, or it would upload over it.
ARCH_SUFFIX=""
if [[ $ARCH != x86_64 ]]; then
  ARCH_SUFFIX="-$ARCH"
fi

BUILD_ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
BUILD_RELEASE_PATH="$BUILD_ROOT/release"

# Make ISOs
if [[ ! " ${MAKE_ARGS[*]} " =~ " --no-make " ]]; then
  [[ -z ${STABLE_FROM_RC:-} ]] || rc_serves_release
  echo -e "\e[32mMaking $ISO_REF ISO\e[0m"
  omarchy-iso-make --arch "$ARCH" --no-cache --no-boot-offer "${MAKE_ARGS[@]}"
else
  echo -e "\e[31mSkipping remaking ISOs\e[0m"
fi

# Sign and upload ISO
latest_iso=$(\ls -t "$BUILD_RELEASE_PATH"/*"$ARCH-$ISO_REF".iso | head -n1)
release_iso="$BUILD_RELEASE_PATH/omarchy-$BUILD_VERSION$RELEASE_SUFFIX$ARCH_SUFFIX.iso"
cp "$latest_iso" "$release_iso"

echo -e "\e[32mSigning $ISO_REF ISO\e[0m"
omarchy-iso-sign "$release_iso"

# The checksum sidecar names the ISO alone, never the build path: it is
# downloaded next to the ISO and has to verify with `sha256sum -c` from
# whatever directory the person who downloaded it happens to be in. A release
# that cannot write it stops here, because the sidecar left over from the last
# release reads as a checksum for this one.
iso_sha=$(sha256sum "$release_iso")
iso_sha=${iso_sha%% *}
if [[ -z $iso_sha ]] || ! printf '%s  %s\n' "$iso_sha" "${release_iso##*/}" >"$release_iso.sha256"; then
  echo -e "\e[31mCould not write the checksum for $release_iso\e[0m" >&2
  exit 1
fi
echo -e "\e[32mSHA256 for $ISO_REF ISO: $iso_sha\e[0m"

omarchy-iso-upload "$release_iso"

# The whole point of a release is handing someone this pair.
echo -e "\e[32mReleased $ISO_REF ISO $BUILD_VERSION\e[0m"
echo "  URL:    https://iso.omarchy.org/${release_iso##*/}"
echo "  SHA256: $iso_sha"
echo "  Local:  $release_iso"
