#!/bin/bash
#
# Acceptance test harness: boots an Omarchy ISO in a headless QEMU VM and
# drives the real interactive install flow the way a user would — reading
# each screen through QMP screendumps + OCR, and answering with virtual
# keystrokes. Nothing in the product is bypassed or stubbed: the configurator
# wizard, install dashboard, reboot prompt, and SDDM login are all exercised.
#
# After first boot it logs into a console TTY (typed, like everything else)
# to authorize an SSH key, snapshots the installed disk, then boots a
# throwaway overlay and runs the in-guest acceptance suite (test/acceptance
# in the omarchy repo) over SSH.
#
# Usage: omarchy-iso-test [release/omarchy.iso] [options]
#
#   --keyboard LABEL   English (US/UK), Japanese, Japanese (US keyboard), Korean,
#                      or Chinese (Simplified, Pinyin), Taiwan (Zhuyin) or Hong Kong (Cangjie).
#                      OMARCHY_PATH must be the source tree used to build the ISO.
#   --encrypt          Drive the encrypted install flow (default: unencrypted)
#   --provision              Drive the deferred-provisioning install flow: no user during install, the
#                      first boot runs omarchy-provision-owner and creates it there
#   --oem              Test an OEM ISO: it installs onto the VM's one disk with
#                      no keystrokes, encrypted, and reboots into the first-boot
#                      setup, which is then driven the way --provision drives it
#   --oem-config FILE  The config the OEM ISO was built with (omarchy-iso-make
#                      --oem-config): first boot is then expected to carry its
#                      branding, and to end on its agreement where it has one
#   --free-space       Install into the free space of a synthetic Windows-style
#                      disk (existing ESP + data partition kept) and verify the
#                      existing partitions survive
#   --reuse-base       Skip the install phase if a base image already exists
#   --install-only     Stop after producing the installed base image
#   --sync-omarchy DIR Push DIR's test suite into the guest before running
#                      (defaults to OMARCHY_PATH when the suite is present)
#   --sync-all DIR     Push all of DIR (bin/config/shell/test) into the guest
#                      and also run the CLI and shell suites there
#   --port PORT        Host port forwarded to guest SSH (default 2222)
#   --memory MB        VM memory (default 8192)
#   --timeout SECS     Install timeout (default 2400)
#   --keep-running     Leave the acceptance VM running after the suite finishes
#   --no-preview       Do not open the collected screenshots in imv

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"

ISO=""
SSH_PORT=2222
MEMORY=8192
INSTALL_TIMEOUT=2400
BOOT_TIMEOUT=600
ENCRYPT=false
PROVISION=false
OEM=false
OEM_CONFIG=""
FREE_SPACE=false
REUSE_BASE=false
INSTALL_ONLY=false
KEEP_RUNNING=false
NO_PREVIEW=false
SYNC_DIR=""
SYNC_ALL=false

KEYBOARD_LABEL="English (US)"
# --fake-pci VENDOR:DEVICE:CLASS (hex, repeatable): hardware the VM should claim
# to have, e.g. 10de:2684:030000 (an RTX 4090) or 106b:1802:088000 (an Apple
# T2). Each is a vfio-user device whose IDs QEMU overrides: a real PCI function
# in the guest (lspci, sysfs, udev, modalias) that no driver can drive. What it
# exercises is everything that keys off the hardware being there: detection,
# the packages and kernel the install picks, DKMS builds, boot configuration.
# Needs QEMU 10.1 and a vfio-user server ($VFIO_USER_SERVER, by default
# libvfio-user's gpio-pci-idio-16 sample); see test/fake-pci.md.
FAKE_PCI=()
FAKE_PCI_PIDS=()
# --smbios TYPE-1-FIELDS (repeatable, QEMU syntax, a literal comma is ",,"):
# the DMI identity omarchy's hardware scripts match on, e.g.
#   --smbios "manufacturer=Framework,product=Laptop 16 (AMD Ryzen 7040 Series)"
#   --smbios "manufacturer=ASUSTeK COMPUTER INC.,family=ROG Flow Z13"
SMBIOS=()
# --cpu-id vendor=GenuineIntel,model=170: what /proc/cpuinfo reports (CPUID
# leaf values; KVM lets a guest claim any vendor and model). omarchy picks
# microcode by vendor and thermald/intel-lpmd by model number.
# --battery: an ACPI battery (BAT0, present, discharging) and a lid switch, as
# an SSDT compiled at run time (iasl). omarchy-battery-present and
# omarchy-hw-laptop read exactly these.
# --acpi-hid HID: an ACPI device with that _HID, e.g. OVTI08F4 (the IPU7
# camera sensor omarchy keys the camera package on).
# --no-network: no NIC at all. The harness then cannot reach the guest over
# SSH, so it stops once the installed system booted to its console login.
CPU_ID=""
BATTERY=false
ACPI_HIDS=()
NO_NETWORK=false

GUEST_USER="omarchy"
GUEST_PASSWORD="omarchy"
GUEST_HOSTNAME="omarchy-test"

while (($#)); do
  case "$1" in
    --keyboard) KEYBOARD_LABEL="$2"; shift ;;
    --encrypt) ENCRYPT=true ;;
    --provision) PROVISION=true ;;
    # An OEM install is a deferred-provisioning install nobody answers for:
    # always full-disk and encrypted (the configurator's --oem path).
    --oem) OEM=true; PROVISION=true; ENCRYPT=true ;;
    --oem-config) OEM_CONFIG="$2"; shift ;;
    --free-space) FREE_SPACE=true ;;
    --reuse-base) REUSE_BASE=true ;;
    --install-only) INSTALL_ONLY=true ;;
    --keep-running) KEEP_RUNNING=true ;;
    --no-preview) NO_PREVIEW=true ;;
    --sync-omarchy) SYNC_DIR="$2"; shift ;;
    --sync-all) SYNC_DIR="$2"; SYNC_ALL=true; shift ;;
    --port) SSH_PORT="$2"; shift ;;
    --memory) MEMORY="$2"; shift ;;
    --timeout) INSTALL_TIMEOUT="$2"; shift ;;
    --fake-pci) FAKE_PCI+=("$2"); shift ;;
    --smbios) SMBIOS+=("$2"); shift ;;
    --cpu-id) CPU_ID="$2"; shift ;;
    --battery) BATTERY=true ;;
    --acpi-hid) ACPI_HIDS+=("$2"); shift ;;
    --no-network) NO_NETWORK=true ;;
    -*) echo "Unknown option: $1" >&2; exit 1 ;;
    *) ISO="$1" ;;
  esac
  shift
done

if [[ -z $SYNC_DIR && -f ${OMARCHY_PATH:-}/test/acceptance ]]; then
  SYNC_DIR="$OMARCHY_PATH"
fi

if [[ -z $ISO && -t 0 ]]; then
  ISO=$(ls -t "$REPO_DIR"/release/*.iso 2>/dev/null | gum choose --header "Select ISO to test")
fi

if [[ ! -f ${ISO:-} ]]; then
  echo "No ISO to test. Pass one explicitly or put it in release/." >&2
  echo "Usage: omarchy-iso-test [release/omarchy.iso] [options]" >&2
  exit 1
fi

case "$KEYBOARD_LABEL" in
  "English (US)" | "English (UK)" | "Japanese" | "Japanese (US keyboard)" | "Korean" | "Chinese (Simplified, Pinyin)" | "Taiwan (Zhuyin)" | "Hong Kong (Cangjie)") ;;
  *) echo "The VM harness cannot type credentials with keyboard: $KEYBOARD_LABEL" >&2; exit 1 ;;
esac

if $OEM && $FREE_SPACE; then
  echo "--oem installs over the whole disk, so there is no free-space install to test with it" >&2
  exit 1
fi

if [[ -n $OEM_CONFIG ]]; then
  if ! $OEM; then
    echo "--oem-config describes an OEM ISO's bundle; add --oem" >&2
    exit 1
  fi
  if [[ ! -f $OEM_CONFIG ]]; then
    echo "No OEM config at $OEM_CONFIG" >&2
    exit 1
  fi
fi

omarchy-pkg-add qemu-full edk2-ovmf socat imagemagick tesseract tesseract-data-eng
# --battery and --acpi-hid compile their SSDT with iasl.
if $BATTERY || ((${#ACPI_HIDS[@]})); then
  omarchy-pkg-add acpica
fi

OVMF_CODE="/usr/share/edk2/x64/OVMF_CODE.4m.fd"
OVMF_VARS_TEMPLATE="/usr/share/edk2/x64/OVMF_VARS.4m.fd"

BASE_NAME="$(basename "$ISO" .iso)"
if [[ $KEYBOARD_LABEL != "English (US)" ]]; then
  BASE_NAME+="-$(printf '%s' "$KEYBOARD_LABEL" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g')"
fi
$ENCRYPT && BASE_NAME+="-encrypted"
$PROVISION && BASE_NAME+="-provision"
$FREE_SPACE && BASE_NAME+="-free-space"
$NO_NETWORK && BASE_NAME+="-no-network"
# The fake hardware changes what the install does (packages, kernel, boot
# configuration), so --reuse-base must not boot an image installed with other
# hardware, or none. A hash of the settings, since --smbios is free text.
if ((${#FAKE_PCI[@]} + ${#SMBIOS[@]} + ${#ACPI_HIDS[@]})) || [[ -n $CPU_ID ]] || $BATTERY; then
  BASE_NAME+="-hw-$(declare -p FAKE_PCI SMBIOS CPU_ID BATTERY ACPI_HIDS | sha256sum | cut -c1-12)"
fi
BASE_DIR="$REPO_DIR/test-runs/$BASE_NAME"
RUN_DIR="$BASE_DIR/runs/$(date +%Y%m%d-%H%M%S)"
BASE_DISK="$BASE_DIR/base.qcow2"
BASE_OVMF="$BASE_DIR/OVMF_VARS.4m.fd"
SSH_KEY="$BASE_DIR/id_ed25519"
HTTP_PORT=$((SSH_PORT + 1))
HTTP_PID=""

mkdir -p "$BASE_DIR" "$RUN_DIR"

# First-boot setup's greeter is known by its tagline. An OEM's config can
# replace that with words OCR may misread, so there the greeter is known by
# the hint under it, which is dim and needs a threshold of its own.
GREETER_TEXT="Linux by DHH"
GREETER_OCR_THRESHOLD=50
OEM_BUNDLE=""
OEM_EULA=false
if [[ -n $OEM_CONFIG ]]; then
  # Laid out the way the build lays it out, to hold the installed machine to.
  OEM_BUNDLE="$RUN_DIR/oem-bundle"
  python3 "$REPO_DIR/builder/oem-bundle.py" "$OEM_BUNDLE" "--config=$OEM_CONFIG"
  if grep -q '^  "tagline":' "$OEM_BUNDLE/oem.json"; then
    GREETER_TEXT="Start Setup"
    GREETER_OCR_THRESHOLD=80
  fi
  [[ ! -f $OEM_BUNDLE/eula.txt ]] || OEM_EULA=true
fi

# Unix socket paths are capped at ~108 bytes, which a run directory nested in
# test-runs/<iso-name>/runs/<timestamp> can exceed. Keep the socket in /tmp.
QMP_SOCK=$(mktemp -u "${TMPDIR:-/tmp}/omarchy-iso-test-qmp.XXXXXX.sock")
PIDFILE="$RUN_DIR/qemu.pid"

log() {
  printf '\033[1;35m==> %s\033[0m\n' "$1"
}

# ---------------------------------------------------------------- vm control

vm_running() {
  [[ -f $PIDFILE ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

qmp() {
  printf '{"execute":"qmp_capabilities"}\n{"execute":%s}\n' "$1" |
    timeout 5 socat -t 2 - "UNIX-CONNECT:$QMP_SOCK" 2>/dev/null || true
}

screendump() {
  qmp "\"screendump\", \"arguments\": {\"filename\": \"$1\"}" >/dev/null
}

capture_console() {
  local name="$1" shot="$RUN_DIR/.capture.ppm"

  sleep 1
  screendump "$shot"
  [[ -s $shot ]] || return 0
  magick "$shot" "$RUN_DIR/$name.png" 2>/dev/null || true
  rm -f "$shot"
}

stop_vm() {
  vm_running || return 0

  if ! ssh_guest "echo $GUEST_PASSWORD | sudo -S systemctl poweroff" >/dev/null 2>&1; then
    qmp '"system_powerdown"' >/dev/null
  fi

  local waited=0
  while vm_running && ((waited < 15)); do
    sleep 1
    ((waited += 1))
  done

  if vm_running; then
    qmp '"quit"' >/dev/null
    sleep 1
  fi

  if vm_running; then
    kill "$(cat "$PIDFILE")" 2>/dev/null || true
    sleep 1
  fi
}

open_screenshots() {
  local entry
  local -a screenshots=()

  while IFS= read -r -d '' entry; do
    screenshots+=("${entry#* }")
  done < <(
    find "$RUN_DIR" -type f \( -name "success-*.png" -o -name "failure-*.png" \) -printf '%T@ %p\0' |
      sort -zn
  )

  (( ${#screenshots[@]} > 0 )) || return 0

  log "Visual review: ${#screenshots[@]} screenshots in $RUN_DIR"
  $NO_PREVIEW && return 0

  if command -v imv >/dev/null && [[ -n ${WAYLAND_DISPLAY:-}${DISPLAY:-} ]]; then
    setsid -f imv "${screenshots[@]}" >/dev/null 2>&1
  fi
}

cleanup() {
  local status=$?

  [[ -n $HTTP_PID ]] && kill "$HTTP_PID" 2>/dev/null || true

  # The fake PCI devices are the VM's: they go when it does, after it.
  if ! $KEEP_RUNNING; then
    vm_running && log "Stopping test VM"
    stop_vm
    for pid in "${FAKE_PCI_PIDS[@]}"; do kill "$pid" 2>/dev/null || true; done
  fi

  rm -f "$RUN_DIR/.screen.ppm" "$RUN_DIR/.screen.png"
  open_screenshots

  return $status
}
trap cleanup EXIT

start_vm() {
  local disk="$1" serial="$2"
  shift 2

  # A viewer that resizes the guest display breaks the console driving: OCR
  # cannot read the shrunken font, and a resize during early boot can wedge
  # virtio-gpu before the system comes up.
  log "Watch (do not resize): vncviewer -RemoteResize=0 127.0.0.1:5905"

  # vfio-user maps guest memory into the device process, so it has to be a
  # shareable memfd; only when a fake device is asked for.
  local fake_args=() spec sock vendor device class index=0
  for pid in "${FAKE_PCI_PIDS[@]}"; do kill "$pid" 2>/dev/null || true; done
  FAKE_PCI_PIDS=()
  for spec in "${FAKE_PCI[@]}"; do
    IFS=: read -r vendor device class <<<"$spec"
    sock="${QMP_SOCK%.sock}.fakepci$index.sock"
    rm -f "$sock"
    "${VFIO_USER_SERVER:-gpio-pci-idio-16}" "$sock" 2>>"$RUN_DIR/fakepci.log" &
    FAKE_PCI_PIDS+=($!)
    for _ in $(seq 1 50); do [[ -S $sock ]] && break; sleep 0.1; done
    [[ -S $sock ]] || { echo "the vfio-user server did not come up for $spec (see test/fake-pci.md)" >&2; return 1; }
    fake_args+=(-device "{\"driver\":\"vfio-user-pci\",\"socket\":{\"path\":\"$sock\",\"type\":\"unix\"},\"x-pci-vendor-id\":$((16#$vendor)),\"x-pci-device-id\":$((16#$device)),\"x-pci-class-code\":$((16#$class))}")
    index=$((index + 1))
  done
  for spec in "${SMBIOS[@]}"; do
    fake_args+=(-smbios "type=1,$spec")
  done
  if $BATTERY || ((${#ACPI_HIDS[@]})); then
    local dsl="$RUN_DIR/fake-acpi.dsl" i=0
    {
      echo 'DefinitionBlock ("", "SSDT", 2, "OMARCH", "FAKEHW", 1) { Scope (\_SB) {'
      if $BATTERY; then cat <<'DSL'
  Device (BAT0) { Name (_HID, EisaId ("PNP0C0A")) Name (_UID, One)
    Method (_STA, 0) { Return (0x1F) }
    Method (_BIF, 0) { Return (Package () { 1, 60000, 60000, 1, 12000, 3000, 300, 100, 100, "FAKE-BAT", "0001", "LION", "Omarchy" }) }
    Method (_BST, 0) { Return (Package () { 0, 10000, 48000, 12000 }) }
    Method (_PCL, 0) { Return (Package () { \_SB }) } }
  Device (LID0) { Name (_HID, EisaId ("PNP0C0D")) Method (_LID, 0) { Return (One) } Method (_STA, 0) { Return (0x0F) } }
DSL
      fi
      for hid in "${ACPI_HIDS[@]}"; do
        printf '  Device (FHD%d) { Name (_HID, "%s") Name (_UID, Zero) Method (_STA, 0) { Return (0x0F) } }\n' "$i" "$hid"; i=$((i + 1))
      done
      echo "} }"
    } >"$dsl"
    if ! iasl -p "${dsl%.dsl}" "$dsl" >"$RUN_DIR/fake-acpi.log" 2>&1; then
      cat "$RUN_DIR/fake-acpi.log" >&2
      echo "iasl could not compile $dsl" >&2
      return 1
    fi
    fake_args+=(-acpitable "file=${dsl%.dsl}.aml")
    log "Fake ACPI: battery=$BATTERY hids=${ACPI_HIDS[*]:-none}"
  fi
  [[ -n $CPU_ID ]] && log "Fake CPU identity: $CPU_ID"
  ((${#SMBIOS[@]})) && log "Fake DMI identity: ${SMBIOS[*]}"
  if ((${#FAKE_PCI[@]})); then
    fake_args+=(-object "memory-backend-memfd,id=fakepcimem,size=${MEMORY}M,share=on" -numa node,memdev=fakepcimem)
    log "Fake PCI hardware: ${FAKE_PCI[*]}"
  fi

  local net_args=(-netdev "user,id=net0,hostfwd=tcp:127.0.0.1:$SSH_PORT-:22" -device virtio-net-pci,netdev=net0)
  $NO_NETWORK && net_args=(-nic none)

  qemu-system-x86_64 \
    -cpu "host${CPU_ID:+,$CPU_ID}" -enable-kvm -machine q35,accel=kvm \
    -smp "$(nproc)" \
    -m "$MEMORY" \
    "${fake_args[@]}" \
    -drive if=pflash,format=raw,readonly=on,file="$OVMF_CODE" \
    -drive if=pflash,format=raw,file="$BASE_OVMF" \
    -drive file="$disk",format=qcow2,if=none,id=drive0 \
    -device virtio-blk-pci,drive=drive0,bootindex=1 \
    -device virtio-vga \
    -display none \
    -vnc 127.0.0.1:5 \
    -usb -device usb-tablet \
    "${net_args[@]}" \
    -qmp "unix:$QMP_SOCK,server,nowait" \
    -serial "file:$serial" \
    -pidfile "$PIDFILE" \
    -daemonize \
    "$@"
}

# ------------------------------------------------------------ console driver
#
# The heart of the harness: read the VM's console with screendump + OCR, and
# type into it with QMP send-key. Together they make an expect-style loop
# that walks the same screens a user sees.

ocr_screen() {
  local shot="$RUN_DIR/.screen.ppm" prepped="$RUN_DIR/.screen.png"

  screendump "$shot"
  [[ -s $shot ]] || return 0
  # Black on white: the negated grays alone read the focused button on the
  # finished install, dark text on a light bar, as "Reboot Nou".
  magick "$shot" -colorspace gray -negate -resize 150% -threshold "${OCR_THRESHOLD:-50}%" "$prepped" 2>/dev/null || return 0
  tesseract "$prepped" - --psm 6 2>/dev/null || true
}

# Wait until the console shows the given text. Saves the offending screen as
# an artifact on timeout.
wait_for_screen() {
  local text="$1" timeout="$2" waited=0 slug

  until ocr_screen | grep -qi "$text"; do
    if ! vm_running; then
      echo "VM exited while waiting for screen: $text" >&2
      return 1
    fi

    if ((waited >= timeout)); then
      slug=${text,,}
      slug=${slug// /-}
      slug=${slug//[^a-z0-9-]/}
      capture_console "failure-installer-waiting-for-$slug"
      echo "Timed out after ${timeout}s waiting for screen: $text" >&2
      return 1
    fi

    sleep 3
    ((waited += 3))
  done

  sleep 1 # let the screen settle before typing
}

# Wait until the console shows either text, and set SCREEN_MATCHED to the one
# it found.
wait_for_screen_any() {
  local first="$1" second="$2" timeout="$3" waited=0 screen slug

  while true; do
    screen=$(ocr_screen)
    if grep -qi "$first" <<<"$screen"; then
      SCREEN_MATCHED="$first"
      sleep 1
      return 0
    fi
    if grep -qi "$second" <<<"$screen"; then
      SCREEN_MATCHED="$second"
      sleep 1
      return 0
    fi

    if ! vm_running; then
      echo "VM exited while waiting for screen: $first or $second" >&2
      return 1
    fi

    if ((waited >= timeout)); then
      slug=${first,,}
      slug=${slug// /-}
      slug=${slug//[^a-z0-9-]/}
      capture_console "failure-installer-waiting-for-$slug"
      echo "Timed out after ${timeout}s waiting for screen: $first or $second" >&2
      return 1
    fi

    sleep 3
    ((waited += 3))
  done
}

# Press a key or chord, dash-separated: "ret", "ctrl-c", "ctrl-alt-f3".
press() {
  local part json=""
  local -a parts

  IFS='-' read -ra parts <<<"$1"
  for part in "${parts[@]}"; do
    json+="{\"type\":\"qcode\",\"data\":\"$part\"},"
  done

  qmp "\"send-key\", \"arguments\": {\"keys\": [${json%,}]}" >/dev/null
}

type_text() {
  local text="$1" ch i

  for ((i = 0; i < ${#text}; i++)); do
    ch=${text:i:1}
    case "$ch" in
      [a-z0-9]) press "$ch" ;;
      [A-Z]) press "shift-${ch,,}" ;;
      " ") press spc ;;
      .) press dot ;;
      ,) press comma ;;
      -) press minus ;;
      _) press shift-minus ;;
      /) press slash ;;
      :) press shift-semicolon ;;
      @) press shift-2 ;;
      \|) press shift-backslash ;;
      ";") press semicolon ;;
      "'") press apostrophe ;;
      '"') press shift-apostrophe ;;
      "=") press equal ;;
      "+") press shift-equal ;;
      "%") press shift-5 ;;
      "&") press shift-7 ;;
      "*") press shift-8 ;;
      "(") press shift-9 ;;
      ")") press shift-0 ;;
      "<") press shift-comma ;;
      ">") press shift-dot ;;
      "!") press shift-1 ;;
      "#") press shift-3 ;;
      '$') press shift-4 ;;
      "?") press shift-slash ;;
      "~") press shift-grave_accent ;;
      "\\") press backslash ;;
      "[") press bracket_left ;;
      "]") press bracket_right ;;
      "{") press shift-bracket_left ;;
      "}") press shift-bracket_right ;;
      *) echo "type_text: unsupported character: $ch" >&2; return 1 ;;
    esac
    sleep 0.05
  done
}

# --------------------------------------------------------------------- guest

ssh_guest() {
  ssh -i "$SSH_KEY" -p "$SSH_PORT" \
    -o BatchMode=yes \
    -o IdentitiesOnly=yes \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o ConnectTimeout=5 \
    -o LogLevel=ERROR \
    "$GUEST_USER@127.0.0.1" "$@"
}

wait_for_ssh() {
  local timeout="$1" failure_name="${2:-failure-session-ssh-timeout}" waited=0

  while ! ssh_guest true 2>/dev/null; do
    if ! vm_running; then
      echo "VM exited while waiting for SSH" >&2
      return 1
    fi

    if ((waited >= timeout)); then
      capture_console "$failure_name"
      echo "Timed out after ${timeout}s waiting for SSH" >&2
      return 1
    fi

    sleep 5
    ((waited += 5))
  done
}

session_started() {
  ssh_guest "ls /run/user/1000/hypr 2>/dev/null | grep -q ." 2>/dev/null
}

ssh_session() {
  local command="$1"

  ssh_guest "export XDG_RUNTIME_DIR=/run/user/\$(id -u); \
    export DBUS_SESSION_BUS_ADDRESS=unix:path=\$XDG_RUNTIME_DIR/bus; \
    export LANG=\$(systemctl --user show-environment | sed -n 's/^LANG=//p' | head -1); \
    export LANG=\${LANG:-C.UTF-8}; \
    export HYPRLAND_INSTANCE_SIGNATURE=\$(ls -t \$XDG_RUNTIME_DIR/hypr | head -1); \
    export WAYLAND_DISPLAY=\$(find \$XDG_RUNTIME_DIR -maxdepth 1 -name 'wayland-*' ! -name '*.lock' -printf '%f\\n' | head -1); \
    export OMARCHY_PATH=/usr/share/omarchy; \
    export PATH=\$OMARCHY_PATH/bin:\$PATH; \
    $command" </dev/null
}

wait_for_guest_state() {
  local description="$1" timeout="$2"
  shift 2
  local deadline=$((SECONDS + timeout))

  until "$@" >/dev/null 2>&1; do
    if ((SECONDS >= deadline)); then
      printf 'not ok - %s\n' "$description" >&2
      return 1
    fi
    sleep 1
  done

  printf 'ok - %s\n' "$description"
}

guest_layer_present() {
  local namespace="$1"

  ssh_session "hyprctl -j layers | jq -e --arg namespace '$namespace' \
    '[.. | objects | select(.namespace? == \$namespace)] | length > 0'"
}

guest_layer_absent() {
  ! guest_layer_present "$1"
}

# Close every shortcut surface, so one left open by a failed check cannot hold
# the keyboard for the checks after it. The dock's app picker has no hide
# command; its apps command toggles it.
close_shortcut_surfaces() {
  ssh_session 'for plugin in omarchy.menu omarchy.emojis omarchy.clipboard omarchy.audio; do
    omarchy-shell shell hide "$plugin" >/dev/null 2>&1 || true
  done
  if hyprctl -j layers | jq -e '\''[.. | objects | select(.namespace? == "omarchy-dock-apps")] | length > 0'\'' >/dev/null; then
    omarchy-shell omarchy.dock apps >/dev/null 2>&1 || true
  fi' >/dev/null 2>&1 || true
}

cleanup_shortcut_state() {
  close_shortcut_surfaces
  ssh_session 'while read -r address; do
    hyprctl dispatch "hl.dsp.window.close({ window = \"address:$address\" })" >/dev/null 2>&1 ||
      hyprctl dispatch closewindow "address:$address" >/dev/null 2>&1 || true
  done < <(hyprctl -j clients | jq -r '\''.[] | select(.class == "foot") | .address'\'')
  hyprctl dispatch workspace 1 >/dev/null 2>&1 || true' >/dev/null 2>&1 || true
}

verify_surface_shortcut() {
  local name="$1" chord="$2" namespace="$3"

  press "$chord"
  if ! wait_for_guest_state "$name shortcut opens" 15 guest_layer_present "$namespace"; then
    capture_console "failure-shortcut-$name-open"
    close_shortcut_surfaces
    return 1
  fi
  capture_console "success-shortcut-$name"

  press esc
  if ! wait_for_guest_state "$name shortcut surface closes" 15 guest_layer_absent "$namespace"; then
    capture_console "failure-shortcut-$name-close"
    close_shortcut_surfaces
    return 1
  fi
}

verify_desktop_shortcuts() {
  cleanup_shortcut_state

  press meta_l-ret
  if ! wait_for_guest_state "terminal shortcut opens a window" 30 \
    ssh_session "hyprctl -j clients | jq -e '[.[] | select(.class == \"foot\")] | length == 1'"; then
    capture_console "failure-shortcut-terminal-open"
    return 1
  fi

  press meta_l-ret
  if ! wait_for_guest_state "terminal shortcut opens a second window" 30 \
    ssh_session "hyprctl -j clients | jq -e '[.[] | select(.class == \"foot\")] | length == 2'"; then
    capture_console "failure-shortcut-terminal-second-window"
    return 1
  fi
  capture_console "success-shortcut-desktop-01-two-tiled-terminals"

  press meta_l-t
  if ! wait_for_guest_state "floating shortcut floats the active window" 15 \
    ssh_session "hyprctl -j activewindow | jq -e '.class == \"foot\" and .floating == true'"; then
    capture_console "failure-shortcut-window-float"
    return 1
  fi
  capture_console "success-shortcut-desktop-02-floating-terminal"

  press meta_l-t
  if ! wait_for_guest_state "floating shortcut returns the window to tiling" 15 \
    ssh_session "hyprctl -j activewindow | jq -e '.class == \"foot\" and .floating == false'"; then
    capture_console "failure-shortcut-window-retile"
    return 1
  fi

  press meta_l-shift-2
  if ! wait_for_guest_state "move shortcut follows the window to workspace 2" 15 \
    ssh_session "hyprctl -j activeworkspace | jq -e '.id == 2' && \
      hyprctl -j activewindow | jq -e '.class == \"foot\" and .workspace.id == 2'"; then
    capture_console "failure-shortcut-window-workspace-2"
    return 1
  fi
  capture_console "success-shortcut-desktop-03-terminal-on-workspace-2"

  press meta_l-1
  if ! wait_for_guest_state "workspace shortcut returns to workspace 1" 15 \
    ssh_session "hyprctl -j activeworkspace | jq -e '.id == 1'"; then
    capture_console "failure-shortcut-workspace-1"
    return 1
  fi
  capture_console "success-shortcut-desktop-04-workspace-1"

  press meta_l-w
  if ! wait_for_guest_state "close shortcut closes the workspace 1 terminal" 15 \
    ssh_session "hyprctl -j clients | jq -e '[.[] | select(.class == \"foot\")] | length == 1'"; then
    capture_console "failure-shortcut-close-workspace-1"
    return 1
  fi

  press meta_l-2
  if ! wait_for_guest_state "workspace shortcut visits workspace 2" 15 \
    ssh_session "hyprctl -j activeworkspace | jq -e '.id == 2'"; then
    capture_console "failure-shortcut-visit-workspace-2"
    return 1
  fi
  press meta_l-w
  if ! wait_for_guest_state "close shortcut closes the workspace 2 terminal" 15 \
    ssh_session "hyprctl -j clients | jq -e '[.[] | select(.class == \"foot\")] | length == 0'"; then
    capture_console "failure-shortcut-close-workspace-2"
    return 1
  fi
}

verify_universal_clipboard_shortcuts() {
  local copy_token="OmarchyUniversalCopy$(date +%s)"
  local paste_token="OmarchyUniversalPaste$(date +%s)"
  local terminal_token="OmarchyTerminalPaste$(date +%s)"
  local terminal_result="/tmp/omarchy-universal-terminal-paste"

  cleanup_shortcut_state
  ssh_session "setsid -f google-chrome-stable --new-window about:blank >/dev/null 2>&1"
  if ! wait_for_guest_state "universal clipboard test opens Chrome" 45 \
    ssh_session "hyprctl -j clients | jq -e '[.[] | select(.class | test(\"(?i)google-chrome\"))] | length == 1'"; then
    capture_console "failure-shortcut-universal-clipboard-browser"
    return 1
  fi

  press ctrl-l
  type_text "$copy_token"
  press ctrl-a
  press meta_l-c
  if ! wait_for_guest_state "universal copy uses the active GUI application" 15 \
    ssh_session "[[ \$(wl-paste --no-newline) == '$copy_token' ]]"; then
    capture_console "failure-shortcut-universal-copy"
    return 1
  fi

  ssh_session "setsid -f bash -c 'printf \"%s\" \"$paste_token\" | wl-copy' >/dev/null 2>&1"
  if ! wait_for_guest_state "universal paste clipboard is seeded" 15 \
    ssh_session "[[ \$(wl-paste --no-newline) == '$paste_token' ]]"; then
    capture_console "failure-shortcut-universal-paste-seed"
    return 1
  fi
  press ctrl-l
  press meta_l-v
  sleep 1
  press ctrl-a
  press ctrl-c
  if ! wait_for_guest_state "universal paste uses the active GUI application" 15 \
    ssh_session "[[ \$(wl-paste --no-newline) == '$paste_token' ]]"; then
    capture_console "failure-shortcut-universal-paste-gui"
    return 1
  fi
  capture_console "success-shortcut-universal-copy-paste-gui"
  ssh_session 'while read -r address; do
    hyprctl dispatch "hl.dsp.window.close({ window = \"address:$address\" })" >/dev/null 2>&1 ||
      hyprctl dispatch closewindow "address:$address" >/dev/null 2>&1 || true
  done < <(hyprctl -j clients | jq -r '\''.[] | select(.class | test("(?i)google-chrome")) | .address'\'')' || true

  ssh_session "rm -f '$terminal_result'; \
    setsid -f bash -c 'printf \"%s\" \"$terminal_token\" | wl-copy' >/dev/null 2>&1; \
    setsid -f foot --app-id=foot -e bash -c 'read -r value; printf \"%s\" \"\$value\" > \"$terminal_result\"; sleep 30' >/dev/null 2>&1"
  if ! wait_for_guest_state "terminal paste clipboard is seeded" 15 \
    ssh_session "[[ \$(wl-paste --no-newline) == '$terminal_token' ]]"; then
    capture_console "failure-shortcut-universal-paste-terminal-seed"
    return 1
  fi
  if ! wait_for_guest_state "universal clipboard test opens a terminal" 30 \
    ssh_session "hyprctl -j clients | jq -e '[.[] | select(.class == \"foot\")] | length == 1'"; then
    capture_console "failure-shortcut-universal-clipboard-terminal"
    return 1
  fi

  press meta_l-v
  sleep 1
  press ret
  if ! wait_for_guest_state "universal paste uses the terminal-safe shortcut" 15 \
    ssh_session "[[ \$(cat '$terminal_result' 2>/dev/null) == '$terminal_token' ]]"; then
    capture_console "failure-shortcut-universal-paste-terminal"
    return 1
  fi
  capture_console "success-shortcut-universal-paste-terminal"
  cleanup_shortcut_state
}

shortcut_smoke_phase() {
  log "Exercising primary desktop shortcuts through the VM keyboard"

  local status=0
  local name chord namespace apps_namespace=omarchy-menu
  # Super+Alt+Space opens the dock's app picker since omacom/omarchy#15263
  # and the menu before it. Expect whichever the installed Omarchy binds.
  if ssh_session "grep -q 'omarchy.dock apps' /usr/share/omarchy/default/hypr/bindings/utilities.lua"; then
    apps_namespace=omarchy-dock-apps
  fi
  local shortcuts="menu|meta_l-spc|omarchy-menu
apps|meta_l-alt-spc|$apps_namespace
emojis|meta_l-ctrl-e|omarchy-emojis
clipboard|meta_l-ctrl-v|omarchy-clipboard
audio-panel|meta_l-ctrl-a|omarchy-keyboard-panel"

  cleanup_shortcut_state
  while IFS='|' read -r name chord namespace; do
    if ! verify_surface_shortcut "$name" "$chord" "$namespace"; then
      status=1
    fi
  done <<<"$shortcuts"

  if ! verify_desktop_shortcuts; then
    status=1
  fi
  if ! verify_universal_clipboard_shortcuts; then
    status=1
  fi
  cleanup_shortcut_state

  return $status
}

# ----------------------------------------------------- driving the installer

select_keyboard() {
  local label="$1" index direction="down"
  # gum choose uses arrows, not a searchable text field. Read the same ordered
  # choices the ISO vendors from the runtime rather than hard-code row numbers.
  index=$(OMARCHY_TEST_KEYBOARD="$label" python - <<'PYTHON'
import os, re
from pathlib import Path
source = Path(os.environ.get("OMARCHY_PATH", "")) / "install/provisioning/setup-form.sh"
if not source.is_file():
    raise SystemExit("Set OMARCHY_PATH to the source tree used to build this ISO")
text = source.read_text()
rows = re.search(r"OMARCHY_KEYBOARD_LAYOUTS=\$'(.*?)'\n", text, re.S).group(1).splitlines()
labels = [row.split("|")[0] for row in rows]
label = os.environ["OMARCHY_TEST_KEYBOARD"]
if label not in labels:
    raise SystemExit(f"Keyboard choice is absent from the ISO source: {label}")
print(labels.index(label) - labels.index("English (US)"))
PYTHON
  ) || return 1
  if (( index < 0 )); then
    direction="up"
    index=$((-index))
  fi
  for (( i = 0; i < index; i++ )); do
    press "$direction"
    sleep 0.1
  done
}

drive_configurator() {
  if $OEM; then
    # Nothing to drive: an OEM ISO picks the machine's one internal disk and
    # installs without a question. A keystroke here would be a test bug.
    log "OEM install: sending no keys"
    return 0
  fi

  log "Driving the installer wizard"

  # A greeter (animated logo + tagline) opens the installer; Return begins.
  wait_for_screen "Linux by DHH" 300
  capture_console "success-installer-00-greeter"
  press ret

  # The language picker is first only when the live system's omarchy package
  # carries default/i18n/locales.json (quattro and edge). A stable ISO has no
  # such file, so the configurator opens on the keyboard layout instead.
  # Ctrl+C on the language picker is the only entry into deferred
  # provisioning, so --provision needs it.
  wait_for_screen_any "Language" "keyboard layout" 300
  have_language=false
  if [[ $SCREEN_MATCHED == "Language" ]]; then
    have_language=true
    capture_console "success-installer-00-language"
  elif $PROVISION; then
    echo "This ISO has no language screen, so it cannot arm deferred provisioning" >&2
    return 1
  fi

  if $PROVISION; then
    press ctrl-c # arm "prepare for another owner"
    wait_for_screen "another owner" 30
    capture_console "success-installer-02-prepare-confirm"
    press ret # "Yes, prepare for another owner" is the affirmative default

    # Jumps straight to disk selection, then the overwrite confirm.
    wait_for_screen "install disk" 60
    capture_console "success-installer-03-prepare-install-disk"
    press ret

    wait_for_screen "recovery possible" 60
    capture_console "success-installer-04-prepare-disk-warning-encrypted"
    if ! $ENCRYPT; then
      press ctrl-c
      # The toggled confirm ("Yes, install without encryption") is a highlighted
      # button OCR cannot read, so don't wait for it. A failed toggle still
      # surfaces: the encrypted install stalls at the LUKS prompt on first boot
      # and SSH never comes up.
      sleep 2
      capture_console "success-installer-05-prepare-disk-warning-unencrypted"
    fi
    press ret
    sleep 2
    capture_console "success-installer-13-install-started"
    return 0
  fi

  if $have_language; then
    press ret
  fi
  wait_for_screen "keyboard layout" 60
  capture_console "success-installer-01-keyboard-layout"

  if [[ $KEYBOARD_LABEL != "English (US)" ]]; then
    select_keyboard "$KEYBOARD_LABEL"
    capture_console "success-installer-01-selected-keyboard"
  fi
  press ret

  # Normal flow: timezone and user step come before disk selection.
  wait_for_screen "Timezone" 180 # the geo guess can take a moment
  capture_console "success-installer-02-timezone"
  press ret

  wait_for_screen "Username" 60
  type_text "$GUEST_USER"
  capture_console "success-installer-03-username"
  press ret

  # The live ISO's console font draws "w" as a "u" with a 1-px stem, and OCR
  # reads this label as "Passuord" while gum's blinking cursor is off. Polls
  # come about three blink cycles apart, so they can all land in that phase
  # until the timeout. "user + root" in the placeholder reads in both phases.
  wait_for_screen_any "Password" "user + root" 60
  type_text "$GUEST_PASSWORD"
  capture_console "success-installer-04-password"
  press ret

  # The same cursor, the other phase: while it covers the placeholder's first
  # letter, OCR misreads "Must match"; "you just typed" reads either way.
  wait_for_screen_any "Must match" "you just typed" 60
  type_text "$GUEST_PASSWORD"
  capture_console "success-installer-05-password-confirmation"
  press ret

  wait_for_screen "Hostname" 60
  type_text "$GUEST_HOSTNAME"
  capture_console "success-installer-07-hostname"
  press ret

  wait_for_screen "look right" 60
  capture_console "success-installer-09-review"
  press ret

  wait_for_screen "install disk" 60
  capture_console "success-installer-10-install-disk"
  press ret # the single virtio disk

  if $FREE_SPACE; then
    # The picker only appears when the disk has usable free space on UEFI.
    wait_for_screen "installation mode" 60
    capture_console "success-installer-11-install-mode"
    # Esc goes back to the disk list rather than ending the install.
    press esc
    wait_for_screen "install disk" 60
    press ret
    wait_for_screen "installation mode" 60
    # "Full disk install" comes first; free space is the next entry.
    press home
    press down
    press ret
    # BitLocker/ESP checks and the free-space analysis run, then the confirm.
    wait_for_screen "of free space" 120
    capture_console "success-installer-12-free-space-confirm-encrypted"
    if ! $ENCRYPT; then
      press ctrl-c # toggles the confirm to the unencrypted flow
      # Same highlighted button OCR cannot read as the full-disk confirm below.
      sleep 2
      capture_console "success-installer-13-free-space-confirm-unencrypted"
    fi
    press ret
    sleep 2
    capture_console "success-installer-14-install-started"
    return 0
  fi
  wait_for_screen "installation mode\|recovery possible" 60
  if ocr_screen | grep -qi "installation mode"; then
    capture_console "success-installer-11-install-mode"
    press ret # a blank disk: "Full disk install" comes first
  fi

  wait_for_screen "recovery possible" 60
  capture_console "success-installer-12-disk-warning-encrypted"
  if ! $ENCRYPT; then
    press ctrl-c # toggles the confirm to the unencrypted flow
    # The toggled confirm ("Yes, install without encryption") is a highlighted
    # button OCR cannot read, so don't wait for it. A failed toggle still
    # surfaces: the encrypted install stalls at the LUKS prompt on first boot
    # and SSH never comes up.
    sleep 2
    capture_console "success-installer-13-disk-warning-unencrypted"
  fi
  press ret

  sleep 2
  capture_console "success-installer-14-install-started"
}

# The OEM's agreement is first-boot setup's last question. The driver reads
# on, then takes each way out but the last before accepting: Ctrl+C offers a
# reboot, declining offers to shut down, and neither may cost the owner more
# than a keypress to come back from.
drive_oem_agreement() {
  wait_for_screen "accept this agreement" 60
  capture_console "success-provision-08-agreement-1-shown"
  press pgdn
  capture_console "success-provision-08-agreement-2-read-on"

  press ctrl-c
  wait_for_screen "Reboot this machine" 30
  capture_console "success-provision-08-agreement-3-ctrl-c"
  press right
  press ret
  wait_for_screen "accept this agreement" 30

  press tab
  capture_console "success-provision-08-agreement-4-decline-in-focus"
  press ret
  # The answer in focus, which has no "w" for OCR to read as "u".
  wait_for_screen "back to the agreement" 30
  capture_console "success-provision-08-agreement-5-declined"
  # Going back to the agreement is the answer in focus.
  press ret
  wait_for_screen "accept this agreement" 30

  press end
  capture_console "success-provision-08-agreement-6-read-to-the-end"
  press ret
}

# What an ISO built with --oem-config leaves on the installed machine: the
# bundle as the config lays it out, where first-boot setup reads it, and a
# record that this owner accepted this OEM's agreement, by the hash of its text.
verify_oem_setup() {
  local report="$RUN_DIR/oem-setup.txt" file expected record
  local name='import json, sys; print(json.load(open(sys.argv[1], encoding="utf-8"))["name"])'
  local accepted='import json, sys; record = json.load(sys.stdin); print(record["oem"], record["sha256"], record["accepted_by"], sep="|")'

  ssh_guest "tail -n +1 /etc/omarchy/oem/* /var/lib/omarchy/oem/eula-accepted.json; ls -la /etc/omarchy/oem" >"$report" 2>&1 || true

  for file in oem.json logo.txt eula.txt; do
    [[ -f $OEM_BUNDLE/$file ]] || continue
    if [[ $(ssh_guest "cat /etc/omarchy/oem/$file" 2>/dev/null | sha256sum) != "$(sha256sum <"$OEM_BUNDLE/$file")" ]]; then
      echo "The installed system's /etc/omarchy/oem/$file is not what the config lays out; see $report" >&2
      return 1
    fi
  done
  log "OEM bundle laid down for first-boot setup"

  if $OEM_EULA; then
    expected="$(python3 -c "$name" "$OEM_BUNDLE/oem.json")|$(sha256sum <"$OEM_BUNDLE/eula.txt" | cut -d' ' -f1)|$GUEST_USER"
    record=$(ssh_guest "cat /var/lib/omarchy/oem/eula-accepted.json" 2>/dev/null | python3 -c "$accepted" 2>/dev/null) || record=""
    if [[ $record != "$expected" ]]; then
      echo "The record of the accepted agreement is '${record:-missing}', not '$expected'; see $report" >&2
      return 1
    fi
    log "OEM agreement recorded as accepted by $GUEST_USER"
  fi
}

# The deferred-provisioning first boot runs the user form on tty1 (omarchy-provision-owner) before
# SDDM. Encrypted deferred-provisioning installs auto-unlock from the staged keyfile, so there
# is no LUKS prompt to answer here either way.
drive_provision_owner() {
  log "Driving the deferred-provisioning first-boot setup"

  # A greeter (animated logo + tagline) opens first boot; Return begins.
  OCR_THRESHOLD=$GREETER_OCR_THRESHOLD wait_for_screen "$GREETER_TEXT" 600
  capture_console "success-provision-00-greeter"
  press ret

  # A runtime that lets the owner pick a language asks that first, as the
  # installer does; an older one opens on the keyboard layout.
  wait_for_screen_any "Language" "keyboard layout" 120
  if [[ $SCREEN_MATCHED == "Language" ]]; then
    capture_console "success-provision-00-language"
    press ret
    wait_for_screen "keyboard layout" 60
  fi

  # Deferred provisioning defers the keyboard step to first boot.
  # Pick English (UK) (one row below the preselected English (US), which leads
  # the list) so the verifier can prove the deferred step applied a non-default
  # layout — UK leaves every letter identical to US, so the typed password (sent
  # as raw keycodes) still matches the literal one the harness pipes to sudo.
  if [[ $KEYBOARD_LABEL == "English (US)" ]]; then
    press down # preserve the harness's default UK provisioning coverage
  else
    select_keyboard "$KEYBOARD_LABEL"
  fi
  capture_console "success-provision-01-keyboard-layout"
  press ret

  # The account questions, in whatever order this runtime asks them: each is
  # told apart by its prompt, the only one on screen while it waits (the
  # placeholders are too dim for OCR). The review table ends the form.
  local screen prompt answered="" waited=0
  while true; do
    screen=$(ocr_screen)
    prompt=""
    if grep -qi "look right" <<<"$screen"; then
      break
    elif grep -qi "Conf *irm" <<<"$screen"; then
      prompt=confirmation
    elif grep -qi "Password" <<<"$screen"; then
      prompt=password
    elif grep -qi "Username" <<<"$screen"; then
      prompt=username
    elif grep -qi "Hostname" <<<"$screen"; then
      prompt=hostname
    elif grep -q "[A-Z][a-z]\+/[A-Z][a-z]" <<<"$screen"; then
      # The picker's list of zones, not a heading that names the step while
      # the guess is still being fetched: a Return sent then is lost.
      prompt=timezone
    fi

    # The screen still showing a prompt just answered is the console catching
    # up, not the question asked twice.
    if [[ -n $prompt && " $answered " != *" $prompt "* ]]; then
      case $prompt in
        username) type_text "$GUEST_USER" ;;
        password | confirmation) type_text "$GUEST_PASSWORD" ;;
        hostname) type_text "$GUEST_HOSTNAME" ;;
        timezone) ;; # accept the guess that leads the list
      esac
      capture_console "success-provision-02-$prompt"
      press ret
      answered+=" $prompt"
      waited=0
    fi

    if ! vm_running; then
      echo "VM exited during first-boot setup" >&2
      return 1
    fi
    # Generous: the timezone guess over first-boot networking can lag.
    if ((waited >= 180)); then
      capture_console "failure-provision-form-stalled"
      echo "First-boot setup stopped answering after:${answered:- nothing}" >&2
      return 1
    fi
    sleep 2
    ((waited += 2))
  done

  capture_console "success-provision-07-review"
  press ret

  if $OEM_EULA; then
    drive_oem_agreement
  fi

  # Finalization (user setup, LUKS re-key on encrypted installs) runs under the
  # progress screen until the display manager takes the console. Its percentage
  # is the one line bright enough for OCR, which reads the sign as anything.
  # OCR reads nothing from a screen caught mid-redraw or gone black for the
  # handoff, which says nothing either way: it takes two readable screens in a
  # row without the percentage to call the progress screen gone.
  local shots=0 gone=0 progress
  waited=0
  sleep 2
  while ((gone < 2)); do
    if ((waited >= 900)); then
      capture_console "failure-provision-finalizing-timeout"
      echo "Timed out waiting for first-boot setup to finish" >&2
      return 1
    fi

    progress=$(ocr_screen | tr -d ' \n')
    if [[ $progress =~ ^[0-9]{1,3}.?$ ]]; then
      gone=0
      if ((waited % 20 == 0)); then
        printf -v prompt 'success-provision-08-finalizing-%03ds' "$waited"
        capture_console "$prompt"
        shots=$((shots + 1))
      fi
    elif [[ -n $progress ]]; then
      gone=$((gone + 1))
    fi

    sleep 4
    ((waited += 4))
  done
  ((shots)) || capture_console "success-provision-08-finalizing"
}

wait_for_install() {
  log "Waiting for the install to finish (timeout ${INSTALL_TIMEOUT}s)"

  local waited=0 text progress_name
  while true; do
    text=$(ocr_screen)

    if grep -qi "Reboot Now" <<<"$text"; then
      log "Install finished. Confirming the reboot prompt."
      capture_console "success-installer-15-reboot"
      press ret
      return 0
    fi

    # Deferred-provisioning installs skip the celebration and reboot on their own
    # (no Reboot Now prompt); the first-boot greeter tagline appearing means the
    # install finished and rebooted into setup.
    if $PROVISION && OCR_THRESHOLD=$GREETER_OCR_THRESHOLD ocr_screen | grep -qi "$GREETER_TEXT"; then
      log "Install finished and auto-rebooted into first-boot setup."
      capture_console "success-installer-15-autoreboot"
      return 0
    fi

    if grep -qi "installation stopped" <<<"$text"; then
      capture_console "failure-installer-installation-stopped"
      echo "Install failed — screenshot saved to $RUN_DIR" >&2
      return 1
    fi

    if ! vm_running; then
      echo "VM exited during install" >&2
      return 1
    fi

    if ((waited >= INSTALL_TIMEOUT)); then
      capture_console "failure-installer-install-timeout"
      echo "Timed out after ${INSTALL_TIMEOUT}s waiting for install" >&2
      return 1
    fi

    if ((waited % 60 == 0)); then
      printf -v progress_name 'success-installer-14-install-progress-%04ds' "$waited"
      capture_console "$progress_name"
      echo "    ... installing (${waited}s)"
    fi

    sleep 10
    ((waited += 10))
  done
}

# Encrypted boots stop at the LUKS passphrase prompt. Plymouth's prompt isn't
# reliably OCR-able, so type the passphrase on an interval until a console
# login becomes reachable; early keystrokes are harmlessly discarded.
unlock_luks() {
  log "Typing the LUKS passphrase until boot proceeds"

  local waited=0
  sleep 10
  capture_console "success-first-boot-01-luks-prompt"

  while true; do
    type_text "$GUEST_PASSWORD"
    if ((waited == 0)); then
      capture_console "success-first-boot-02-luks-passphrase"
    fi
    press ret
    sleep 20
    ((waited += 30))

    press ctrl-alt-f3
    sleep 3
    if ocr_screen | grep -qi "login:"; then
      return 0
    fi

    if ((waited >= 300)); then
      capture_console "failure-first-boot-luks-timeout"
      echo "Timed out waiting for LUKS unlock" >&2
      return 1
    fi
  done
}

# With no NIC there is no SSH to wait for, so the first boot has to show on
# screen that it came up: a console login under the installed hostname. The
# live ISO's own getty has another name, so its prompt while the reboot is
# still going does not count.
wait_for_first_boot_login() {
  log "Waiting for the installed system's console login"

  local waited=0
  until ocr_screen | grep -qi "$GUEST_HOSTNAME login:"; do
    if ! vm_running; then
      echo "VM exited before the installed system reached a login" >&2
      return 1
    fi

    if ((waited >= BOOT_TIMEOUT)); then
      capture_console "failure-first-boot-no-login"
      echo "Timed out after ${BOOT_TIMEOUT}s waiting for the $GUEST_HOSTNAME login" >&2
      return 1
    fi

    press ctrl-alt-f3
    sleep 10
    ((waited += 10))
  done
}

# Log into a spare console TTY as the user and authorize the harness SSH key —
# the same thing a person would do to give themselves remote access.
bootstrap_ssh() {
  log "Authorizing SSH access via console login"

  mkdir -p "$BASE_DIR/www"
  cat >"$BASE_DIR/www/bootstrap" <<EOF
mkdir -p ~/.ssh && chmod 700 ~/.ssh
echo "$(cat "$SSH_KEY.pub")" >>~/.ssh/authorized_keys
chmod 600 ~/.ssh/authorized_keys
echo "$GUEST_PASSWORD" | sudo -S ufw allow from 10.0.2.2 to any port 22 proto tcp
echo "$GUEST_PASSWORD" | sudo -S systemctl enable --now sshd.service
EOF

  (cd "$BASE_DIR/www" && exec python3 -m http.server "$HTTP_PORT" --bind 127.0.0.1 >/dev/null 2>&1) &
  HTTP_PID=$!

  # Type the login blind: a VNC viewer that resizes the framebuffer makes the
  # console font unreadable to OCR, and the real gate is SSH coming up anyway.
  # Getty re-prompts after a failed login, so a whole-sequence retry recovers
  # from typing before the prompt was ready.
  sleep 15 # give first boot time to reach getty
  local attempt
  for attempt in 1 2 3; do
    press ctrl-alt-f3
    sleep 8
    press ret # settle a half-typed prompt from a previous attempt
    sleep 2
    type_text "$GUEST_USER"
    capture_console "success-first-boot-03-console-username"
    press ret
    sleep 3
    type_text "$GUEST_PASSWORD"
    press ret
    sleep 4
    type_text "curl -fsS http://10.0.2.2:$HTTP_PORT/bootstrap -o /tmp/bs && bash /tmp/bs"
    capture_console "success-first-boot-05-bootstrap-command"
    press ret

    if wait_for_ssh 120 "failure-first-boot-ssh-timeout-$attempt"; then
      capture_console "success-first-boot-06-bootstrap-complete"
      kill "$HTTP_PID" 2>/dev/null || true
      HTTP_PID=""
      press ctrl-alt-f1
      return 0
    fi
  done

  echo "Console bootstrap did not produce SSH access after 3 attempts" >&2
  return 1
}

# Get a freshly booted system to a running Hyprland session, typing at the
# LUKS prompt and/or SDDM greeter exactly like a user would.
establish_session() {
  if $ENCRYPT; then
    local waited=0
    sleep 10
    capture_console "success-session-01-luks-prompt"
    until ssh_guest true 2>/dev/null; do
      type_text "$GUEST_PASSWORD"
      if ((waited == 0)); then
        capture_console "success-session-02-luks-passphrase"
      fi
      press ret
      sleep 15
      ((waited += 16))

      if ((waited >= BOOT_TIMEOUT)); then
        capture_console "failure-session-luks-timeout"
        echo "Timed out unlocking LUKS" >&2
        return 1
      fi
    done
    # Encrypted installs autologin once the disk is unlocked
  else
    wait_for_ssh "$BOOT_TIMEOUT" "failure-session-ssh-timeout"
    sleep 5
  fi

  local waited=0
  until session_started; do
    if ! $ENCRYPT; then
      # SDDM remembers the user and focuses the password field
      if ((waited == 0)); then
        capture_console "success-session-01-login"
      fi
      type_text "$GUEST_PASSWORD"
      if ((waited == 0)); then
        capture_console "success-session-02-password"
      fi
      press ret
    fi
    sleep 10
    ((waited += 11))

    if ((waited >= 300)); then
      capture_console "failure-session-start-timeout"
      echo "Timed out waiting for the Hyprland session" >&2
      return 1
    fi
  done

  capture_console "success-session-03-desktop"
}

# -------------------------------------------------------------------- phases

# A synthetic Windows-style disk for the free-space install: a FAT32 ESP and
# an ext4 data partition carrying a marker file, followed by ~76GiB of
# unallocated space. Built without root: parted partitions the raw file, the
# filesystems are made straight into it at their offsets. Unlike
# omarchy-iso-test-windows-disk it has no EFI/Microsoft directory (that needs
# mtools or a mount), so the configurator reports no Windows ESP; the
# free-space mechanics it exercises are the same either way.
create_free_space_disk() {
  local disk="$1" raw="$1.raw" populate="$RUN_DIR/.preserve"
  local esp_start_mib=1 esp_size_mib=512 data_end_mib=$((20 * 1024))

  rm -f "$disk" "$raw"
  truncate -s 96G "$raw"
  parted --script "$raw" \
    mklabel gpt \
    mkpart WINDOWS_ESP fat32 "${esp_start_mib}MiB" "$((esp_start_mib + esp_size_mib))MiB" \
    set 1 esp on \
    mkpart WINDOWS_DATA ext4 "$((esp_start_mib + esp_size_mib))MiB" "${data_end_mib}MiB"

  mkfs.fat -F32 -n WINDOWS_ESP -C "$RUN_DIR/.esp.img" $((esp_size_mib * 1024)) >/dev/null
  dd if="$RUN_DIR/.esp.img" of="$raw" bs=1M seek="$esp_start_mib" conv=notrunc,sparse status=none
  rm -f "$RUN_DIR/.esp.img"

  rm -rf "$populate"
  mkdir -p "$populate"
  echo "This file must survive the Omarchy install." >"$populate/OMARCHY-MUST-NOT-TOUCH.txt"
  mkfs.ext4 -q -F -L WINDOWS_DATA -d "$populate" \
    -E offset=$(( (esp_start_mib + esp_size_mib) * 1024 * 1024 )) \
    "$raw" "$(( (data_end_mib - esp_start_mib - esp_size_mib) * 1024 ))k"
  rm -rf "$populate"

  qemu-img convert -f raw -O qcow2 "$raw" "$disk"
  rm -f "$raw"
}

# The partitions the free-space install had to leave alone, checked from
# inside the installed system.
verify_preserved_partitions() {
  log "Verifying the pre-existing partitions survived"
  local report="$RUN_DIR/preserved-partitions.txt"

  ssh_guest "lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINTS" >"$report" 2>&1 || true
  if ! ssh_guest "echo $GUEST_PASSWORD | sudo -S -p '' sh -c '
      blkid -L WINDOWS_ESP >/dev/null &&
      mkdir -p /run/preserve && mount -o ro LABEL=WINDOWS_DATA /run/preserve &&
      test -f /run/preserve/OMARCHY-MUST-NOT-TOUCH.txt; rc=\$?; umount /run/preserve 2>/dev/null; exit \$rc'"; then
    capture_console "failure-free-space-partitions-lost"
    echo "Pre-existing partitions were not preserved; see $report" >&2
    return 1
  fi
  log "WINDOWS_ESP and WINDOWS_DATA (with its marker file) are intact"
}

# The installer encrypts in 4096-byte sectors, which cryptsetup refuses on a
# partition whose size 4096 does not divide; both paths make one that it does.
verify_luks_sector_size() {
  local report="$RUN_DIR/luks-sector-size.txt" sector size
  ssh_guest "echo $GUEST_PASSWORD | sudo -S -p '' sh -c '
      dev=\$(blkid -t TYPE=crypto_LUKS -o device | head -n 1)
      echo size \$(blockdev --getsize64 \$dev); cryptsetup luksDump \$dev'" >"$report" 2>&1 || true
  sector=$(awk '$1 == "sector:" { print $2; exit }' "$report")
  size=$(awk '$1 == "size" { print $2; exit }' "$report")
  if [[ $sector != 4096 ]] || ((size % 4096)); then
    echo "The root's LUKS sectors are ${sector:-unknown} bytes on a ${size:-unknown}-byte partition; see $report" >&2
    return 1
  fi
  log "The root's LUKS sectors are 4096 bytes on a $size-byte partition"
}

install_phase() {
  log "Installing $(basename "$ISO") into a fresh VM (headless, driven via console)"

  [[ -f $SSH_KEY ]] || ssh-keygen -t ed25519 -N "" -q -C "omarchy-iso-test" -f "$SSH_KEY"

  if $FREE_SPACE; then
    log "Building the synthetic Windows-style disk"
    create_free_space_disk "$BASE_DISK"
  else
    rm -f "$BASE_DISK"
    qemu-img create -f qcow2 "$BASE_DISK" 40G >/dev/null
  fi
  cp "$OVMF_VARS_TEMPLATE" "$BASE_OVMF"

  start_vm "$BASE_DISK" "$RUN_DIR/install-serial.log" \
    -drive "file=$ISO,media=cdrom,if=none,format=raw,id=cdrom0" \
    -device ide-cd,drive=cdrom0,bootindex=2

  drive_configurator
  wait_for_install

  if $PROVISION; then
    drive_provision_owner
  elif $ENCRYPT; then
    unlock_luks
  fi
  if $NO_NETWORK; then
    # Nothing to SSH through. The install finished and the installed system
    # booted to its console login; that is what a machine with no NIC has to
    # show.
    wait_for_first_boot_login
    log "No network: the installed system booted to its login; stopping here."
    capture_console "success-first-boot-no-network"
    return 0
  fi
  bootstrap_ssh
  $FREE_SPACE && verify_preserved_partitions
  $ENCRYPT && verify_luks_sector_size

  # SSH can come up (console bootstrap logs in on a spare TTY) while
  # omarchy-provision-owner is still finalizing the user and re-keying LUKS. Saving
  # the base mid-finalization produces a flaky image, so wait for the pending
  # flag to clear before powering off.
  if $PROVISION; then
    log "Waiting for provisioning first-boot setup to finish"
    local waited=0 rc
    while true; do
      # Capture rc via `|| rc=$?` so a non-zero result doesn't trip `set -e`
      # (this command is intentionally allowed to "fail" — that's the signal).
      rc=0
      ssh_guest "test -f /var/lib/omarchy/provisioning/pending" 2>/dev/null || rc=$?
      # rc 0 = flag still present; rc 255 = SSH not up yet (finalization may
      # still be running) — keep waiting. Only a clean "file absent" (rc 1)
      # means provisioning finished, so we don't snapshot mid-finalization on a
      # transient SSH blip.
      (( rc == 0 || rc == 255 )) || break
      if ((waited >= 900)); then
        capture_console "failure-provision-finalization-timeout"
        echo "Timed out waiting for provisioning first-boot setup to complete" >&2
        return 1
      fi
      sleep 10
      ((waited += 10))
    done

    # The owner's hostname and timezone are set at first boot now, not baked
    # into the install — confirm they actually landed on the running system.
    # Hostname is deterministic (we typed it), so a mismatch is a hard failure;
    # timezone is geo-guessed, so just report what landed.
    local got_host="" got_tz=""
    got_host=$(ssh_guest "cat /etc/hostname" 2>/dev/null | tr -d '\r\n') || got_host=""
    got_tz=$(ssh_guest "timedatectl show -p Timezone --value" 2>/dev/null | tr -d '\r\n') || got_tz=""
    if [[ $got_host != "$GUEST_HOSTNAME" ]]; then
      capture_console "failure-provision-hostname-not-applied"
      echo "First-boot hostname is '${got_host:-<empty>}', expected '$GUEST_HOSTNAME'" >&2
      return 1
    fi
    log "hostname applied at first boot: $got_host"
    if [[ -n $OEM_CONFIG ]]; then
      verify_oem_setup
    fi
    if [[ -n $got_tz && $got_tz != "UTC" ]]; then
      log "timezone applied at first boot: $got_tz"
    else
      echo "WARN: timezone is '${got_tz:-<empty>}' (expected the owner's choice, not UTC)" >&2
    fi

    # Deferred first-boot setup hands straight off to SDDM once the oneshot
    # service exits — no celebration screen, no Start Omarchy button to confirm.
    capture_console "success-provision-09-handoff"
  fi

  ssh_guest "echo $GUEST_PASSWORD | sudo -S cat /var/log/omarchy-install-timing.json 2>/dev/null" \
    >"$RUN_DIR/omarchy-install-timing.json" 2>/dev/null || true
  ssh_guest "echo $GUEST_PASSWORD | sudo -S cat /var/log/pacman.log 2>/dev/null" \
    >"$RUN_DIR/pacman.log" 2>/dev/null || true

  # Keep format decisions and step timings for --install-only runs too.
  ssh_guest "echo $GUEST_PASSWORD | sudo -S cat /var/log/omarchy-install.log 2>/dev/null" \
    >"$RUN_DIR/omarchy-install.log" 2>/dev/null || true

  log "Installed system is up. Saving base image."
  stop_vm
}

sync_omarchy() {
  [[ -n $SYNC_DIR ]] || return 0

  local target=".local/share/omarchy"

  if $SYNC_ALL; then
    log "Syncing $SYNC_DIR into the guest"
    tar -C "$SYNC_DIR" --exclude .git -cf - . | ssh_guest "mkdir -p $target && tar -C $target -xf -"
  else
    log "Syncing $SYNC_DIR/test into the guest"
    tar -C "$SYNC_DIR" -cf - test | ssh_guest "mkdir -p $target && tar -C $target -xf -"
  fi
}

acceptance_phase() {
  log "Booting acceptance VM from base image overlay"

  qemu-img create -f qcow2 -b "$BASE_DISK" -F qcow2 "$RUN_DIR/run.qcow2" >/dev/null
  start_vm "$RUN_DIR/run.qcow2" "$RUN_DIR/serial.log"

  establish_session
  sync_omarchy

  local status=0
  shortcut_smoke_phase || status=1

  # The synced tree is a full checkout under --sync-all; run the host-style
  # CLI and shell suites in the guest too before the graphical acceptance
  # run. They derive their root from their own location in the synced tree.
  if $SYNC_ALL; then
    log "Running CLI and shell suites in the guest"
    ssh_guest "bash .local/share/omarchy/test/all" || status=$?
  fi

  # The product under test is always the installed tree — VM runs verify the
  # finished product, never a dev-linked checkout.
  log "Running acceptance suite"
  ssh_guest "OMARCHY_PATH=/usr/share/omarchy OMARCHY_ACCEPTANCE_DIR=/tmp/omarchy-acceptance \
    OMARCHY_ACCEPTANCE_SUDO_PASSWORD=$GUEST_PASSWORD bash .local/share/omarchy/test/acceptance" || status=$?

  log "Collecting artifacts into $RUN_DIR"
  ssh_guest "tar -C /tmp -cf - omarchy-acceptance 2>/dev/null" | tar -C "$RUN_DIR" -xf - || true
  ssh_guest "echo $GUEST_PASSWORD | sudo -S cat /var/log/omarchy-install.log 2>/dev/null" >"$RUN_DIR/omarchy-install.log" 2>/dev/null || true
  if ((status == 0)); then
    capture_console "success-acceptance-final"
  else
    capture_console "failure-acceptance-final"
  fi

  return $status
}

# ---------------------------------------------------------------------- main

if $REUSE_BASE && [[ -f $BASE_DISK ]]; then
  log "Reusing existing base image: $BASE_DISK"
else
  install_phase
fi

if $NO_NETWORK && ! $INSTALL_ONLY; then
  log "No network: the acceptance suite needs SSH; stopping after the install"
  INSTALL_ONLY=true
fi
if $INSTALL_ONLY; then
  log "Base image ready: $BASE_DISK"
  exit 0
fi

if acceptance_phase; then
  log "Acceptance suite passed. Artifacts: $RUN_DIR"
else
  log "Acceptance suite FAILED. Artifacts: $RUN_DIR"
  exit 1
fi
