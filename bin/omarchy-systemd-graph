#!/bin/bash
#
# Emit the install phase graph as Mermaid, derived from the unit files —
# the same parse the dashboard's roster uses, so the drawing cannot drift
# from the graph systemd actually walks. Paste the output into a GitHub
# comment inside a ```mermaid fence, or feed it to anything that renders
# Mermaid.
#
#   omarchy-systemd-graph [units-dir]
#
# Solid arrows are Requires=+After= phase edges; dashed arrows are
# ordering-only (After= without Requires=, e.g. the keyring unit before
# the factory snapshot); dotted arrows are RequiresMountsFor= paths.
set -euo pipefail

UNITS_DIR=${1:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)/configs/airootfs/etc/systemd/system}
[[ -d $UNITS_DIR ]] || { echo "no such units dir: $UNITS_DIR" >&2; exit 1; }

declare -A display requires after mounts_for emitted is_boot
units=()
boot_units=()
for f in "$UNITS_DIR"/omarchy-install-*.service; do
  [[ -f $f ]] || continue
  line=$(grep -m1 -E '^ExecStart=.*run-phase ' "$f" 2>/dev/null) || continue
  unit=${f##*/}
  name=${line#*run-phase *\"}
  name=${name%%\"*}
  display[$unit]=$name
  units+=("$unit")
  requires[$unit]=$(grep -E '^Requires=' "$f" 2>/dev/null |
    grep -oE 'omarchy-[a-z-]+\.(service|target)' | sort -u | tr '\n' ' ') || requires[$unit]=""
  after[$unit]=$(grep -E '^After=' "$f" 2>/dev/null |
    grep -oE 'omarchy-[a-z-]+\.(service|target)' | sort -u | tr '\n' ' ') || after[$unit]=""
  mounts_for[$unit]=$(grep -E '^RequiresMountsFor=' "$f" 2>/dev/null |
    cut -d= -f2 | tr '\n' ' ') || mounts_for[$unit]=""
done
((${#units[@]})) || { echo "no phase units under $UNITS_DIR" >&2; exit 1; }

# The boot verifies and the prefetch: not phases, but the install's story
# starts with them -- WantedBy=multi-user.target marks them boot-started.
for f in "$UNITS_DIR"/omarchy-*.service; do
  [[ -f $f ]] || continue
  unit=${f##*/}
  [[ -n ${display[$unit]:-} ]] && continue
  grep -qE '^WantedBy=multi-user.target' "$f" 2>/dev/null || continue
  is_boot[$unit]=1
  boot_units+=("$unit")
  after[$unit]=$(grep -E '^After=' "$f" 2>/dev/null |
    grep -oE 'omarchy-[a-z-]+\.(service|target)' | sort -u | tr '\n' ' ') || after[$unit]=""
  requires[$unit]=""
  mounts_for[$unit]=$(grep -E '^RequiresMountsFor=' "$f" 2>/dev/null |
    cut -d= -f2 | tr '\n' ' ') || mounts_for[$unit]=""
done

# Kahn in sorted-name scan order: stable, and on a linear chain it IS the
# chain — the same walk the dashboard and the wiring test do.
mapfile -t units < <(printf '%s\n' "${units[@]}" | sort)
ordered=()
remaining=${#units[@]}
while ((remaining > 0)); do
  progressed=0
  for unit in "${units[@]}"; do
    [[ -n ${emitted[$unit]:-} ]] && continue
    ready=1
    for dep in ${requires[$unit]}; do
      [[ -n ${display[$dep]:-} && -z ${emitted[$dep]:-} ]] && { ready=0; break; }
    done
    ((ready)) || continue
    emitted[$unit]=1
    ordered+=("$unit")
    remaining=$((remaining - 1))
    progressed=1
  done
  ((progressed)) || { echo "cycle among the phase units" >&2; exit 1; }
done

# Node id: the unit's short name, mermaid-safe.
nid() { local s=${1#omarchy-install-}; s=${s%.service}; s=${s%.target}; printf '%s' "${s//-/_}"; }

# Node label: the full unit name, split over three lines so the boxes stay
# narrow -- shared prefix, the distinctive part, the file suffix.
nlabel() {
  local base=${1%.service} prefix=omarchy-
  [[ $base == omarchy-install-* ]] && prefix=omarchy-install-
  printf '%s<br/>%s<br/>.service' "$prefix" "${base#"$prefix"}"
}

rev=$(git -C "$UNITS_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)
printf '%%%% omarchy install graph at %s -- generated by bin/omarchy-systemd-graph\n' "$rev"
echo 'flowchart LR'
echo '  classDef phase fill:#e3eee6,stroke:#2f7d4f,color:#20242a,font-family:monospace;'
echo '  classDef aux fill:#eceff3,stroke:#8b94a1,color:#20242a,font-family:monospace,stroke-dasharray:4 3;'
echo '  classDef boot fill:#fdf3e3,stroke:#a8722c,color:#20242a,font-family:monospace;'
echo

if ((${#boot_units[@]})); then
  echo '  subgraph boot["boot-started (WantedBy=multi-user.target)"]'
  for unit in "${boot_units[@]}"; do
    printf '    %s["%s"]:::boot\n' "$(nid "$unit")" "$(nlabel "$unit")"
  done
  echo '  end'
  for unit in "${boot_units[@]}"; do
    for dep in ${after[$unit]}; do
      [[ -n ${is_boot[$dep]:-} ]] || continue
      printf '  %s -. After= .-> %s\n' "$(nid "$dep")" "$(nid "$unit")"
    done
  done
  echo
fi

for unit in "${ordered[@]}"; do
  printf '  %s["%s"]:::phase\n' "$(nid "$unit")" "$(nlabel "$unit")"
done
echo

# The pre-flight gate does not depend on the verifies through unit edges:
# it reads their latched verdicts in-process. The units it consults are
# named as *_VERIFY_UNIT constants in the orchestrator, and the phase
# doing the reading hosts prepare_install_target -- both derivable.
ORCH_DIR=$(cd -- "$UNITS_DIR/../../../usr/share/omarchy-iso/orchestrator" 2>/dev/null && pwd) || ORCH_DIR=""
if [[ -n $ORCH_DIR ]]; then
  gate_unit=$(grep -lE '^ExecStart=.*run-phase prepare_install_target ' "$UNITS_DIR"/omarchy-install-*.service 2>/dev/null | head -1)
  gate_unit=${gate_unit##*/}
  if [[ -n $gate_unit ]]; then
    for vu in $(grep -hoE '^[A-Z_]*VERIFY_UNIT=omarchy-[a-z-]+\.service' "$ORCH_DIR"/*.sh 2>/dev/null |
      cut -d= -f2 | sort -u); do
      [[ -n ${is_boot[$vu]:-} ]] || continue
      printf '  %s -. "latched verdict read in-process" .-> %s\n' "$(nid "$vu")" "$(nid "$gate_unit")"
    done
    echo
  fi
fi

declare -A aux_seen
for unit in "${ordered[@]}"; do
  for dep in ${requires[$unit]}; do
    [[ -n ${display[$dep]:-} ]] || continue
    printf '  %s --> %s\n' "$(nid "$dep")" "$(nid "$unit")"
  done
  # Ordering-only edges: After= entries with no matching Requires= (and not
  # the umbrella target, whose PartOf story the units all share).
  for dep in ${after[$unit]}; do
    [[ " ${requires[$unit]} " == *" $dep "* ]] && continue
    [[ $dep == omarchy-install.target ]] && continue
    if [[ -z ${display[$dep]:-} && -z ${aux_seen[$dep]:-} ]]; then
      printf '  %s["%s"]:::aux\n' "$(nid "$dep")" "$(nlabel "$dep")"
      aux_seen[$dep]=1
    fi
    printf '  %s -. "After= only" .-> %s\n' "$(nid "$dep")" "$(nid "$unit")"
  done
  for path in ${mounts_for[$unit]}; do
    if [[ -z ${aux_seen[$path]:-} ]]; then
      printf '  mnt%s["%s"]:::aux\n' "$(printf '%s' "$path" | tr -c 'a-zA-Z0-9' '_')" "$path"
      aux_seen[$path]=1
    fi
    printf '  mnt%s -. RequiresMountsFor .-> %s\n' "$(printf '%s' "$path" | tr -c 'a-zA-Z0-9' '_')" "$(nid "$unit")"
  done
done
