#!/usr/bin/env bash
# mkarchiso calls mksquashfs after its final cleanup of the live tree.
set -euo pipefail
if [[ -z ${OMARCHY_ROOT_SFS:-} || ${1:-} != */airootfs || ! -d $1 ]]; then
  exec /usr/bin/mksquashfs "$@"
fi
live_root=$(realpath -- "$1")
shift

work=$(mktemp -d)
container_loop=
system_loop=
cleanup() {
  if mountpoint -q "$work/system"; then umount "$work/system" || return; fi
  if [[ -n $system_loop ]]; then losetup -d "$system_loop" || return; fi
  if mountpoint -q "$work/container"; then umount "$work/container" || return; fi
  if [[ -n $container_loop ]]; then losetup -d "$container_loop" || return; fi
  rm -rf -- "$work"
}
trap cleanup EXIT
mkdir "$work/container" "$work/system"
container_loop=$(/builder/attach-loop.sh "$OMARCHY_ROOT_SFS" --read-only)
mount -t squashfs -o ro "$container_loop" "$work/container"
system_loop=$(/builder/attach-loop.sh "$work/container/omarchy-root.img" --read-only)
mount -t btrfs -o ro,subvol=omarchy-root "$system_loop" "$work/system"
python3 "${BASH_SOURCE[0]%/*}/compare.py" "$live_root" "$work/system" "$work/exclude" "$work/whiteouts"
/usr/bin/mksquashfs "$live_root" "$@" -ef "$work/exclude" -pf "$work/whiteouts"
