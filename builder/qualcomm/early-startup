#!/usr/bin/ash
# Opt-in live-image candidate, not a USB-ready ABI. Start the firmware before
# normal udev coldplug when firmware is present. Otherwise keep legacy startup;
# a failure after starting still prevents all Archiso disk searches.

qcom_startup_log() {
    printf 'qcom-startup: %s\n' "$*"
    printf 'qcom-startup: %s\n' "$*" >>/dev/kmsg 2>/dev/null || :
}

qcom_startup_fail() {
    qcom_startup_failed=$*
    qcom_startup_log "FAILED: $*"
    return 1
}

qcom_startup_now() {
    local uptime rest
    read -r uptime rest </proc/uptime
    printf '%s\n' "${uptime%%.*}"
}

qcom_startup_select() {
    local file profile utility found=0
    qcom_startup_owner=''
    qcom_startup_profile=''
    [ -r /proc/device-tree/compatible ] || return 0
    for utility in cat grep readlink tr; do
        command -v "$utility" >/dev/null 2>&1 || {
            qcom_startup_fail "missing early-boot utility: $utility"; return 1;
        }
    done
    # These are the firmware owners, not a list of laptop model names.
    for file in /sys/bus/platform/devices/*/of_node/compatible; do
        [ -r "$file" ] || continue
        if [ -r "${file%compatible}status" ] &&
            ! grep -Eq '^(okay|ok)' "${file%compatible}status"; then
            continue
        fi
        profile=''
        if grep -Fq 'qcom,x1e80100-adsp-pas' "$file" ||
            grep -Fq 'qcom,sc8280xp-adsp-pas' "$file"; then
            profile=adsp
        elif grep -Fq 'qcom,glymur-soccp-pas' "$file"; then
            profile=soccp
        fi
        [ -n "$profile" ] || continue
        found=$((found + 1))
        qcom_startup_owner=$(readlink -f "${file%/compatible}") || return 1
        qcom_startup_profile=$profile
    done
    [ "$found" -le 1 ] || { qcom_startup_fail 'ambiguous firmware owners'; return 1; }
}

qcom_startup_legacy() {
    # Fallback is allowed only before loading drivers or triggering coldplug.
    case ",$(getarg modprobe.blacklist)," in
        *,qcom_q6v5_pas,*|*,qcom-q6v5-pas,*) ;;
        *) qcom_startup_fail 'legacy path requires the firmware-driver blacklist'; return 1 ;;
    esac
    [ ! -d /sys/module/qcom_q6v5_pas ] || {
        qcom_startup_fail 'cannot fall back after the firmware driver loaded'; return 1;
    }
    qcom_startup_log "keeping legacy startup: $*"
    qcom_startup_active=0
}

qcom_startup_firmware_present() {
    local directory suffix
    for directory in "/usr/lib/firmware/updates/$qcom_startup_release" /usr/lib/firmware/updates "/usr/lib/firmware/$qcom_startup_release" /usr/lib/firmware; do
        for suffix in '' .xz .zst; do
            [ ! -s "$directory/$1$suffix" ] || return 0
        done
    done
    return 1
}

qcom_startup_preflight() {
    local names firmware count=0
    # SOCCP attaches to firmware already supplied by UEFI on Glymur.
    [ "$qcom_startup_profile" = adsp ] || return 0
    read -r qcom_startup_release </proc/sys/kernel/osrelease || {
        qcom_startup_fail 'cannot read kernel release'; return 1;
    }
    [ -r "$qcom_startup_owner/firmware-name" ] || {
        qcom_startup_legacy 'no ADSP firmware names in the device tree'; return;
    }
    names=$(tr '\000' '\n' <"$qcom_startup_owner/firmware-name") || {
        qcom_startup_fail 'cannot read ADSP firmware names'; return 1;
    }
    while IFS= read -r firmware; do
        [ -n "$firmware" ] || continue
        case "$firmware" in
            /*|../*|*/../*|*/..) qcom_startup_fail 'invalid ADSP firmware name'; return 1 ;;
        esac
        count=$((count + 1))
        if ! qcom_startup_firmware_present "$firmware"; then
            qcom_startup_legacy "missing $firmware"
            return
        fi
    done <<EOF
$names
EOF
    [ "$count" -ne 0 ] || qcom_startup_legacy 'empty ADSP firmware list'
}

qcom_startup_state() {
    local node owner count=0
    qcom_startup_current=missing
    for node in /sys/class/remoteproc/remoteproc*; do
        [ -r "$node/state" ] || continue
        owner=$(readlink -f "$node/device/of_node") || continue
        [ "$owner" = "$qcom_startup_owner" ] || continue
        count=$((count + 1))
        qcom_startup_current=$(cat "$node/state") || return 1
    done
    [ "$count" -le 1 ] || return 1
    case "$qcom_startup_profile:$qcom_startup_current" in
        adsp:running|soccp:attached|soccp:running) return 0 ;;
    esac
    return 1
}

qcom_startup_wait() {
    local deadline
    deadline=$(( $(qcom_startup_now) + qcom_startup_timeout ))
    while ! qcom_startup_state; do
        case "$qcom_startup_current" in
            crashed|deleted) qcom_startup_fail "firmware is $qcom_startup_current"; return 1 ;;
        esac
        if [ "$(qcom_startup_now)" -ge "$deadline" ]; then
            qcom_startup_fail "firmware startup timed out ($qcom_startup_current)"
            return 1
        fi
        # Poll an actual condition; this is not a fixed USB settling delay.
        sleep 0.1
    done
    qcom_startup_log "firmware started: $qcom_startup_profile=$qcom_startup_current"
}

run_earlyhook() {
    local module timeout
    [ "$(getarg omarchy.qcom_early)" = 1 ] || return 0
    qcom_startup_active=1
    qcom_startup_failed=''
    qcom_startup_select || return 1
    if [ -z "$qcom_startup_owner" ]; then
        if grep -Fq 'qcom,' /proc/device-tree/compatible; then
            qcom_startup_legacy 'no supported firmware owner'
        else
            qcom_startup_active=0
        fi
        return
    fi
    timeout=$(getarg omarchy.qcom_timeout 30)
    case "$timeout" in ''|*[!0-9]*) qcom_startup_fail 'invalid firmware timeout'; return 1 ;; esac
    [ "$timeout" -ge 1 ] && [ "$timeout" -le 120 ] || {
        qcom_startup_fail 'firmware timeout must be 1..120 seconds'; return 1;
    }
    qcom_startup_timeout=$timeout
    # A kernel-enforced ban cannot be overridden by an explicit modprobe.
    case ",$(getarg module_blacklist)," in
        *,qcom_q6v5_pas,*|*,qcom-q6v5-pas,*)
            qcom_startup_fail 'firmware driver remains blacklisted'; return 1 ;;
    esac
    qcom_startup_preflight || return 1
    [ "$qcom_startup_active" = 1 ] || return 0
    # Providers from the source image's normal preload list must bind too.
    # A failed optional preload is diagnosed by the required processor check.
    if [ -n "${MODULES:-}" ]; then
        modprobe -qab $MODULES || qcom_startup_log 'some source preload modules were unavailable'
    fi
    # Explicit modprobe bypasses the alias blacklist; automatic coldplug keeps
    # respecting it on the legacy path. Load QRTR without waiting for Wi-Fi.
    for module in qrtr qrtr_smd qcom_pd_mapper qcom_q6v5_pas pmic_glink pmic_glink_altmode ucsi_glink; do
        modprobe "$module" || {
            qcom_startup_fail "cannot load $module"; return 1;
        }
    done
    # Do not deadlock a deferred firmware probe by waiting before its suppliers
    # can autoload. No filesystems are mounted by initramfs udev coldplug.
    udevadm trigger --action=add --type=subsystems &&
        udevadm trigger --action=add --type=devices || {
            qcom_startup_fail 'cannot trigger firmware suppliers'; return 1;
        }
    qcom_startup_wait
}

qcom_startup_mount() {
    [ -z "$qcom_startup_failed" ] || {
        qcom_startup_log "refusing disk search/mount: $qcom_startup_failed"
        return 1
    }
    qcom_startup_state || {
        qcom_startup_fail "firmware stopped before disk search ($qcom_startup_current)"
        return 1
    }
    udevadm settle --timeout="$qcom_startup_timeout" || {
        qcom_startup_fail 'udev queue did not settle'; return 1;
    }
    qcom_startup_state || {
        qcom_startup_fail "firmware stopped while settling udev ($qcom_startup_current)"
        return 1
    }
    qcom_startup_log 'starting Archiso disk search; downstream USB readiness is not asserted'
    "$qcom_startup_original_mount" "$@"
}

run_hook() {
    [ "${qcom_startup_active:-0}" = 1 ] || return 0
    # This hook must be last in HOOKS: loop/PXE hooks choose the handler too.
    # A normal hook error does not stop /init, so guard the handler itself,
    # including Archiso's fallback search, which may mount other partitions.
    qcom_startup_original_mount=$mount_handler
    mount_handler=qcom_startup_mount
}
