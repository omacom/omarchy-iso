#!/bin/bash

build() {
    local module firmware names
    # Explicit dependencies are needed before udev has discovered Wi-Fi or
    # brought up the firmware transport. mkinitcpio handles built-in modules.
    for module in qrtr qrtr_smd qcom_pd_mapper qcom_q6v5_pas pmic_glink pmic_glink_altmode ucsi_glink; do
        add_module "$module" || return 1
    done
    # The medium's ADSP firmware (qcom_startup_fetch) is ISO9660 and needs
    # blkid, cp, mount, rm, sha256sum, umount and uname before the archiso hook runs.
    add_module isofs || return 1
    for module in blkid cat cp grep mkdir mount readlink rm sha256sum sleep tr umount uname; do
        add_binary "/usr/bin/$module" || return 1
    done
    [[ -n ${OMARCHY_QCOM_DTBS_FILE:-} && -r $OMARCHY_QCOM_DTBS_FILE ]] || {
        error 'The Qualcomm live UKI must provide its device-tree list'
        return 1
    }
    # These drivers obtain firmware names from DT, so modinfo alone cannot
    # include the blobs. Request only --required (ADSP owner) blobs: optional
    # CDSP/SLPI/GPU/video blobs are never started in initramfs and bloat the
    # live UKI that GRUB must read over slow UEFI BlockIO. Keep mkinitcpio's
    # normal updates/compression lookup.
    names=$(python3 /usr/lib/initcpio/qcom-early-firmware.py --required "$OMARCHY_QCOM_DTBS_FILE") || return 1
    while IFS= read -r firmware; do
        [[ -n $firmware ]] || continue
        add_firmware "$firmware" || warning "Qualcomm device-tree firmware unavailable: $firmware"
    done <<<"$names"
    # Adreno X1 / X2 GPU microcode (~200 KiB compressed): msm requests these
    # once when it binds early in boot, so keeping them in the live UKI ensures
    # the GPU stays initialized across soft-reboot into Try Omarchy.
    for firmware in \
        qcom/gen70500_sqe.fw qcom/gen70500_gmu.bin \
        qcom/gen71500_sqe.fw qcom/gen71500_gmu.bin \
        qcom/gen80100_sqe.fw qcom/gen80100_gmu.bin; do
        add_firmware "$firmware" || warning "Qualcomm Adreno GPU firmware unavailable: $firmware"
    done
    add_runscript
}

help() {
    echo 'Start the Qualcomm firmware owner before the live-medium search.'
}
