#!/bin/bash
#
# Try Omarchy: the hardware setup an install runs for this machine, run here,
# on the machine itself, once at the start of a Try session:
#
#   --system  omarchy-try-hardware.service, beside the desktop's start
#   --user    omarchy-try-hardware-user.service, before the desktop
#
# An install runs Omarchy's omarchy-apply-hardware in the new system
# (omarchy-apply-system), which detects the machine and adds what it needs:
# packages from the stick's offline repository, their services, udev rules,
# module and kernel options. The same entry point runs here (--system), so a
# hardware step Omarchy adds works in Try with nothing added here. The
# per-user hardware steps, as install/user/all.sh lists them, run for the
# session's user before it logs in (--user): they write settings the session
# reads at its start, and need no hardware package.
#
# The system part does not hold the desktop up: its detection alone takes
# seconds, and pacman's ldconfig after a package reads every library from the
# stick. The units it enables start when it is done.
#
# Try keeps the kernel and boot image it started with: a step that builds a
# boot image or a kernel module, or installs a kernel, could take effect only
# after a reboot, which leaves Try. Those tools do nothing here, and those
# packages are recorded without their files (live-bin/). What can take effect
# now is applied as a boot would apply it. Udev rules the setup brought get
# an add event for the devices each of their lines names (a boot's coldplug,
# systemd-udev-trigger, narrowed to those, as an add event runs every rule's
# RUN+= again; a line that names no device waits for the next boot). Modules
# and sysctl settings load again if the setup changed them. The units it
# enabled for the boot's targets start (not those for sleep or shutdown).
# Devices still without a driver are probed again, for firmware or board data
# the setup brought (omarchy-try-reprobe). A Wi-Fi or audio controller whose
# driver bound without it (ath12k, short of its board data) is bound again
# when firmware its own module names came, a package's file or what its hook
# wrote, once udev has settled and only while the driver still holds it:
# omarchy-try released those classes for the session to probe, before this
# ran. User units the setup brought reach the user manager by a reload once
# the session is up; pacman's hook would re-execute it under a session that is
# starting. Module options for a driver already loaded take effect only when
# it loads again, at the next boot.

set -uo pipefail

user=${OMARCHY_TRY_USER:-omarchy}
root=${OMARCHY_TRY_ROOT:-}
sysfs=${OMARCHY_SYSFS:-/sys}
omarchy_path=${OMARCHY_PATH:-/usr/share/omarchy}
lib=${OMARCHY_TRY_LIB:-/usr/local/lib/omarchy-try}
export PATH="$lib/live-bin:$omarchy_path/bin:/usr/local/sbin:/usr/local/bin:/usr/bin"

# The units the boot starts: what its targets want.
boot_units() {
  local target
  for target in sysinit basic sockets timers paths multi-user graphical; do
    ls "$root/etc/systemd/system/$target.target.wants" 2>/dev/null
  done | sort -u
}

# Each rules file, with its checksum, to tell which ones the setup brought.
rules_files() {
  local file
  for file in "$root"/etc/udev/rules.d/*.rules "$root"/usr/lib/udev/rules.d/*.rules; do
    [[ -f $file ]] && printf '%s %s\n' "$(cksum <"$file" | cut -d' ' -f1)" "$file"
  done | sort
}

# True when a udev rule line contains only GOTO=/LABEL= flow control and pure
# match comparisons (== or !=, excluding command-running PROGRAM/IMPORT keys).
is_flow_control_rule() {
  local rest=$1 has_flow=0 tok="" ch in_quote=0 escaped=0 i len=${#1}
  local -a tokens=()
  for ((i = 0; i < len; i++)); do
    ch=${rest:i:1}
    if ((escaped)); then
      tok+=$ch
      escaped=0
    elif ((in_quote)) && [[ $ch == \\ ]]; then
      tok+=$ch
      escaped=1
    elif [[ $ch == \" ]]; then
      tok+=$ch
      in_quote=$((1 - in_quote))
    elif [[ $ch == , ]] && ((!in_quote)); then
      tokens+=("$tok")
      tok=""
    else
      tok+=$ch
    fi
  done
  ((!in_quote)) || return 1
  tokens+=("$tok")
  for tok in "${tokens[@]}"; do
    [[ $tok =~ ^[[:space:]]*$ ]] && continue
    if [[ $tok =~ ^[[:space:]]*(GOTO|LABEL)[[:space:]]*=[[:space:]]*\"[^\"]+\"[[:space:]]*$ ]]; then
      has_flow=1
    elif [[ $tok =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)(\{[^}]+\})?[[:space:]]*(==|!=)[[:space:]]*[ie]?\"[^\"]*\"[[:space:]]*$ ]]; then
      case ${BASH_REMATCH[1]} in
        PROGRAM | IMPORT) return 1 ;;
      esac
    else
      return 1
    fi
  done
  ((has_flow))
}

# An add event for the devices a rules file's lines name, by SUBSYSTEM== and
# KERNEL==, one trigger per line, as udevadm's matches for one call combine
# across lines. Only lines an add event reaches: no ACTION==, or one that lists
# add. A line that names no device could match any, and everything is never
# triggered: it waits for the next boot, and the log says so.
replay_add() {
  local line buf="" subsystem kernel vendor product name key status=0
  local -a args
  local -A seen=()
  while IFS= read -r line || [[ -n $line || -n $buf ]]; do
    if [[ -z $buf && $line =~ ^[[:space:]]*(#|$) ]]; then
      continue
    fi
    if [[ $line == *\\ ]]; then
      buf+="${line%\\} "
      continue
    fi
    line="$buf$line"
    buf=""
    [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
    if [[ $line =~ (^|[[:space:],])ACTION==\"([^\"]+)\" ]]; then
      [[ "|${BASH_REMATCH[2]}|" == *"|add|"* ]] || continue
    fi
    subsystem="" kernel="" vendor="" product=""
    [[ $line =~ (^|[[:space:],])SUBSYSTEM==\"([^\"]+)\" ]] && subsystem=${BASH_REMATCH[2]}
    [[ $line =~ (^|[[:space:],])KERNEL==\"([^\"]+)\" ]] && kernel=${BASH_REMATCH[2]}
    [[ $line =~ (^|[[:space:],])ATTR\{idVendor\}==\"([^\"]+)\" ]] && vendor=${BASH_REMATCH[2]}
    [[ $line =~ (^|[[:space:],])ATTR\{idProduct\}==\"([^\"]+)\" ]] && product=${BASH_REMATCH[2]}
    # Pure flow-control lines (LABEL="..." or match-only ... GOTO="...") apply
    # no device setting on their own; the device rules inside the jump target
    # are replayed individually below.
    if is_flow_control_rule "$line"; then
      continue
    fi
    if [[ -z $subsystem && -z $kernel ]]; then
      echo "Try Omarchy: a rule in ${1##*/} names no device by SUBSYSTEM or KERNEL; it applies at the next boot" >&2
      continue
    fi
    args=()
    for name in ${subsystem//|/ }; do args+=("--subsystem-match=$name"); done
    for name in ${kernel//|/ }; do args+=("--sysname-match=$name"); done
    for name in ${vendor//|/ }; do args+=("--attr-match=idVendor=$name"); done
    for name in ${product//|/ }; do args+=("--attr-match=idProduct=$name"); done
    key="${args[*]}"
    [[ -n ${seen[$key]+x} ]] && continue
    seen[$key]=1
    udevadm trigger --action=add "${args[@]}" || status=1
  done <"$1"
  return "$status"
}

# The firmware a module names (modinfo, whose names can be globs), and the
# modules it builds on name: ath12k's PCI driver (ath12k_wifi7) names none
# itself, its core module ath12k does.
module_firmware() {
  local dep
  modinfo -F firmware "$1" 2>/dev/null
  for dep in $(modinfo -F depends "$1" 2>/dev/null | tr ',' ' '); do
    modinfo -F firmware "$dep" 2>/dev/null
  done
}

# Bind a device's driver again when firmware its module names is among what
# came, and only while the driver holds it.
rebind_for_firmware() {
  local device=$1 module wanted path driver
  shift
  [[ -e $device/driver/module ]] || return 0
  driver=$(readlink -f "$device/driver")
  module=$(basename "$(readlink -f "$driver/module")")
  while IFS= read -r wanted; do
    [[ -n $wanted ]] || continue
    for path in "$@"; do
      # shellcheck disable=SC2053 # the module's names are globs
      [[ $path == $wanted ]] || continue
      # Only while the driver whose firmware this is still holds it.
      [[ $(readlink -f "$device/driver") == "$driver" ]] || return 0
      printf '%s' "${device##*/}" >"$driver/unbind" && printf '%s' "${device##*/}" >"$driver/bind"
      return
    done
  done < <(module_firmware "$module")
}

# The names and contents of everything under each directory, to tell what the
# setup changed there: a file it added counts even when empty, and so does a
# drop-in.
digest() {
  local dir file
  for dir in "$@"; do
    while IFS= read -r -d '' file; do
      printf '%s\n' "${file#"$root"}"
      [[ -f $file ]] && cat "$file"
    done < <(find "$root$dir" -mindepth 1 -print0 2>/dev/null | sort -z)
  done | cksum
}

system_setup() {
  local status=0 units_before rules_before modules_before sysctl_before user_units_before audio_cfg_before user_units_changed=0 audio_cfg_changed=0 started device stamp file waited up release i name
  local -a firmware=()
  local -a rules_added=()

  stamp=$(mktemp)
  units_before=$(boot_units)
  rules_before=$(rules_files)
  modules_before=$(digest /etc/modules-load.d /usr/lib/modules-load.d)
  sysctl_before=$(digest /etc/sysctl.d /usr/lib/sysctl.d)
  user_units_before=$(digest /etc/systemd/user /usr/lib/systemd/user)
  audio_cfg_before=$(digest /usr/share/alsa/ucm2 /etc/wireplumber /usr/share/wireplumber /etc/pipewire /usr/share/pipewire)

  # Force-refresh the offline repository's database: recompress-offline-mirror.sh
  # updates offline.db.tar.gz in the staged mirror while build-try-layer.sh may
  # have written an older-content sync/offline.db with a newer mtime, so a
  # single -Sy can skip refreshing it and fail package checksum verification.
  pacman -Syy --noconfirm >/dev/null || status=1
  omarchy-apply-hardware --install-user "$user" || status=1

  systemctl daemon-reload || status=1
  mapfile -t rules_added < <(comm -13 <(printf '%s\n' "$rules_before") <(rules_files) | cut -d' ' -f2-)
  if ((${#rules_added[@]})); then
    udevadm control --reload || status=1
    for file in "${rules_added[@]}"; do
      replay_add "$file" || status=1
    done
    udevadm settle --timeout=30 || status=1
  fi
  if [[ $(digest /etc/modules-load.d /usr/lib/modules-load.d) != "$modules_before" ]]; then
    systemctl restart systemd-modules-load.service || status=1
  fi
  if [[ $(digest /etc/sysctl.d /usr/lib/sysctl.d) != "$sysctl_before" ]]; then
    systemctl restart systemd-sysctl.service || status=1
  fi
  mapfile -t started < <(comm -13 <(printf '%s\n' "$units_before") <(boot_units) | grep -E '\.(service|socket|timer|path)$')
  if ((${#started[@]})); then
    systemctl start --no-block "${started[@]}" || status=1
  fi
  "$lib/omarchy-try-reprobe" || status=1

  # What came under /usr/lib/firmware, by the name a module asks for: the
  # kernel looks in updates/ and in its release's folder first, and takes a
  # compressed file too. By ctime, as pacman keeps each file's archive mtime.
  release=$(uname -r)
  mapfile -t firmware < <(cd "$root/usr/lib/firmware" 2>/dev/null &&
    find . -cnewer "$stamp" \( -type f -o -type l \) -printf '%P\n')
  for i in "${!firmware[@]}"; do
    name=${firmware[i]#updates/}
    name=${name#"$release"/}
    name=${name%.zst}
    firmware[i]=${name%.xz}
  done
  if ((${#firmware[@]})); then
    # A controller taken away while udev still works on it can fail its probe.
    if udevadm settle --timeout=30; then
      for device in "$sysfs"/bus/pci/devices/*; do
        [[ -e $device/driver && -r $device/class ]] || continue
        case $(<"$device/class") in
          0x0280* | 0x0401* | 0x0403*) rebind_for_firmware "$device" "${firmware[@]}" || status=1 ;;
        esac
      done
    else
      status=1
    fi
  fi
  rm -f "$stamp"

  [[ $(digest /etc/systemd/user /usr/lib/systemd/user) != "$user_units_before" ]] && user_units_changed=1
  [[ $(digest /usr/share/alsa/ucm2 /etc/wireplumber /usr/share/wireplumber /etc/pipewire /usr/share/pipewire) != "$audio_cfg_before" ]] && audio_cfg_changed=1
  if ((user_units_changed || audio_cfg_changed)); then
    up=false
    for ((waited = 0; waited <= 300; waited += 2)); do
      if systemctl --user -M "$user@" is-active -q graphical-session.target; then
        up=true
        break
      fi
      if ((!user_units_changed)) && (systemctl --user -M "$user@" is-active -q wireplumber.service 2>/dev/null ||
        systemctl --user -M "$user@" is-active -q pipewire.service 2>/dev/null); then
        up=true
        break
      fi
      sleep 2
    done
    if $up; then
      if ((user_units_changed)); then
        systemctl --user -M "$user@" daemon-reload || status=1
      fi
      if ((audio_cfg_changed)); then
        systemctl --user -M "$user@" try-restart pipewire.service wireplumber.service || status=1
      fi
    else
      echo "Try Omarchy: no session for $user yet; its user manager reads the new user config when it starts"
    fi
  fi
  return "$status"
}

user_setup() {
  local status=0 step home
  home=$(getent passwd "$user" | cut -d: -f6)
  while IFS= read -r step; do
    runuser -u "$user" -- env HOME="$home" USER="$user" LOGNAME="$user" \
      OMARCHY_PATH="$omarchy_path" OMARCHY_INSTALL="$omarchy_path/install" PATH="$PATH" \
      bash "$omarchy_path/install/$step" || status=1
  done < <(grep -oE 'user/hardware/[A-Za-z0-9_./-]+\.sh' "$omarchy_path/install/user/all.sh")
  return "$status"
}

case ${1:-} in
--system) system_setup ;;
--user) user_setup ;;
*)
  echo "Usage: omarchy-try-hardware --system|--user" >&2
  exit 2
  ;;
esac
