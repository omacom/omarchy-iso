#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-only
# The live initramfs's block hook: mkinitcpio's own (install/block of
# mkinitcpio 42.2, by the same name so it takes its place in HOOKS) with the
# server storage controllers filtered out. The live initramfs only has to find
# the install medium (USB, SATA or NVMe, SD card, optical drive, VM disk), and
# every byte of it is read by the firmware before the kernel starts: 1.4 s for
# 27 MB on a ThinkPad X200's USB 2.0 port. test/unit/initramfs-hooks-test.sh
# diffs this against mkinitcpio's copy, so an upstream change shows up.

build() {
    map add_module 'ahci?' 'sd_mod?' 'usb_storage?' 'uas?' 'mmc_block?' 'nvme?' 'virtio_scsi?' 'virtio_blk?'

    # pata, sata, scsi, nvme
    # Not the server storage controllers (Fibre Channel, iSCSI, SAS and SCSI RAID
    # HBAs and their target modes, 6.4 MB with 1.2 MB of firmware), SAN
    # multipath handlers, tape, changer and PCMCIA SCSI drivers, the network
    # and RAM block devices (Ceph, DRBD, ATA over Ethernet, RDMA, zram,
    # floppy, test devices), NVMe over fabrics or the NVMe target side: an
    # install medium is never on one, a server's virtual media are USB, and
    # the live root has them all. nbd comes from the PXE hook that needs it,
    # and what the VM controllers kept here need (scsi_transport_fc, _sas,
    # _spi) comes in as their dependencies.
    add_checked_modules -f '/(lpfc|qla2xxx|qla4xxx|qla1280|bfa|efct|fnic|snic|mpt3sas|mpi3mr|megaraid[_a-z]*|aacraid|hpsa|smartpqi|be2iscsi|bnx2fc|bnx2i|cxgb3i|cxgb4i|libcxgbi|csiostor|qedi|qedf|isci|pm80xx|mvsas|mvumi|arcmsr|esas2r|3w-[_a-z0-9]+|hptiop|stex|ipr|pmcraid|myrb|myrs|dc395x|initio|a100u2w|advansys|aic7xxx|aic79xx|aic94xx|BusLogic|fdomain[_a-z]*|wd719x|dmx3191d|am53c974|atp870u|imm|ppa|ses|libfc|fcoe|libfcoe|libiscsi[_a-z]*|iscsi_tcp|iscsi_boot_sysfs|scsi_transport_iscsi|scsi_transport_srp|qlogicfas408|sym53c8xx|nsp32|hisi_sas[_a-z]*|ips|esp_scsi|libsas|tcm_[_a-z0-9]+|target_core_[_a-z]+|scsi_dh_[_a-z]+|scsi_debug|st|ch|[_a-z0-9]+_cs|floppy|brd|nbd|rbd|ublk_drv|zloop|aoe|drbd|null_blk|rnbd-client|rnbd-server|xen-blkback|zram|nvme-rdma|nvme-tcp|nvme-fc|nvme-fabrics|nvmet[-_a-z]*|nvme-loop|nvme-fcloop)\.ko' '/(block|ata|scsi|fusion|nvme)/'

    # usb
    add_checked_modules -f '(_cs|sl811_hcd|isp116x_hcd)' '/usb/host'
    add_checked_modules '/drivers/usb/storage/'

    # firewire
    add_checked_modules '/drivers/firewire/'

    # mmc
    add_checked_modules '/(drivers/mmc|tifm_)'

    # spi (mmc in spi mode)
    add_checked_modules '/drivers/spi/'

    # regulator (for mmc)
    add_checked_modules '/drivers/regulator/'

    # virtio
    # Not the virtio devices that are no disk (network, sound, Bluetooth,
    # vsock, GPU, memory, crypto and the rest); a VM's disks are virtio_blk
    # and virtio_scsi, built in, reached through virtio_mmio or behind
    # virtio-iommu, and its keyboard virtio_input, all kept.
    add_checked_modules -f '/(9pnet_virtio|vmw_vsock_virtio_transport[_a-z]*|virtio_snd|virtio_bt|gpio-virtio|virtio_net|nd_virtio|virtio_pmem|spi-virtio|virtio_rpmsg_bus|virtio_balloon|virtio_mem|virtio_rtc|virtio_vdpa|vp_vdpa|virtio-rng|virtio_crypto|i2c-virtio|virtio_can|virtio-gpu|virtio_dma_buf|virtio-vfio-pci)\.ko' 'virtio'

    # nvdimm
    add_checked_modules '/drivers/nvdimm/'

    # pci controller
    add_checked_modules '/drivers/pci/controller/'

    # low-level drivers for certain pci/usb controllers
    add_checked_modules '/drivers/mfd/'
    add_checked_modules '/drivers/clk/'
    add_checked_modules '/drivers/phy/'

    # ufs
    add_checked_modules '/drivers/ufs/'
}

help() {
    cat <<HELPEOF
This hook loads the necessary modules for most block devices using pata, sata,
scsi, firewire, usb, or mmc. Detection will take place at runtime. To minimize
the modules in the image, add the autodetect hook too.
HELPEOF
}

