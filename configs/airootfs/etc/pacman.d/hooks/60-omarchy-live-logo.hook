# The Omarchy logo for the console (omarchy-console-logo): the greeter's and
# a copy fitted to the 80-column text console, for the live initramfs hook
# that prints it as the boot's first act (etc/initcpio/hooks/omarchy-logo),
# for omarchy-console-logo-redraw and for the configurator. A pacman hook
# rather than a step in customize_airootfs.sh because the live initramfs is
# built by mkinitcpio's hook (90-) during the pacstrap, before that script
# runs; this one sorts first and writes the files ahead of it.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/share/omarchy/logo.txt

[Action]
Description = Fitting the Omarchy logo to the 80-column console...
When = PostTransaction
Exec = /usr/bin/bash /usr/local/bin/omarchy-console-logo
