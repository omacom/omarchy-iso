#!/bin/sh
#
# systemd generator: whether omarchy-luks-calibrate.service waits for the
# boot-time hashes of the install medium.
#
# The calibration is an Argon2id benchmark on 4 threads, and its result sets
# the cost of the disk password for the life of the install. Measured beside
# a running sha256sum (iterations for 2 s; cryptsetup 2.8.8, Zen 4, pinned):
#
#   2 cores / 4 threads   11 alone,  8 beside the hash
#   4 cores / 4 threads   15 alone, 10-11 beside the hash
#   4 cores / 8 threads   15-16 alone, 12 beside the hash
#   6 cores / 6 threads   13-15 alone, 15 beside the hash
#   8 cores / 8 threads   15 alone, 15 beside the hash
#
# and the hash's priority changes nothing (nice 19 and SCHED_IDLE measure the
# same). So with fewer than 6 cores the calibration runs after the hashes,
# alone; with 6 or more it runs beside them, and its result is ready when an
# install starts before the hashes end (an unattended install, or a wizard
# answered faster than a USB stick is read), where the format otherwise runs
# the same benchmark itself, 8 s on the install's clock.
#
# Cores, not threads: each core's thread_siblings_list names all its threads.
# An unreadable topology counts 0 cores and waits, the cautious way round.

cores=$(cat "${OMARCHY_SYSFS:-/sys}"/devices/system/cpu/cpu[0-9]*/topology/thread_siblings_list 2>/dev/null | sort -u | wc -l)
if [ "$cores" -lt 6 ]; then
  mkdir -p "$1/omarchy-luks-calibrate.service.d"
  printf '[Unit]\nAfter=omarchy-mirror-verify.service omarchy-root-image-verify.service\n' \
    >"$1/omarchy-luks-calibrate.service.d/after-the-hashes.conf"
fi
