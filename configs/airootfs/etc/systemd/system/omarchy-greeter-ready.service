[Unit]
Description=Wait for the installer greeter before starting live background warmup
Before=omarchy-luks-calibrate.service omarchy-mirror-verify.service omarchy-root-image-verify.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/omarchy-wait-greeter-ready

[Install]
WantedBy=multi-user.target
