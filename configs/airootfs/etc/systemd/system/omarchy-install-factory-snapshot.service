[Unit]
Description=Create the factory snapshot of the install target
# The terminal phase of the graph: join the keyring unit (systemd state,
# readable from any process), then snapshot @ as the factory baseline. Its
# stage mount (factory-top) is a systemd-mount transient, PartOf= the
# install target, so a mid-phase death unmounts it with the group
# teardown.
PartOf=omarchy-install.target
After=omarchy-install-validate-boot.service omarchy-target-keyring.service
Requires=omarchy-install-validate-boot.service

[Service]
Type=oneshot
# Latched: the dashboard reads the graph itself as install state -- active
# means done, inactive means pending, and the timestamps survive for the
# timing record. NotifyAccess lets any process in the phase publish
# sd_notify STATUS= progress.
RemainAfterExit=yes
NotifyAccess=all
EnvironmentFile=/usr/share/omarchy-iso/orchestrator/context.env
EnvironmentFile=-/run/omarchy-install/context.env
EnvironmentFile=-/run/omarchy-install/install.env
ExecStart=/usr/share/omarchy-iso/orchestrator/run-phase create_factory_snapshot "Creating factory snapshot"
# The keyring join is bounded by that unit's own 60 s; the snapshot itself
# is CoW-instant. Ten minutes is a stuck guard.
TimeoutStartSec=600
