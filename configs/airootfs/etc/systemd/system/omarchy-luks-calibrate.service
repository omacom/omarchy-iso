[Unit]
Description=Calibrate LUKS Argon2id while the installer wizard is open
# No installer unit depends on this optional result; an install that starts
# before it is done cancels it and uses cryptsetup's ordinary calibration
# instead. On a machine with fewer than 6 cores the benchmark must not share
# them with the boot-time hashes of the medium: there
# system-generators/omarchy-luks-calibrate-order orders this unit after them.
ConditionPathExists=/run/archiso/bootmnt

[Service]
Type=exec
ExecStart=/usr/local/bin/omarchy-luks-calibrate calibrate
RuntimeDirectory=omarchy-luks-calibration
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
TimeoutStopSec=2
# CPU/RAM only: the benchmark must not access the host's disks.
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
