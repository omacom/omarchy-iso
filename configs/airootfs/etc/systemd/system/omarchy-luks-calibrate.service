[Unit]
Description=Calibrate LUKS Argon2id while the installer wizard is open
# Run immediately after the live greeter draws, before the medium-hashing units
# or early target keyring start: calibration takes ~2 s of CPU/RAM and must
# measure on an idle machine (sharing CPUs with hashing or gpg measures low and
# under-costs the disk passphrase; running before the multi-GB verify reads also
# keeps page cache clean). Type=oneshot (without RemainAfterExit) holds the
# downstream After= units until calibration exits and still transitions to
# inactive on completion. No installer unit depends on this optional result; an
# install that reaches its format while the benchmark runs waits for it
# (luks_calibration.stop_calibration), and one it does not finish for uses
# cryptsetup's ordinary calibration instead.
After=omarchy-greeter-ready.service
Before=omarchy-mirror-verify.service omarchy-root-image-verify.service
ConditionPathExists=/run/archiso/bootmnt
ConditionPathExists=!/run/omarchy-iso/skip-luks-calibrate

[Service]
Type=oneshot
ExecStart=/usr/local/bin/omarchy-luks-calibrate calibrate
RuntimeDirectory=omarchy-luks-calibration
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
TimeoutStartSec=60
TimeoutStopSec=2
# CPU/RAM only: the benchmark must not access the host's disks.
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
