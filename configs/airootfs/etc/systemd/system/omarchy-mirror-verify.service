[Unit]
Description=Verify the offline package mirror on the install medium
# The per-machine packages an install pacstraps (kernel, microcode, GPU and
# firmware packages) come from this mirror, read off the medium like the root
# image. Hashing them here, before the wait helper lets anything format a disk,
# turns a corrupt one into a refused install instead of a pacman error on a
# wiped disk. Before the root image hash, never beside it: two readers on one
# USB stick seek against each other, and the image must be the last thing read
# before the install writes it, or on a machine whose RAM cannot hold both this
# hash evicts the image pages the write would reuse (30 MiB/s, 4 GB: 8190 MiB
# read off the medium with the mirror second, against 5598 without it).
Before=omarchy-root-image-verify.service
ConditionPathExists=/usr/share/omarchy-iso/offline-mirror.sha256

[Service]
Type=oneshot
RemainAfterExit=yes
# TimeoutStartSec comes from a build-time drop-in sized to the mirror, as for
# the root image (build-iso.sh writes 50-size-timeout.conf next to this unit).
WorkingDirectory=/var/cache/omarchy/mirror/offline
ExecStart=/usr/bin/sha256sum --check --strict --quiet /usr/share/omarchy-iso/offline-mirror.sha256
# Background work: never compete with the console or anything interactive.
Nice=19
IOSchedulingClass=idle
# The idle class is lost on this hash: the mirror sits in the airootfs, so
# its reads reach the stick through the loop device, which issues them at
# its own priority, and the boot's reads of every binary it execs queue
# behind them. On the usb2 boot benchmark (40 MB/s, UEFI) the greeter
# showed at 35.6 s after power-on, 541 MB off the stick between kernel
# start and the greeter against the boot's own 154 MB; with this hash
# alone the same 35.6 s, with the root image's (direct reads, idle class
# honored) alone 29.6 s, with neither 27.2 s. With the io controller on,
# BFQ schedules by cgroup and weighs this unit's share against each of
# the boot's units: the greeter at 28.3 s, userspace to greeter 6.6 s
# instead of 14.2 s. IOWeight=1 on top gained nothing more.
IOAccounting=yes

[Install]
WantedBy=omarchy-medium-verify.target
