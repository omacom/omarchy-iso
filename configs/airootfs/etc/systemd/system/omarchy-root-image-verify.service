[Unit]
Description=Verify the Omarchy root image on the install medium
# The root image and its checksum are plain files on the ISO, which the archiso
# initramfs mounts before pivoting, so they are there from the first unit on.
# Starting the hash once the installer is on screen (omarchy-medium-verify.target),
# rather than when the install begins, hides the read of a multi-GB stream
# behind the time the user spends in the configurator; not at boot, where it
# would slow the boot's own reads off the same medium.
# This is the only verifier: the orchestrator's prepare_install_target phase
# collects the verdict, waits for the unit if it is still running, and fails
# the install if it could not run.
# One architecture's directory per ISO (arch/x86_64 or arch/aarch64).
ConditionPathExistsGlob=/run/archiso/bootmnt/arch/*/omarchy-root.img.zst
ConditionPathExistsGlob=/run/archiso/bootmnt/arch/*/omarchy-root.img.zst.sha256

[Service]
Type=oneshot
RemainAfterExit=yes
# TimeoutStartSec comes from a build-time drop-in sized to the image
# (build-iso.sh writes 50-size-timeout.conf next to this unit): oneshot units
# have no default start timeout, and a medium that stalls reads instead of
# erroring would otherwise hang the hash, and the install waiting on it,
# forever. On timeout Result=timeout tells the wait helper to report a slow
# medium rather than a corrupt one.
# exec keeps sha256sum the unit's MainPID, whose read offset on the stream
# omarchy-wait-root-image-verify reports as progress. $$ is a literal $.
ExecStart=/bin/sh -c 'cd "/run/archiso/bootmnt/arch/$$(uname -m)" && exec /usr/bin/sha256sum --check --strict omarchy-root.img.zst.sha256'
# Background work: never compete with the console or anything interactive.
Nice=19
IOSchedulingClass=idle
# Group scheduling for the reason given in omarchy-mirror-verify.service:
# the boot reads the stick beside this hash too, and on fast media the
# mirror is done before the greeter and this one streams in its place.
IOAccounting=yes

[Install]
WantedBy=omarchy-medium-verify.target
