#!/usr/bin/env bash
# Foreground Omarchy ISO install UI supervisor.
#
# This process is the only owner of the visible install UI. It launches the
# actual installer as a non-interactive child, sends child output to the support
# log, renders progress while the child runs, then renders the final installed
# time + reboot prompt itself. There is deliberately no background dashboard.
set -euo pipefail

usage() {
  echo "Usage: $0 <log-file> -- <installer command...>" >&2
  exit 2
}

(( $# >= 3 )) || usage
LOG_FILE="$1"
shift 1
[[ ${1:-} == "--" ]] || usage
shift
(( $# > 0 )) || usage
INSTALL_CMD=("$@")

TTY_PATH="${OMARCHY_DASHBOARD_TTY:-/dev/tty}"
LOGO_PATH="${OMARCHY_PATH:-/usr/share/omarchy}/logo.txt"

# Autoinstall has no one at the keyboard, and every prompt this dashboard owns
# reads from the TTY, so each would hang forever. Suppress them here rather than
# in the scripts they live in: this process is the only owner of the visible UI.
interactive() { [[ ${OMARCHY_UI_INTERACTIVE:-} != "no" ]]; }

CSI=$'\033['
RESET="${CSI}0m"
DIM="${CSI}2m"
HIDE_CURSOR="${CSI}?25l"
SHOW_CURSOR="${CSI}?25h"
CLEAR="${CSI}2J${CSI}H"
CLEAR_LINE="${CSI}2K"
CLEAR_TO_END="${CSI}J"
GREEN="${CSI}32m"
WHITE="${CSI}37m"
RED="${CSI}31m"
DARK="${CSI}90m"

# The dashboard owns the final reboot prompt now, so keep the gum confirm
# styling that used to come from install/helpers/presentation.sh.
export GUM_CONFIRM_PROMPT_FOREGROUND="${GUM_CONFIRM_PROMPT_FOREGROUND:-6}"
export GUM_CONFIRM_SELECTED_FOREGROUND="${GUM_CONFIRM_SELECTED_FOREGROUND:-0}"
export GUM_CONFIRM_SELECTED_BACKGROUND="${GUM_CONFIRM_SELECTED_BACKGROUND:-2}"
export GUM_CONFIRM_UNSELECTED_FOREGROUND="${GUM_CONFIRM_UNSELECTED_FOREGROUND:-7}"
export GUM_CONFIRM_UNSELECTED_BACKGROUND="${GUM_CONFIRM_UNSELECTED_BACKGROUND:-0}"

child_pid=""
child_pgid=""

tips=(
  "Super + Space opens the Omarchy menu for apps, settings, and more"
  "Super + K shows all the key bindings"
  "Super is the Windows or command key on your keyboard"
  "Use Xournal++ to sign PDFs"
  "Share files with phones and laptops using LocalSend"
  "Turn any website into an app with Install > Web App in the menu"
  "Super + Return opens a terminal, Super + Shift + Return the browser"
  "Edit images with Pinta, videos with Kdenlive, docs with LibreOffice"
  "Super + Ctrl + Print grabs text off the screen with OCR"
  "Print takes a screenshot, Alt + Print records the screen"
  "Set a reminder with Super + Ctrl + R"
  "Switch themes from Style > Theme in the Omarchy menu"
  "Double-click the menu bar to make it transparent"
  "Run a full Windows VM via Install > Windows in the menu"
  "Super + Ctrl + V opens the clipboard manager"
  "Super + 1 through 0 switches workspaces, add Shift to bring the window"
  "Super + Print picks a color from anywhere on screen"
  "Keep the system fresh with Update in the Omarchy menu"
)

cleanup() {
  printf '%s%s' "$RESET" "$SHOW_CURSOR" >"$TTY_PATH" 2>/dev/null || true
}

dashboard_log() {
  printf '[dashboard] %s\n' "$*" >>"$LOG_FILE" 2>/dev/null || true
}

stop_child() {
  [[ -n ${child_pid:-} ]] || return 0
  if kill -0 "$child_pid" 2>/dev/null; then
    if [[ -n ${child_pgid:-} ]]; then
      kill -- -"$child_pgid" 2>/dev/null || true
    fi
    kill "$child_pid" 2>/dev/null || true
    for _ in {1..20}; do
      kill -0 "$child_pid" 2>/dev/null || break
      sleep 0.05
    done
    if kill -0 "$child_pid" 2>/dev/null; then
      [[ -n ${child_pgid:-} ]] && kill -9 -- -"$child_pgid" 2>/dev/null || true
      kill -9 "$child_pid" 2>/dev/null || true
    fi
  fi
  wait "$child_pid" 2>/dev/null || true
}

interrupt() {
  local code="$1"
  stop_child
  cleanup
  exit "$code"
}

trap cleanup EXIT
trap 'interrupt 130' INT
trap 'interrupt 143' TERM

term_size() { stty size 2>/dev/null <"$TTY_PATH" || printf '24 80\n'; }
term_cols() { local size; size="$(term_size)"; printf '%s\n' "${size#* }"; }

repeat() {
  local char="$1" count="$2" out="" i
  for ((i=0; i<count; i++)); do out+="$char"; done
  printf '%s' "$out"
}

logo_width() {
  if [[ -f $LOGO_PATH ]]; then
    # The logo is drawn in box-drawing glyphs, three bytes each in UTF-8, so
    # awk's `length` returns 197 rather than 81 unless the locale happens to be
    # UTF-8 — and a width wider than the console makes left_padding clamp to
    # zero, which puts the logo flush left. Count bytes deliberately (LC_ALL=C)
    # and drop the continuation bytes instead, so the answer is columns in every
    # locale rather than only in the ones that have a charset.
    LC_ALL=C awk '
      { gsub(/[\200-\277]/, ""); if (length > max) max = length }
      END { print max+0 }
    ' "$LOGO_PATH"
  else
    printf '81\n'
  fi
}

logo_height() {
  if [[ -f $LOGO_PATH ]]; then
    wc -l <"$LOGO_PATH"
  else
    printf '1\n'
  fi
}

LOGO_WIDTH="$(logo_width)"
LOGO_HEIGHT="$(logo_height)"
(( LOGO_WIDTH > 0 )) || LOGO_WIDTH=81
(( LOGO_HEIGHT > 0 )) || LOGO_HEIGHT=1
CONTENT_WIDTH="$LOGO_WIDTH"
# Rows the progress screen occupies: logo, blank, title, blank, bar, blank, tip.
PROGRESS_HEIGHT=$((LOGO_HEIGHT + 6))
TOP_ROW=1
DYNAMIC_ROW=$((LOGO_HEIGHT + 3))
LAST_SIZE=""
LAST_PM=10
# The finish screen mirrors the greeter's frame — logo, blank, one line, gap,
# one button — so the last thing the installer shows matches the first. It runs
# one row taller: `gum confirm` always paints prompt/blank/button and clears all
# three, so the button cannot sit closer than two rows under a title we drew.
# Two more rows between title and button: a blank and the medium-removal
# note — above the prompt, because gum clears everything under its view.
FINISH_HEIGHT=$((LOGO_HEIGHT + 7))
FINISH_TOP_ROW=2

# ── Install progress ─────────────────────────────────────────────────────────
#
# Position = 10 + 990 * acc / total-weight, acc summed per unit: a latched
# unit contributes its full weight, an activating one its credit -- whichever
# of these is further:
#
#   floor  (weight-1) * t / (t+tau), on time since this process saw the
#          phase start. Asymptotic, so it approaches the weight's cap
#          without reaching it. tau is a shape constant, not a prediction.
#   work   packages installed / PKG_TOTAL for the package phase (libalpm
#          makes one directory per package under <target>/var/lib/pacman/
#          local; the denominator comes from build-iso.sh, so there is no
#          second list to drift), or the unit's own sd_notify
#          "progress=<fraction>" for a self-measuring phase (the unpack).
#
# Weights, not bands: in a fanned graph several phases run at once and each
# contributes its credit in the same frame -- the bar honestly speeds up.
# On a linear graph exactly one term is partial and the sum walks the old
# band table. Per-mille because a whole-percent asymptote over a two-point
# share has two reachable values and stops moving; the monotone POS clamp
# is a guard, since the sum itself never decreases.
EXPECTED_PACKAGES_FILE="${OMARCHY_EXPECTED_PACKAGES_FILE:-/usr/share/omarchy-iso/expected-packages}"
PKG_TOTAL=0
if [[ -r $EXPECTED_PACKAGES_FILE ]]; then
  read -r PKG_TOTAL _ <"$EXPECTED_PACKAGES_FILE" 2>/dev/null || PKG_TOTAL=0
fi
[[ $PKG_TOTAL =~ ^[0-9]+$ ]] || PKG_TOTAL=0
# A wrong denominator is worse than none: it never triggers the fallback.
(( PKG_TOTAL < 300 || PKG_TOTAL > 5000 )) && PKG_TOTAL=0

PKG_BONUS_MAX_PM=100   # cap on how far the bar may run ahead of the count
PKG_TAIL_PM=40         # band held back so a stalled bar has somewhere to go
PKG_FLOOR_TAU=900      # with a work signal, time is only a backstop until the
                       # first package, so slow it until it cannot outrun data

POS=10                 # position, per-mille, monotonic
PROGRESS_PM=10
VERIFY_PCT=-1          # honest percent of the pre-flight verify, -1 when idle
NOW=0                  # monotonic seconds, refreshed once per frame
DASH_T0=0

# ── Phase state: the systemd unit graph ──────────────────────────────────────
#
# The phase units latch (RemainAfterExit=yes), so the graph itself is the
# install's state and systemd's records are the only copy: active means done,
# activating means running, failed means failed, and a self-measuring phase
# publishes its fraction as the unit's sd_notify STATUS=. One `systemctl
# show` over the roster per frame reads all of it. The roster and the
# display names come from the unit files (a phase unit is exactly a unit
# whose ExecStart runs run-phase; the display name is its second argument),
# ordered by walking each unit's Requires= edge back from the terminal.
UNITS_DIR="${OMARCHY_INSTALL_UNITS_DIR:-/etc/systemd/system}"
INSTALL_TARGET="${OMARCHY_INSTALL_TARGET:-/mnt}"
INSTALL_STATE_DIR="${OMARCHY_INSTALL_STATE_DIR:-/run/omarchy-install}"

PHASE_UNITS=()
PHASE_DISPLAY=()
PHASE_FN=()
# Topological, not linear: each unit may Requires= several phase units and
# the graph may fan out. Kahn's algorithm over the phase-unit subgraph,
# scanning in sorted name order, which on a linear chain reproduces the
# chain exactly and on a fan gives a stable order. A cycle cannot occur in
# a graph systemd accepted, but a broken edit degrades to name order at the
# tail rather than an empty roster.
build_phase_roster() {
  local f unit name fn line dep ready progressed remaining
  local -a all=()
  local -A display=() fns=() requires=() emitted=()
  for f in "$UNITS_DIR"/omarchy-install-*.service; do
    [[ -f $f ]] || continue
    line=$(grep -m1 -E '^ExecStart=.*run-phase ' "$f" 2>/dev/null) || continue
    unit=${f##*/}
    name=${line#*run-phase *\"}
    name=${name%%\"*}
    fn=${line#*run-phase }
    fn=${fn%% *}
    display[$unit]=$name
    fns[$unit]=$fn
    all+=("$unit")
    requires[$unit]=$(grep -E '^Requires=' "$f" 2>/dev/null |
      grep -oE 'omarchy-install-[a-z-]+\.service' | tr '\n' ' ') || requires[$unit]=""
  done
  PHASE_UNITS=()
  PHASE_DISPLAY=()
  PHASE_FN=()
  (( ${#all[@]} > 0 )) || return 0
  mapfile -t all < <(printf '%s\n' "${all[@]}" | sort)
  remaining=${#all[@]}
  while (( remaining > 0 )); do
    progressed=0
    for unit in "${all[@]}"; do
      [[ -n ${emitted[$unit]:-} ]] && continue
      ready=1
      for dep in ${requires[$unit]}; do
        # Only edges into other phase units order the roster; a Requires=
        # on a mount or helper unit is not a phase.
        [[ -n ${display[$dep]:-} && -z ${emitted[$dep]:-} ]] && { ready=0; break; }
      done
      (( ready )) || continue
      emitted[$unit]=1
      PHASE_UNITS+=("$unit")
      remaining=$((remaining - 1))
      progressed=1
    done
    (( progressed )) || break
  done
  for unit in "${all[@]}"; do
    [[ -z ${emitted[$unit]:-} ]] && PHASE_UNITS+=("$unit")
  done
  for unit in "${PHASE_UNITS[@]}"; do
    PHASE_DISPLAY+=("${display[$unit]}")
    PHASE_FN+=("${fns[$unit]}")
  done
}
build_phase_roster
PHASE_TOTAL=${#PHASE_UNITS[@]}

# Each phase's share of the bar (weights, not ranges: concurrent phases in a
# fanned graph each contribute their credit at the same time), plus tau, the
# shape constant of its time asymptote. The widths follow the measured X200
# phase times; the position is scaled by the sum, so an unknown or renamed
# phase degrades to a default share instead of a runaway or a stall.
# STARTING_W covers the pre-graph orchestrator work under the same scale.
STARTING_W=15
PHASE_W=() PHASE_TAU=() PHASE_PKG=()
PHASE_W_SUM=$STARTING_W
for _name in "${PHASE_DISPLAY[@]}"; do
  _pkg=0
  case "$_name" in
    "Preparing live environment") _w=25 _tau=25 ;;
    "Preparing install target")   _w=15 _tau=20 ;;
    "Preparing disk layout")      _w=45 _tau=20 ;;
    "Unpacking root image")       _w=410 _tau=100 ;;
    "Installing Arch + Omarchy")  _w=160 _tau=60 _pkg=1 ;;
    "Finalizing base system")     _w=20 _tau=10 ;;
    "Configuring hibernation")    _w=20 _tau=10 ;;
    "Configuring system")         _w=130 _tau=120 ;;
    "Staging provisioning")       _w=5 _tau=5 ;;
    "Finalizing Limine boot")     _w=95 _tau=90 ;;
    "Finalizing user")            _w=28 _tau=30 ;;
    "Configuring login")          _w=6 _tau=5 ;;
    "Configuring SSH access")     _w=4 _tau=5 ;;
    "Configuring Tailscale")      _w=3 _tau=5 ;;
    "Configuring DNS resolver")   _w=3 _tau=5 ;;
    "Validating boot setup")      _w=4 _tau=5 ;;
    "Creating factory snapshot")  _w=2 _tau=5 ;;
    *)                            _w=30 _tau=60 ;;
  esac
  PHASE_W+=("$_w")
  PHASE_TAU+=("$_tau")
  PHASE_PKG+=("$_pkg")
  PHASE_W_SUM=$((PHASE_W_SUM + _w))
done
unset _name _w _tau _pkg

# One poll of the graph, per-unit: PHASE_STATE[i]/PHASE_STATUS[i] for every
# roster index (several units may be activating at once in a fanned graph),
# plus the aggregates -- PHASE_DONE (latched count), PHASE_ACTIVE_N,
# PHASE_FINISHED (terminal latched), PHASE_FAILED_NAME/UNIT, and
# PHASE_CUR_NAME (an activating phase, for the failure summary).
read_phase_state() {
  PHASE_CUR_NAME="" PHASE_DONE=0 PHASE_ACTIVE_N=0 PHASE_FINISHED=0
  PHASE_FAILED_NAME="" PHASE_FAILED_UNIT=""
  PHASE_STATE=() PHASE_STATUS=()
  (( PHASE_TOTAL > 0 )) || return 0
  local line key i=0
  while IFS= read -r line; do
    if [[ -z $line ]]; then
      i=$((i + 1))
      continue
    fi
    key=${line%%=*}
    case "$key" in
      ActiveState) PHASE_STATE[i]=${line#*=} ;;
      StatusText) PHASE_STATUS[i]=${line#*=} ;;
    esac
  done < <(systemctl show "${PHASE_UNITS[@]}" -p ActiveState,StatusText 2>/dev/null)
  for ((i = 0; i < PHASE_TOTAL; i++)); do
    case "${PHASE_STATE[i]:-}" in
      active) PHASE_DONE=$((PHASE_DONE + 1)) ;;
      activating)
        PHASE_ACTIVE_N=$((PHASE_ACTIVE_N + 1))
        PHASE_CUR_NAME=${PHASE_DISPLAY[i]}
        ;;
      failed)
        PHASE_FAILED_NAME=${PHASE_DISPLAY[i]}
        PHASE_FAILED_UNIT=${PHASE_UNITS[i]}
        ;;
    esac
  done
  [[ ${PHASE_STATE[PHASE_TOTAL - 1]:-} == active ]] && PHASE_FINISHED=1
  # Between phases (the gap is milliseconds) the first pending unit stands
  # in; before the graph starts the caller's default names the pre-graph
  # orchestrator work.
  if [[ -z $PHASE_CUR_NAME ]] && (( ! PHASE_FINISHED && PHASE_DONE > 0 )); then
    for ((i = 0; i < PHASE_TOTAL; i++)); do
      [[ ${PHASE_STATE[i]:-} == active ]] && continue
      PHASE_CUR_NAME=${PHASE_DISPLAY[i]}
      break
    done
  fi
  return 0
}
declare -A PHASE_T0S=()  # NOW when each unit was first observed activating
PRE_T0=0               # NOW when the pre-graph pseudo-phase was first seen
PKG_DB_DIR=""
PKG_COUNT=0
PKG_BASE=-1            # package count when the phase started
PKG_SEEN=0             # running max of packages since PKG_BASE
PKG_LAST_CHANGE=0
PKG_BONUS=0

# Monotonic clock: tzupdate and systemd-timesyncd can step the wall clock
# mid-install, which would jump every time-driven band to its ceiling.
set_now() {
  local up rest
  if read -r up rest </proc/uptime 2>/dev/null && [[ $up == [0-9]* ]]; then
    NOW=${up%%.*}
  else
    NOW=$EPOCHSECONDS
  fi
  return 0
}

left_padding() {
  local width="${1:-$CONTENT_WIDTH}" cols pad
  cols="$(term_cols)"
  pad=$(( (cols - width) / 2 ))
  (( pad < 0 )) && pad=0
  printf '%*s' "$pad" ''
}

visible_len() {
  local text="$1"
  text="$(printf '%b' "$text" | sed -E $'s/\x1b\\[[0-9;?]*[A-Za-z]//g')"
  printf '%s' "${#text}"
}

blank_line() { printf '\r%s\n' "$CLEAR_LINE"; }

line_at() {
  local width="${1:-$CONTENT_WIDTH}" indent="${2:-0}"
  shift 2
  printf '\r%s%s%*s' "$CLEAR_LINE" "$(left_padding "$width")" "$indent" ''
  printf '%b' "$*"
}

center() {
  local text="$1" width="${2:-$CONTENT_WIDTH}" len inner_pad
  len="$(visible_len "$text")"
  inner_pad=$(( (width - len) / 2 ))
  (( inner_pad < 0 )) && inner_pad=0
  printf '\r%s%s%*s%b%s\n' "$CLEAR_LINE" "$(left_padding "$width")" "$inner_pad" '' "$text" "$RESET"
}

render_logo() {
  local pad
  pad="$(left_padding "$LOGO_WIDTH")"
  if [[ -f $LOGO_PATH ]]; then
    while IFS= read -r line; do
      printf '\r%s%s%b%s%b\n' "$CLEAR_LINE" "$pad" "$GREEN" "$line" "$RESET"
    done <"$LOGO_PATH"
  else
    center "${GREEN}Omarchy${RESET}" "$CONTENT_WIDTH"
  fi
}

progress_bar() {
  local pm="$1" width="${2:-34}" filled empty
  (( pm < 0 )) && pm=0
  (( pm > 1000 )) && pm=1000
  filled=$(( pm * width / 1000 ))
  empty=$(( width - filled ))
  printf '%s%s%s%s%s' "$WHITE" "$(repeat █ "$filled")" "$DARK" "$(repeat ░ "$empty")" "$RESET"
}

# Packages libalpm has finished installing. local/ holds one directory per
# package and nothing else in it is a directory, so */ is exact. One glob, no
# forks: this runs twice a second while the disk is saturated.
count_packages() {
  local -a entries
  PKG_COUNT=0
  [[ -n $PKG_DB_DIR ]] || return 0
  entries=("$PKG_DB_DIR"/*/)
  # Unmatched globs expand to the pattern; nullglob stays off script-wide.
  if (( ${#entries[@]} == 1 )) && [[ ! -d ${entries[0]} ]]; then
    return 0
  fi
  PKG_COUNT=${#entries[@]}
  return 0
}

# Sets PROGRESS_PM. Never call in a command substitution: POS, the phase timer
# and the package counters must survive between frames. Print nothing — output
# here would land on the TTY between the cursor escape and the bar.
install_progress() {
  local i w tau t acc pos credit work gap n progress_pm any_started

  PROGRESS_PM=$POS
  VERIFY_PCT=-1

  read_phase_state
  if (( PHASE_FINISHED )); then
    POS=1000
    PROGRESS_PM=1000
    return 0
  fi
  (( PHASE_TOTAL > 0 )) || return 0

  # Position = 10 + 990 * acc / total, acc in milli-weights: every latched
  # unit contributes its full weight, every activating unit its credit --
  # its time asymptote or its work signal, whichever is further -- capped
  # just under its weight. The latch set only grows and a finishing phase
  # trades partial credit for full weight, so the sum is monotone; on a
  # linear graph exactly one term is partial and the model reproduces the
  # old band walk, while concurrent phases each push the bar at once.
  acc=0
  any_started=$(( PHASE_DONE > 0 || PHASE_ACTIVE_N > 0 ))
  if (( any_started )); then
    acc=$((STARTING_W * 1000))
  else
    (( PRE_T0 == 0 )) && PRE_T0=$NOW
    t=$(( NOW - PRE_T0 ))
    (( t < 0 )) && t=0
    acc=$(( (STARTING_W - 1) * 1000 * t / (t + 5) ))
  fi

  for ((i = 0; i < PHASE_TOTAL; i++)); do
    w=${PHASE_W[i]}
    case "${PHASE_STATE[i]:-}" in
      active)
        acc=$(( acc + w * 1000 ))
        ;;
      activating)
        if [[ -z ${PHASE_T0S[$i]:-} ]]; then
          PHASE_T0S[$i]=$NOW
          # This process is the session log's phase-marker author now:
          # the phases themselves log to the journal alone, and the
          # support file keeps its human-readable spine.
          dashboard_log "› ${PHASE_DISPLAY[i]}"
          # The package counters belong to the one package phase; baseline
          # them the frame it first runs.
          if (( PHASE_PKG[i] )); then
            PKG_BASE=-1
            PKG_SEEN=0
            PKG_BONUS=0
            PKG_LAST_CHANGE=$NOW
          fi
        fi
        tau=${PHASE_TAU[i]}
        (( PHASE_PKG[i] && PKG_TOTAL > 0 )) && tau=$PKG_FLOOR_TAU
        t=$(( NOW - PHASE_T0S[$i] ))
        (( t < 0 )) && t=0
        credit=$(( (w - 1) * 1000 * t / (t + tau) ))

        if (( PHASE_PKG[i] && PKG_TOTAL > 0 )); then
          PKG_DB_DIR="$INSTALL_TARGET/var/lib/pacman/local"
          count_packages
          # Baseline on first sight: a target that already holds packages
          # would otherwise pin the credit at its cap for the whole phase.
          (( PKG_BASE < 0 )) && PKG_BASE=$PKG_COUNT
          n=$(( PKG_COUNT - PKG_BASE ))
          (( n < 0 )) && n=0
          # Running max: a reinstalled package briefly drops its dir.
          if (( n > PKG_SEEN )); then
            PKG_SEEN=$n
            PKG_LAST_CHANGE=$NOW
          fi
          gap=$(( NOW - PKG_LAST_CHANGE ))
          (( gap < 0 )) && gap=0
          (( gap > PKG_BONUS_MAX_PM )) && gap=$PKG_BONUS_MAX_PM
          (( gap > PKG_BONUS )) && PKG_BONUS=$gap
          work=$(( ((w - 1 - PKG_TAIL_PM) * PKG_SEEN / PKG_TOTAL + PKG_BONUS) * 1000 ))
          (( work > credit )) && credit=$work
        fi

        # A self-measuring phase publishes "progress=<fraction>" as its
        # unit's sd_notify STATUS=. The pre-flight gate's share is narrow
        # (the phase is subsecond once the boot-time hash has finished), so
        # its honest percent goes to a status line instead (render_dynamic);
        # the unpack's share is wide enough to carry its progress itself.
        if [[ ${PHASE_STATUS[i]:-} =~ progress=(1(\.0*)?|0(\.[0-9]+)?) ]]; then
          progress_pm=$(awk -v p="${BASH_REMATCH[1]}" 'BEGIN { printf "%d", p * 1000 }')
          (( progress_pm > 1000 )) && progress_pm=1000
          (( progress_pm < 0 )) && progress_pm=0
          [[ ${PHASE_DISPLAY[i]} == "Preparing install target" ]] && VERIFY_PCT=$(( progress_pm / 10 ))
          work=$(( (w - 1 - PKG_TAIL_PM) * progress_pm ))
          (( work > credit )) && credit=$work
        fi

        (( credit > (w - 1) * 1000 )) && credit=$(( (w - 1) * 1000 ))
        (( credit < 0 )) && credit=0
        acc=$(( acc + credit ))
        ;;
    esac
  done

  pos=$(( 10 + 990 * acc / (PHASE_W_SUM * 1000) ))
  (( pos > 999 )) && pos=999
  (( pos > POS )) && POS=$pos
  (( POS > 1000 )) && POS=1000
  PROGRESS_PM=$POS
  return 0
}

# One tip per 8 seconds, in order. On elapsed time, not a frame counter: a frame
# is 0.5s of sleep plus a render, which stretches under pacstrap I/O — on the
# machine where the tips, not the bar, are carrying liveness.
current_tip() {
  printf '%s' "${tips[$(( (NOW - DASH_T0) / 8 % ${#tips[@]} ))]}"
}

# Vertically center a block of the given height, echoing the row it starts on.
# Both screens here center the way the configurator's greeter centers its
# welcome, so the install opens, runs, and closes on the same composition
# rather than stacking each frame from row one.
centered_top_row() {
  local height="$1" rows top
  rows="$(term_size)"
  rows="${rows%% *}"
  [[ $rows =~ ^[0-9]+$ ]] || rows=24
  top=$(( (rows - height) / 2 ))
  (( top < 0 )) && top=0
  printf '%d' "$(( top + 1 ))"
}

measure_progress_layout() {
  LAST_SIZE="$(term_size)"
  TOP_ROW="$(centered_top_row "$PROGRESS_HEIGHT")"
  DYNAMIC_ROW=$(( TOP_ROW + LOGO_HEIGHT + 1 ))
}

render_static() {
  measure_progress_layout
  printf '%s%s%d;1H' "$CLEAR" "$CSI" "$TOP_ROW"
  render_logo
  blank_line
}

render_dynamic() {
  local pm
  # The console can still resize under us (the framebuffer settles late in VMs).
  # Horizontal padding is recomputed every frame anyway, but the logo is drawn
  # once, so redraw the static half at the new center rather than leave the
  # centered layout stranded against a stale geometry.
  [[ "$(term_size)" == "$LAST_SIZE" ]] || render_static
  set_now
  install_progress
  pm=$PROGRESS_PM
  [[ $pm =~ ^[0-9]+$ ]] || pm=$LAST_PM
  (( pm > 1000 )) && pm=1000
  # POS is monotone by construction; this is a guard, not the mechanism.
  (( pm < LAST_PM )) && pm=$LAST_PM
  LAST_PM=$pm

  printf '%s%d;1H' "$CSI" "$DYNAMIC_ROW"
  center "Installing Omarchy" "$CONTENT_WIDTH"
  blank_line
  line_at "$CONTENT_WIDTH" $(( (CONTENT_WIDTH - 34) / 2 )) ""
  progress_bar "$pm" 34
  printf '\n'
  # Same row either way, so the layout height never changes: blank normally,
  # the verify's honest percent while the pre-flight gate waits on the hash.
  if (( VERIFY_PCT >= 0 )); then
    center "${DIM}verifying the install medium: ${VERIFY_PCT}%${RESET}" "$CONTENT_WIDTH"
  else
    blank_line
  fi
  center "${DIM}Tip:${RESET} ${GREEN}$(current_tip)${RESET}" "$CONTENT_WIDTH"
  printf '%s' "$CLEAR_TO_END"
}

format_duration() {
  local secs=$1
  if (( secs >= 3600 )); then
    printf '%dh %dm %ds' "$(( secs / 3600 ))" "$(( secs % 3600 / 60 ))" "$(( secs % 60 ))"
  else
    printf '%dm %ds' "$(( secs / 60 ))" "$(( secs % 60 ))"
  fi
}

install_duration() {
  local path line duration secs

  # The installer marks its own span in the journal with armored
  # sentinels -- BEGIN the moment the configurator hands over, END after
  # the timing record -- so the displayed time is the span the user
  # pressed start on, not this process's lifetime with its release and
  # teardown.
  secs=$(journalctl -b -t omarchy-install-milestone -o short-unix --no-pager 2>/dev/null |
    awk '/-----BEGIN OMARCHY INSTALL-----$/ && s == "" { s = $1 }
         /-----END OMARCHY INSTALL-----$/ { f = $1 }
         END { if (s != "" && f != "" && f > s) printf "%d", f - s }')
  if [[ $secs =~ ^[0-9]+$ ]] && (( secs > 0 )); then
    format_duration "$secs"
    return 0
  fi

  # No milestones (a preview, a test rig): this process launched the
  # installer and outlived it, so its own clock is the next best answer.
  if (( DASH_T0 > 0 )); then
    set_now
    secs=$(( NOW - DASH_T0 ))
    if (( secs > 0 )); then
      format_duration "$secs"
      return 0
    fi
  fi

  for path in /mnt/var/log/omarchy-install.log "$LOG_FILE"; do
    [[ -f $path ]] || continue
    for prefix in Total Omarchy; do
      line="$(grep "^$prefix:" "$path" 2>/dev/null | tail -n 1 || true)"
      [[ -n $line ]] || continue
      duration="${line#*:}"
      duration="${duration#${duration%%[![:space:]]*}}"
      [[ -n $duration ]] && { printf '%s' "$duration"; return 0; }
    done
  done
  return 0
}

render_finish() {
  local duration effect_canvas_width
  duration="$(install_duration || true)"
  duration="${duration:-Complete}"
  # ttfx centers its text two columns right of plain centering, so hand it a
  # canvas two columns narrower and the animated logo lands exactly on the
  # static one left_padding already drew. Otherwise the logo jumps a column
  # sideways when the effect starts and again when it ends.
  effect_canvas_width="$(term_cols)"
  (( effect_canvas_width > 2 )) && effect_canvas_width=$((effect_canvas_width - 2))

  # Set before anything that can fail, so reboot_prompt still lands on the
  # button row even if the logo or the effect below never renders.
  FINISH_TOP_ROW="$(centered_top_row "$FINISH_HEIGHT")"

  {
    printf '%s%s%s%d;1H' "$SHOW_CURSOR" "$CLEAR" "$CSI" "$FINISH_TOP_ROW"
    render_logo
    blank_line
    center "Installed Omarchy in ${duration}" "$CONTENT_WIDTH"
    blank_line
    # Above the button, not below: gum clears everything under its view on
    # each repaint, so a line below the prompt would be erased. True because
    # of release_target + warm_reboot_path: from here to the reboot syscall
    # nothing reads the install medium again — but only when the release
    # actually happened, so a failed one withdraws the offer instead of
    # printing a promise the machine is not keeping.
    if [[ $TARGET_RELEASED == yes ]]; then
      center "${DIM}You can now remove the install medium${RESET}" "$CONTENT_WIDTH"
    else
      center "${DIM}Leave the install medium in until the reboot completes${RESET}" "$CONTENT_WIDTH"
    fi
  } >"$TTY_PATH"

  if [[ -f $LOGO_PATH ]]; then
    # Reuse mode restores a saved cursor before moving up over its input. Save
    # this anchor so the effect redraws the same logo rows shown above.
    printf '%s%d;1H\0337' "$CSI" "$((FINISH_TOP_ROW + LOGO_HEIGHT))" >"$TTY_PATH"
    # Laseretch runs ~4s at 260fps, so the 8s cap is a stuck-process guard rather
    # than a trim. --xterm-colors keeps the whole effect in the 256-index palette
    # the way the greeter does, since the console reduces indexed codes well and
    # truecolor ones badly, and it settles on indexed 2 — the green gum already
    # drew the logo in above, so the send-off ends on the frame it started from
    # instead of recoloring it. The laser and sparks keep their own hot palette.
    timeout 8s ttfx -i "$LOGO_PATH" \
      --canvas-width "$effect_canvas_width" \
      --anchor-text c \
      --frame-rate 260 \
      --reuse-canvas \
      --xterm-colors \
      laseretch \
      --final-gradient-stops 2 \
      >"$TTY_PATH" 2>/dev/null || dashboard_log "logo effect skipped (ttfx exited $?)"
    printf '%s%d;1H' "$CSI" "$((FINISH_TOP_ROW + LOGO_HEIGHT + 5))" >"$TTY_PATH"
  fi
}

# ── Medium-free reboot ──────────────────────────────────────────────────────
#
# The live root pages from the install medium on demand (copytoram=n keeps
# the root image reachable during the install), so pulling the stick is only
# safe once nothing will fault a cold read anymore. A graceful reboot is the
# opposite of that: its stop jobs page unit files and ExecStop binaries. So,
# before the finish screen offers the medium's removal: release the target —
# fully written to its own disk from that moment, whatever happens after —
# and pre-fault the binaries the finish screen still runs. The medium is
# read-only and the live logs are tmpfs, so past the umount nothing anywhere
# is dirty, which is what makes the immediate reboot at the press clean.
# Debugging keeps its access: the installed tree is no longer pre-mounted on
# the other ttys, but one mount command away for whoever wants it.
#
# If the release fails, the offer is withheld: the finish screen says to
# leave the medium in instead, and the button press falls back to a graceful
# reboot — the medium was never offered for removal, so its stop jobs can
# still page from it, and systemd gets its own chance at the unmount the
# release could not do.

TARGET_RELEASED=yes

release_target() {
  local target out line
  target=$INSTALL_TARGET
  # Swapoff, umount, mapper close — shared with the orchestrator's failure
  # cleanup. On failure the script names the holders on stderr; forward that
  # into the install log, where the diagnosis is worth more than a shrug.
  if ! out=$(omarchy-release-install-target "$target" 2>&1); then
    dashboard_log "release: could not release $target"
    TARGET_RELEASED=no
  fi
  while IFS= read -r line; do
    [[ -n $line ]] && dashboard_log "release: $line"
  done <<<"${out:-}"
}

warm_reboot_path() {
  local binary path dep
  # Everything the post-note window still execs: the note goes up inside
  # render_finish, so the logo effect (up to 8s of it), the timeout in front
  # of it, the stty that sizes the prompt, and the button gum paints are all
  # still ahead of the moment the user is invited to pull the stick.
  for binary in systemctl ttfx gum timeout stty; do
    path=$(command -v "$binary" 2>/dev/null) || continue
    cat "$path" >/dev/null 2>&1 || true
    while IFS= read -r dep; do
      [[ -f $dep ]] && cat "$dep" >/dev/null 2>&1
    done < <(ldd "$path" 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^\//) print $i }')
  done

  # cat+ldd alone still leaves ~1.4 MiB of exec-time reads ldd cannot list
  # (loader path, locale, runtime data) — measured on a dropped cache in the
  # live VM: timeout+ttfx 880 KiB, stty 320 KiB, gum 188 KiB, each a
  # one-time fault. Dry-running the real commands takes those reads now,
  # while the medium is still welcome. ttfx --version rather than a hidden
  # effect run: measured to cover the effect's read set to within ~12 KiB,
  # and it returns in milliseconds instead of burning a capped second.
  # systemctl needs no dry run: cat+ldd covers the reboot-shaped invocation
  # (verified via is-system-running: zero reads).
  cat "$LOGO_PATH" >/dev/null 2>&1 || true
  ttfx --version >/dev/null 2>&1 || true
  stty size <"$TTY_PATH" >/dev/null 2>&1 || true
  gum --version >/dev/null 2>&1 || true
}

reboot_now() {
  # Which reboot the button gets is the other half of the release's verdict.
  # Released: nothing anywhere is dirty and the medium may already be gone,
  # so skip the stop jobs that would page it back in. Not released: the
  # finish screen told the user to leave the medium in, which keeps the
  # graceful path's cold reads safe, and systemd gets its own chance at the
  # unmount the release could not do.
  if [[ $TARGET_RELEASED == yes ]]; then
    systemctl reboot -ff 2>/dev/null || reboot -f 2>/dev/null || true
  else
    systemctl reboot 2>/dev/null || reboot 2>/dev/null || true
  fi
}

reboot_prompt() {
  local prompt_pad

  # Nobody to confirm; the OMARCHY_UI_AUTO_REBOOT check at the call site still
  # applies, so setting both stops on the finish screen without a keyboard.
  interactive || return 0

  # gum paints its prompt row at the cursor and the button two rows under it, so
  # anchor on the row right below the removal note to put the button as close
  # to it as gum allows. FINISH_HEIGHT budgets for the same three rows.
  printf '%s%d;1H%s' "$CSI" "$((FINISH_TOP_ROW + LOGO_HEIGHT + 4))" "$CLEAR_LINE" >"$TTY_PATH"

  prompt_pad=$(( ( $(term_cols) - 18 ) / 2 ))
  (( prompt_pad < 0 )) && prompt_pad=0
  gum confirm \
    --padding "0 0 0 $prompt_pad" \
    --show-help=false \
    --default \
    --affirmative "Reboot Now" \
    --negative "" \
    "" <"$TTY_PATH" >"$TTY_PATH" 2>&1
}

truncate_for_width() {
  local text="$1" width="$2"
  if (( ${#text} > width )); then
    printf '%s…' "${text:0:$((width - 1))}"
  else
    printf '%s' "$text"
  fi
}

render_failure_log_tail() {
  # The caller passes the rows it spent above this point that the constant below
  # does not know about, so the tail gives way rather than pushing the top of
  # the screen off a short console.
  local reserved="${1:-0}" rows lines width line tail_log label
  rows=$(term_size)
  rows=${rows%% *}
  lines=$((rows - LOGO_HEIGHT - 18 - reserved))
  (( lines < 6 )) && lines=6
  (( lines > 14 )) && lines=14
  width=$((CONTENT_WIDTH - 4))
  (( width < 40 )) && width=40

  tail_log="${OMARCHY_FAILURE_TAIL_LOG:-}"
  if [[ -z $tail_log ]]; then
    if [[ -f /mnt/var/log/omarchy-install.log ]]; then
      tail_log=/mnt/var/log/omarchy-install.log
    else
      tail_log="$LOG_FILE"
    fi
  fi
  [[ -f $tail_log ]] || return 0

  label="Last log lines:"
  [[ $tail_log == /mnt/* ]] && label="Last target log lines:"
  line_at "$CONTENT_WIDTH" 2 "${DIM}${label}${RESET}"
  printf '\n'
  tail -n "$lines" "$tail_log" 2>/dev/null | while IFS= read -r line; do
    line_at "$CONTENT_WIDTH" 2 "$(truncate_for_width "$line" "$width")"
    printf '\n'
  done
}

find_log_uploader() {
  local candidate
  for candidate in omarchy-upload-log /usr/local/bin/omarchy-upload-log /usr/bin/omarchy-upload-log /mnt/usr/bin/omarchy-upload-log; do
    if [[ $candidate == */* ]]; then
      [[ -x $candidate ]] && { printf '%s' "$candidate"; return 0; }
    elif command -v "$candidate" >/dev/null 2>&1; then
      command -v "$candidate"
      return 0
    fi
  done
  return 1
}

prompt_enter() {
  printf '\nPress Enter to continue…' >"$TTY_PATH"
  IFS= read -r _ <"$TTY_PATH" || true
}

# omarchy-upload-log ships in omarchy-settings, a live ISO package: it posts
# the session log (the failing phases' journal is appended to it by the
# orchestrator's exit) and the archinstall library log.
upload_failure_log() {
  local uploader
  printf '%s%s' "$SHOW_CURSOR" "$CLEAR" >"$TTY_PATH" 2>/dev/null || true
  if uploader=$(find_log_uploader); then
    "$uploader" install >"$TTY_PATH" 2>&1 || true
  else
    {
      echo "No log uploader is available in this environment."
      echo "Install log: $LOG_FILE"
      [[ -f /mnt/var/log/omarchy-install.log ]] && echo "Target log: /mnt/var/log/omarchy-install.log"
    } >"$TTY_PATH"
  fi
  prompt_enter
}

view_failure_log() {
  printf '%s%s' "$SHOW_CURSOR" "$CLEAR" >"$TTY_PATH" 2>/dev/null || true
  if command -v less >/dev/null 2>&1 && [[ -f $LOG_FILE ]]; then
    less "$LOG_FILE" <"$TTY_PATH" >"$TTY_PATH" 2>&1 || true
  else
    tail -n 200 "$LOG_FILE" >"$TTY_PATH" 2>&1 || true
    prompt_enter
  fi
}

# A failure the medium explains is worth saying before the log tail, because
# the tail is where "invalid or corrupted package" already scrolled past
# without ever naming the USB stick it came off.
diagnose_media() {
  local logs=("$LOG_FILE")

  [[ -f /mnt/var/log/omarchy-install.log ]] && logs+=(/mnt/var/log/omarchy-install.log)
  [[ -n ${OMARCHY_FAILURE_TAIL_LOG:-} ]] && logs+=("$OMARCHY_FAILURE_TAIL_LOG")

  omarchy-install-diagnose-media "${logs[@]}" 2>/dev/null
}

# Rows the diagnosis occupies, its leading blank included.
media_diagnosis_rows() {
  local diagnosis="$1"

  if [[ -z $diagnosis ]]; then
    printf '0\n'
  else
    printf '%s\n' "$(( $(grep -c '' <<<"$diagnosis") + 1 ))"
  fi
}

render_media_diagnosis() {
  local diagnosis="$1" line first=1

  [[ -n $diagnosis ]] || return 0
  blank_line
  while IFS= read -r line; do
    # A blank line inside the diagnosis is deliberate: it separates what
    # happened from what to do about it, so it is drawn rather than skipped.
    if [[ -z $line ]]; then
      blank_line
      continue
    fi
    if (( first )); then
      center "${RED}$(truncate_for_width "$line" "$CONTENT_WIDTH")${RESET}" "$CONTENT_WIDTH"
      first=0
    else
      center "$(truncate_for_width "$line" "$CONTENT_WIDTH")" "$CONTENT_WIDTH"
    fi
  done <<<"$diagnosis"
}

render_failure() {
  local status="$1" state_summary="${2:-}" media_diagnosis="${3:-}" line
  printf '%s%s' "$SHOW_CURSOR" "$CLEAR"
  blank_line
  render_logo
  blank_line
  center "${RED}Omarchy installation stopped${RESET}" "$CONTENT_WIDTH"
  center "Installer exited with status $status" "$CONTENT_WIDTH"

  render_media_diagnosis "$media_diagnosis"

  if [[ -n $state_summary ]]; then
    blank_line
    # The failed phase's error is the one thing the user must read, so wrap
    # it at word boundaries rather than clip it: a multi-line error keeps its
    # own line breaks, and an over-long line folds instead of losing its end.
    while IFS= read -r line; do
      [[ -n $line ]] || continue
      while IFS= read -r part; do
        center "${DIM}${part}${RESET}" "$CONTENT_WIDTH"
      done < <(fold -s -w "$CONTENT_WIDTH" <<<"$line")
    done <<<"$state_summary"
  fi

  blank_line
  render_failure_log_tail "$(media_diagnosis_rows "$media_diagnosis")"
  blank_line
  center "${DIM}Get help at https://omarchy.org/discord${RESET}" "$CONTENT_WIDTH"
  blank_line
}

failure_menu() {
  local choice uploader

  [[ ${OMARCHY_UI_FAILURE_ACTION:-} == "exit" ]] && return 0
  # The failure screen and log tail have already rendered; exit with the
  # installer's status instead of blocking on a menu nobody can answer.
  interactive || return 0

  while true; do
    uploader=""
    uploader=$(find_log_uploader || true)
    if [[ -n $uploader ]]; then
      choice=$(gum choose \
        --height 6 \
        --header "What would you like to do?" \
        "Upload log for support" \
        "View full log" \
        "Drop to shell" \
        "Reboot" \
        "Power off" \
        <"$TTY_PATH" 2>"$TTY_PATH") || choice="Drop to shell"
    else
      choice=$(gum choose \
        --height 5 \
        --header "What would you like to do?" \
        "View full log" \
        "Drop to shell" \
        "Reboot" \
        "Power off" \
        <"$TTY_PATH" 2>"$TTY_PATH") || choice="Drop to shell"
    fi

    case "$choice" in
      "Upload log for support")
        upload_failure_log
        render_failure "${failure_status:-1}" "${failure_summary:-}" "${failure_media_diagnosis:-}" >"$TTY_PATH" 2>/dev/null || true
        ;;
      "View full log")
        view_failure_log
        render_failure "${failure_status:-1}" "${failure_summary:-}" "${failure_media_diagnosis:-}" >"$TTY_PATH" 2>/dev/null || true
        ;;
      "Reboot")
        reboot 2>/dev/null || systemctl reboot 2>/dev/null || true
        ;;
      "Power off")
        poweroff 2>/dev/null || systemctl poweroff 2>/dev/null || true
        ;;
      "Drop to shell"|"")
        return 0
        ;;
    esac
  done
}

sanitize_child_output() {
  # The shared log filter (CSI strip + the archinstall-bash banners that
  # would read as "done" after a later Omarchy failure): one sed file for
  # every writer of the unified log -- run-phase applies the same filter to
  # each phase unit's output, since the banner-printing installer functions
  # run inside omarchy-install-base.service now, not in this child.
  sed -u -f /usr/share/omarchy-iso/orchestrator/log-filter.sed
}

launch_child() {
  mkdir -p "$(dirname "$LOG_FILE")"
  # Child is non-interactive. All visible UI belongs to this supervisor.
  setsid "${INSTALL_CMD[@]}" </dev/null > >(sanitize_child_output >>"$LOG_FILE") 2>&1 &
  child_pid=$!
  child_pgid=$child_pid
}

[[ -e $TTY_PATH ]] || exit 2
printf '%s' "$HIDE_CURSOR" >"$TTY_PATH"
render_static >"$TTY_PATH"
set_now
DASH_T0=$NOW
PKG_LAST_CHANGE=$NOW
launch_child

while jobs -pr | grep -qx "$child_pid"; do
  render_dynamic >"$TTY_PATH" 2>/dev/null || true
  sleep 0.5
done

set +e
wait "$child_pid"
status=$?
set -e
child_pid=""
child_pgid=""

dashboard_log "installer child exited with status $status"

if (( status == 0 )); then
  # The orchestrator's exit trap stops the install target on its way out, so
  # by now the latch a poll would read is already torn down -- the child's
  # clean exit is the finish signal. Complete the bar before the finish
  # screen replaces it.
  POS=1000
  render_dynamic >"$TTY_PATH" 2>/dev/null || true
  sleep 0.4
fi

if (( status != 0 )); then
  failure_status="$status"
  failure_summary=""
  # A failed phase unit keeps its failed state through the group teardown
  # (stop is a no-op on it), and its own last words were handed over
  # through the journal; a death outside any phase leaves neither, and
  # the log tail on the failure screen carries that story.
  read_phase_state || true
  phase_error="$(journalctl -b -t omarchy-phase-error -o cat --no-pager 2>/dev/null |
    sed -n "s/^$PHASE_FAILED_UNIT: //p" || true)"
  last_phase="${PHASE_FAILED_NAME:-$PHASE_CUR_NAME}"
  [[ -n $last_phase ]] && failure_summary="last installer phase: $last_phase"
  if [[ -n $PHASE_FAILED_NAME ]]; then
    nl=$'\n'
    failure_summary+="${failure_summary:+$nl}failed phase: $PHASE_FAILED_NAME: ${phase_error:-see the log above}"
  fi
  if [[ -n $failure_summary ]]; then
    while IFS= read -r line; do
      [[ -n $line ]] && dashboard_log "$line"
    done <<<"$failure_summary"
  fi
  failure_media_diagnosis="$(diagnose_media || true)"
  render_failure "$failure_status" "$failure_summary" "$failure_media_diagnosis" >"$TTY_PATH" 2>/dev/null || true
  # Recorded after the screen is drawn, not before: the log tail on that screen
  # reads this same file, and the diagnosis printed twice reads as two findings.
  if [[ -n $failure_media_diagnosis ]]; then
    while IFS= read -r line; do
      [[ -n $line ]] && dashboard_log "$line"
    done <<<"$failure_media_diagnosis"
  fi
  failure_menu
  exit "$failure_status"
fi

# Deferred-provisioning installs finish silently and reboot on their own — the
# owner completes setup (and sees the send-off) at first boot, so the "Installed
# Omarchy in ..." celebration and the Reboot Now prompt belong to a direct
# install only.
if [[ ${OMARCHY_UI_DEFER_PROVISIONING:-} == "yes" ]]; then
  printf '%s' "$CLEAR" >"$TTY_PATH" 2>/dev/null || true
  [[ ${OMARCHY_UI_AUTO_REBOOT:-} == "no" ]] && exit 0
  reboot 2>/dev/null || systemctl reboot 2>/dev/null || true
  exit 0
fi

# Before the screen that offers the medium's removal: the target is released
# first, so the install is fully on its own disk before the user can act on
# the note; the warm makes the button press itself medium-free.
release_target 2>/dev/null || true
warm_reboot_path 2>/dev/null || true

set +e
render_finish
finish_render_status=$?
set -e
if (( finish_render_status != 0 )); then
  dashboard_log "finish screen render failed with status $finish_render_status; using fallback"
  {
    printf '%s%s' "$SHOW_CURSOR" "$CLEAR"
    printf '\nFinished installing\n\n'
  } >"$TTY_PATH" 2>/dev/null || true
fi

if reboot_prompt; then
  if [[ ${OMARCHY_UI_AUTO_REBOOT:-} == "no" ]]; then
    exit 0
  fi
  printf '%s' "$CLEAR" >"$TTY_PATH" 2>/dev/null || true
  reboot_now
fi

exit 0
