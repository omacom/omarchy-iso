#!/bin/bash
#
# Release the install disk before archinstall wipes it, and refuse to go on
# while anything still holds it. Idempotent — called once per install attempt
# from the orchestrator's prepare_live phase.
#
# A disk that has had a life before Omarchy arrives with that life switched on:
# the live ISO's udev assembles an old RAID member and activates an old LVM
# volume group the moment the disk appears. Anything left holding a partition
# keeps the kernel on the old partition table, and archinstall's partprobe logs
# that and carries on, so the filesystem it makes next is not where the new
# table says it is.
#
# So everything stacked on the disk is taken down from the top, and every
# partition's signatures are wiped so udev has nothing left to put back. The
# partition table itself stays: archinstall listed the partitions when it was
# imported and wipes each by path, and a path that has vanished becomes a
# regular file in /dev. Then the kernel must agree to re-read the table, which
# it refuses while anything holds a partition. If it will not, this exits
# non-zero with the reason on its last line, for the failure screen.

set -uo pipefail

if [[ ${1:-} == --protected ]]; then
  target="${2:-}"
  [[ -n $target ]] || { echo "Usage: $0 --protected <target>" >&2; exit 1; }
  findmnt -R "$target" >/dev/null 2>&1 && umount -R "$target" || true
  exit 0
fi

disk="${1:-}"
[[ -n $disk && -b $disk ]] || { echo "Need a block device argument; got '$disk'" >&2; exit 1; }
disk=$(realpath "$disk")
disk_name=$(basename "$disk")

DISK_PARTITIONING="${DISK_PARTITIONING:-/usr/share/omarchy-iso/disk-partitioning.sh}"
[[ -r $DISK_PARTITIONING ]] ||
  DISK_PARTITIONING="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/../../share/omarchy-iso/disk-partitioning.sh"
if [[ ! -r $DISK_PARTITIONING ]]; then
  echo "ERROR: disk partitioning helpers not found at $DISK_PARTITIONING" >&2
  exit 1
fi
# shellcheck source=SCRIPTDIR/../../share/omarchy-iso/disk-partitioning.sh
source "$DISK_PARTITIONING"

echo "Cleaning up existing holders on install disk: $disk"
findmnt -R /mnt >/dev/null && umount -R /mnt || true

# Kernel names (sda2, nvme0n1p2) of the disk's partitions.
partitions() {
  local part
  for part in /sys/block/"$disk_name"/"$disk_name"*; do
    [[ -e $part/partition ]] && basename "$part"
  done
}

# The /dev path for a kernel block device name (dm-0 -> /dev/mapper/<name>).
dev_path() {
  if [[ -e /sys/class/block/$1/dm/name ]]; then
    echo "/dev/mapper/$(<"/sys/class/block/$1/dm/name")"
  else
    echo "/dev/$1"
  fi
}

unuse() {
  swapoff "$1" 2>/dev/null || true
  while read -r target; do
    [[ -n $target ]] && umount "$target" 2>/dev/null || true
  done < <(findmnt -rn -S "$1" -o TARGET 2>/dev/null || true)
}

# Take down everything stacked on a device, holders first, so LVM on LUKS on
# RAID comes apart in the only order it can: device-mapper (crypt, LVM or
# anything else) through dmsetup, md through mdadm. A device's own partitions
# come first, the disk's or an array's (md127p1), since what uses them holds
# the device too. A holder shared with another disk, a RAID1 with its other
# half on sdb, is stopped too: the target cannot be partitioned while it runs,
# and stopping writes nothing to the other disk's data.
release_holders() {
  local part holder name dev
  for part in /sys/class/block/"$1"/"$1"*; do
    [[ -e $part/partition ]] || continue
    unuse "/dev/$(basename "$part")"
    release_holders "$(basename "$part")"
  done
  for holder in /sys/class/block/"$1"/holders/*; do
    [[ -e $holder ]] || continue
    name=$(basename "$holder")
    release_holders "$name"
    dev=$(dev_path "$name")
    unuse "$dev"
    case $name in
      dm-*) echo "Removing $dev"; dmsetup remove --retry "$dev" || true ;;
      md*) echo "Stopping $dev"; mdadm --stop "$dev" || true ;;
    esac
  done
}

has_signatures() {
  [[ -n $(wipefs --no-act "$@" 2>/dev/null) ]]
}

# True when the disk holds anything to tear down or wipe. Skipping flock -x and
# wipefs --all (which opens O_RDWR and triggers udev IN_CLOSE_WRITE while the
# lock is held) avoids a ~1s udev lock-contention retry on clean disks.
disk_has_state() {
  local part holder
  for part in $(partitions); do
    return 0
  done
  for holder in /sys/class/block/"$disk_name"/holders/*; do
    [[ -e $holder ]] && return 0
  done
  findmnt -rn -S "$disk" >/dev/null 2>&1 && return 0
  grep -qs "^${disk}[[:space:]]" /proc/swaps && return 0
  has_signatures --types nogpt,PMBR,dos "$disk" && return 0
  return 1
}

release_and_wipe() {
  local part
  unuse "$disk"
  release_holders "$disk_name"

  # An md superblock or an LVM label is all udev needs to put a holder straight
  # back when the table is re-read. The disk's own signatures go too (an md 0.90
  # member keeps its superblock near the end), all but the partition table.
  for part in $(partitions); do
    if has_signatures "/dev/$part"; then
      wipefs --all --force "/dev/$part" >/dev/null || true
    fi
  done
  if has_signatures --types nogpt,PMBR,dos "$disk"; then
    wipefs --all --force --types nogpt,PMBR,dos "$disk" >/dev/null || true
  fi
}

# Wait for udevd to drain its queue after dropping our lock, delegating to the
# shared EVENT_LOCKED settle watchdog in disk-partitioning.sh.
settle_disk() {
  settle_disk_devices "$disk"
}

# Each attempt first waits out any activation udev already began. On a used
# disk, hold the exclusive lock across teardown, wiping, and re-reading so
# udevd neither reassembles anything mid-wipe nor opens a partition with blkid
# before --rereadpt runs. On a clean disk, skip the lock so udevd does not hit
# EAGAIN and stall udevadm settle.
release_disk() {
  local lock
  released=false
  for _ in $(seq 1 20); do
    settle_disk
    if disk_has_state; then
      # Verify the disk exists and is writable before any teardown, then hold
      # flock -x on a read-only descriptor. Closing an O_RDWR descriptor on a
      # whole disk fires udevd's IN_CLOSE_WRITE watch, which forks (udev-synth)
      # taking flock(LOCK_EX) and collides with (udev-worker) retrying events
      # postponed while our lock was held, stranding them on the 200 ms + 1 s
      # retry timer. Closing O_RDONLY drops the lock without forking
      # (udev-synth), and triggering a change uevent wakes postponed events
      # immediately.
      if ! [[ -e $disk && -w $disk ]] \
        || [[ $(blockdev --getro "$disk" 2>/dev/null || true) == 1 ]] \
        || ! { exec {lock}<"$disk"; } 2>/dev/null \
        || ! flock -x "$lock"; then
        echo "$disk cannot be opened for writing and locked. Reboot the installer and try again."
        exit 1
      fi
      release_and_wipe
      blockdev --flushbufs "$disk" 2>/dev/null || true
      blockdev --rereadpt "$disk" 2>/dev/null && released=true
      exec {lock}<&-
      udevadm trigger --action=change "$disk" 2>/dev/null || true
    else
      blockdev --flushbufs "$disk" 2>/dev/null || true
      blockdev --rereadpt "$disk" 2>/dev/null && released=true
    fi
    $released && break
    sleep 0.2
  done
  settle_disk
}

release_disk

if ! $released; then
  lsblk -o NAME,TYPE,FSTYPE,MOUNTPOINTS "$disk" || true
  busy=()
  for part in $(partitions); do
    for holder in /sys/class/block/"$part"/holders/*; do
      [[ -e $holder ]] && busy+=("$part is held by $(basename "$(dev_path "$(basename "$holder")")")")
    done
    findmnt -rn -S "/dev/$part" >/dev/null 2>&1 && busy+=("$part is mounted")
  done
  ((${#busy[@]})) || busy=("the kernel would not re-read its partition table")
  echo "$disk is still in use and cannot be partitioned (${busy[*]}). Reboot the installer and try again."
  exit 1
fi

echo "Released $disk"
