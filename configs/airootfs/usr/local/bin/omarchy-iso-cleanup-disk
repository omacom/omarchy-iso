#!/bin/bash
#
# Clean up any holders / mounts / LVM / crypt devices on the install disk
# before archinstall starts wiping. Idempotent — called once per install attempt
# from the orchestrator's cleanup_disk phase.
#
# Ported verbatim from .automated_script.sh's cleanup_install_disk(). Kept in
# bash because lsblk / findmnt / lvm / cryptsetup are all easier to drive
# here than from Python.

set -uo pipefail

# True once process $2 has exited, polling up to $1 seconds (counting ticks — $SECONDS is too coarse).
ended_within() {
  local tick
  for ((tick = $1 * 20; tick > 0; tick--)); do
    kill -0 "$2" 2>/dev/null || return 0
    sleep 0.05
  done
  ! kill -0 "$2" 2>/dev/null
}

# Run a command, giving up if it wedges in the kernel, where no signal lands
# (timeout(1) would just hang alongside it). Returns 124 only when the command
# had to be abandoned still running, and reports that on fd 3 — a copy of
# stderr a caller's 2>/dev/null cannot silence.
exec 3>&2
run_bounded() {
  local bound=${OMARCHY_CLEANUP_TIMEOUT:-10} out pid
  out=$(mktemp)
  "$@" </dev/null >"$out" &   # </dev/null: don't drain callers' read loops
  pid=$!
  if ! ended_within "$bound" "$pid"; then
    kill -TERM "$pid" 2>/dev/null
    echo "  gave up on '$*' after ${bound}s" >&3
    ended_within "$bound" "$pid" || { rm -f "$out"; return 124; }
  fi
  wait "$pid"
  cat "$out"
  rm -f "$out"
  return 0
}

if [[ ${1:-} == --protected ]]; then
  target="${2:-}"
  [[ -n $target ]] || { echo "Usage: $0 --protected <target>" >&2; exit 1; }
  findmnt -R "$target" >/dev/null 2>&1 && umount -R "$target" || true
  exit 0
fi

disk="${1:-}"
[[ -n $disk && -b $disk ]] || { echo "Need a block device argument; got '$disk'" >&2; exit 1; }

echo "Cleaning up existing holders on install disk: $disk"
findmnt -R /mnt >/dev/null && run_bounded umount -R /mnt || true

while read -r dev; do
  [[ -b $dev ]] || continue
  run_bounded swapoff "$dev" 2>/dev/null || true
  while read -r target; do
    [[ -n $target ]] && run_bounded umount "$target" 2>/dev/null || true
  done < <(findmnt -rn -S "$dev" -o TARGET 2>/dev/null || true)
done < <(lsblk -rnpo PATH "$disk")

while read -r dev type; do
  [[ $type == disk || $type == part || $type == crypt ]] || continue
  while read -r vg; do
    [[ -n $vg ]] && run_bounded vgchange -an "$vg" 2>/dev/null || true
  done < <(run_bounded pvs --noheadings -o vg_name "$dev" 2>/dev/null | awk '{$1=$1; print}' | sort -u)
done < <(lsblk -rnpo PATH,TYPE "$disk")

while read -r dev type; do
  [[ $type == crypt ]] && run_bounded cryptsetup close "$dev" 2>/dev/null || true
done < <(lsblk -rnpo PATH,TYPE "$disk")

run_bounded blockdev --flushbufs "$disk" 2>/dev/null || true
run_bounded partprobe "$disk" 2>/dev/null || { echo "partprobe stuck rescanning $disk; refusing to hand the disk to the installer" >&2; exit 1; }
udevadm settle --timeout=10 || true
