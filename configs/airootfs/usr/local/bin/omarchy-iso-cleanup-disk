#!/bin/bash
#
# Clean up any holders / mounts / LVM / crypt devices on the install disk
# before archinstall starts wiping. Idempotent — called once per install attempt
# from the orchestrator's cleanup_disk phase.
#
# Ported verbatim from .automated_script.sh's cleanup_install_disk(). Kept in
# bash because lsblk / findmnt / lvm / cryptsetup are all easier to drive
# here than from Python.

set -uo pipefail

if [[ ${1:-} == --protected ]]; then
  target="${2:-}"
  [[ -n $target ]] || { echo "Usage: $0 --protected <target>" >&2; exit 1; }
  findmnt -R "$target" >/dev/null 2>&1 && umount -R "$target" || true
  exit 0
fi

disk="${1:-}"
[[ -n $disk && -b $disk ]] || { echo "Need a block device argument; got '$disk'" >&2; exit 1; }

echo "Cleaning up existing holders on install disk: $disk"
findmnt -R /mnt >/dev/null && umount -R /mnt || true

while read -r dev; do
  [[ -b $dev ]] || continue
  swapoff "$dev" 2>/dev/null || true
  while read -r target; do
    [[ -n $target ]] && umount "$target" 2>/dev/null || true
  done < <(findmnt -rn -S "$dev" -o TARGET 2>/dev/null || true)
done < <(lsblk -rnpo PATH "$disk")

while read -r dev type; do
  [[ $type == disk || $type == part || $type == crypt ]] || continue
  while read -r vg; do
    [[ -n $vg ]] && vgchange -an "$vg" 2>/dev/null || true
  done < <(pvs --noheadings -o vg_name "$dev" 2>/dev/null | awk '{$1=$1; print}' | sort -u)
done < <(lsblk -rnpo PATH,TYPE "$disk")

while read -r dev type; do
  [[ $type == crypt ]] && cryptsetup close "$dev" 2>/dev/null || true
done < <(lsblk -rnpo PATH,TYPE "$disk")

# Releasing the holders leaves what was written on the disk: a LUKS header from an older install
# reaches archinstall, whose own wipefs on that partition exits 1 and aborts a full install whose
# whole intent was to erase the disk (#137). Only reached when the disk is being wiped - protected
# mode returns above - so the signatures are exactly what should go. Devices before the disk, so
# each partition is wiped while it still exists; wiping the disk takes the table last.
while read -r dev; do
  [[ $dev == "$disk" ]] && continue
  [[ -b $dev ]] || continue
  wipefs --all --force "$dev" >/dev/null 2>&1 || true
done < <(lsblk -rnpo PATH "$disk")
wipefs --all --force "$disk" >/dev/null 2>&1 || true

blockdev --flushbufs "$disk" 2>/dev/null || true
partprobe "$disk" 2>/dev/null || true
udevadm settle || true
