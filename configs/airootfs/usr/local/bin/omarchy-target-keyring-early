#!/bin/bash
#
# Make the installed system's pacman keyring in /run/omarchy-target-keyring
# before the install starts (omarchy-target-keyring-early.service). The same
# two pacman-key commands the installer runs when it has to make the keyring
# itself (orchestrator _start_target_keyring_init), from the live ISO's
# keyring packages, which are the root image's.
#
# "complete" is written last and holds a time: the installer takes the
# keyring only with it, and only if the clock is not behind that time, which
# would date the new master key in the future.

set -euo pipefail

dir=${OMARCHY_TARGET_KEYRING_DIR:-/run/omarchy-target-keyring}
keyrings=${OMARCHY_KEYRINGS_DIR:-/usr/share/pacman/keyrings}
calibration=${OMARCHY_LUKS_CALIBRATION_RESULT:-/run/omarchy-luks-calibration/result.json}
names=(archlinux omarchy)
# Arch Linux ARM signs its packages with keys only archlinuxarm-keyring has.
[[ $(uname -m) != aarch64 ]] || names+=(archlinuxarm)

# Not beside the LUKS calibration, and not when it left no result: the wizard
# then stopped it to calibrate at the format, which this must not share the
# CPUs with either. The installer makes the keyring itself in that case.
while systemctl is-active --quiet omarchy-luks-calibrate.service; do
  sleep 0.5
done
[[ -e $calibration ]] || exit 0

# Without the keyring packages the installer makes the keyring from the
# target's own once the image is on the disk.
for name in "${names[@]}"; do
  [[ -f $keyrings/$name.gpg ]] || exit 0
done

# Read wall and monotonic clocks together (<1 us apart) when using the system
# date binary, avoiding both uutils date +%s%3N rollover bugs and any inter-call
# gap between wall and monotonic samples. Falls back to date +%s when date is
# overridden (e.g. unit test clock-step stubs).
sample_clocks() {
  local order=$1 date_bin
  date_bin=$(type -P date 2>/dev/null || true)
  if command -v python3 >/dev/null 2>&1 && [[ $date_bin == /usr/bin/date || $date_bin == /bin/date ]]; then
    python3 -c '
import sys, time
if sys.argv[1] == "start":
    w = time.time_ns(); m = time.monotonic_ns()
else:
    m = time.monotonic_ns(); w = time.time_ns()
print(w // 1_000_000, m // 1_000_000)
' "$order"
    return
  fi
  local w_ms m_ms
  w_ms="$(date +%s)000"
  m_ms=$(awk '{printf "%.0f\n", $1*1000}' /proc/uptime)
  echo "$w_ms $m_ms"
}

rm -rf "$dir/complete" "$dir/complete.new" "$dir/gnupg"
install -d -m 700 "$dir" "$dir/gnupg"
read -r began_ms began_mono_ms < <(sample_clocks start)
pacman-key --gpgdir "$dir/gnupg" --init
pacman-key --gpgdir "$dir/gnupg" --populate-from "$keyrings" --populate "${names[@]}"

read -r end_ms end_mono_ms < <(sample_clocks end)
elapsed_ms=$((end_mono_ms - began_mono_ms))
((elapsed_ms >= 0)) || elapsed_ms=0
latest_ms=$((began_ms + elapsed_ms))
((end_ms <= latest_ms)) || latest_ms=$end_ms
awk -v ms="$latest_ms" 'BEGIN{printf "%.3f\n", ms/1000}' >"$dir/complete.new"
mv "$dir/complete.new" "$dir/complete"
