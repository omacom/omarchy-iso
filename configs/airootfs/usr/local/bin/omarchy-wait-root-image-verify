#!/bin/bash
# Single source of truth for validating the install medium before anything
# formats a disk: the offline package mirror the install pacstraps its
# per-machine packages from, then the root image.
#
# The root image is streamed from the boot medium (copytoram is off), so a bad
# medium must be caught before the full-disk orchestrator hands off to
# archinstall *and* before the free-space configurator partitions the target.
# omarchy-root-image-verify.service hashes the image in the background from boot
# (idle-class, so it yields to the live system under the boot-medium BFQ rule);
# this collects that verdict, waiting for the hash if it is still running and
# starting it if it never did.
#
# Also logs the boot device and its I/O scheduler to stdout (the idle class only
# takes effect under bfq) -- this folds in what used to be omarchy-iso-boot-medium.
#
# Exit 0: image verified (device/scheduler line on stdout). Non-zero: corrupt,
# missing, or unverifiable -- the message is on stderr with the first line
# written to headline the install dashboard. A hash mismatch is re-read cold
# before it is called corrupt: transient misreads pass, persistently wrong
# bytes keep the corrupt verdict, and reads that disagree with each other are
# reported as unstable reads rather than a corrupt medium.
set -uo pipefail

UNIT=omarchy-root-image-verify.service
MIRROR_UNIT=omarchy-mirror-verify.service
MIRROR_SUMS=/usr/share/omarchy-iso/offline-mirror.sha256
MIRROR_DIR=/var/cache/omarchy/mirror/offline
BOOT_MEDIUM_MOUNT=/run/archiso/bootmnt
# archiso names the directory after the architecture, as uname -m does.
IMAGE="$BOOT_MEDIUM_MOUNT/arch/$(uname -m)/omarchy-root.img.zst"
CHECKSUM="$IMAGE.sha256"

fail() { echo "$1" >&2; exit 1; }

# A property of the unit, asked again while systemctl answers nothing. An empty
# answer is systemctl failing, not a value: PID 1 did not reply within D-Bus's
# 25 s, or systemctl itself is still being paged in from a dying medium (the
# live root is read from the stick on demand). After 12 tries, a minute, the
# empty answer stands and the caller reports systemd as not answering.
unit_prop() {
  local value tries=0
  while :; do
    value=$(systemctl show "$UNIT" -p "$1" --value 2>/dev/null)
    if [[ -n $value ]] || ((tries >= 12)); then
      break
    fi
    tries=$((tries + 1))
    sleep "${OMARCHY_VERIFY_RETRY_SECONDS:-5}"
  done
  printf '%s\n' "$value"
}

# Where the unit's hasher is: the file it has open on the medium (the image,
# or a mirror package) and its byte offset in it, from the fdinfo of the
# unit's MainPID (sha256sum while it runs; the same source the orchestrator
# mirrors into the dashboard). Fails silently between opens or once the unit
# is done; callers just skip that sample.
hash_where() {
  local pid fd path pos
  pid=$(systemctl show "$UNIT" -p MainPID --value 2>/dev/null)
  [[ $pid =~ ^[0-9]+$ && $pid -gt 0 ]] || return 1
  for fd in /proc/"$pid"/fd/*; do
    path=$(readlink "$fd" 2>/dev/null) || continue
    [[ $path == "$IMAGE" || $path == "$MIRROR_DIR"/* ]] || continue
    pos=$(awk '/^pos:/ {print $2; exit}' "/proc/$pid/fdinfo/${fd##*/}" 2>/dev/null)
    [[ -n $pos ]] && { printf '%s\t%s\n' "$path" "$pos"; return 0; }
  done
  return 1
}

# How far the hasher is, as an integer percent: of the image's bytes, or for
# the mirror (one package after another, in the sums file's order) the place
# of the package it has open in that list.
hash_pct() {
  local where path pos size line total
  where=$(hash_where) || return 1
  path=${where%$'\t'*} pos=${where##*$'\t'}
  if [[ $path == "$IMAGE" ]]; then
    size=$(stat -c %s "$IMAGE" 2>/dev/null) || return 1
    ((size > 0)) || return 1
    echo $((pos * 100 / size))
    return 0
  fi
  total=$(grep -c . "$MIRROR_SUMS" 2>/dev/null) || return 1
  line=$(grep -n -F -- "  ${path##*/}" "$MIRROR_SUMS" | head -n1 | cut -d: -f1)
  [[ -n $line ]] || return 1
  echo $(((line - 1) * 100 / total))
}

# --- boot medium + scheduler (absorbed from omarchy-iso-boot-medium) ---
src=$(findmnt -no SOURCE "$BOOT_MEDIUM_MOUNT" 2>/dev/null || true)
if [[ -n $src ]]; then
  disk=$(lsblk -no PKNAME "$src" 2>/dev/null | head -n1)
  disk=${disk:-${src#/dev/}}
  sched=unknown
  [[ -r /sys/block/$disk/queue/scheduler ]] && sched=$(cat "/sys/block/$disk/queue/scheduler")
  echo "boot medium: $src on /dev/$disk, scheduler: $sched"
fi

if [[ ! -f $IMAGE ]]; then
  # The archiso hook unmounts the boot medium after copying the airootfs to RAM
  # (copytoram). The boot entries pin copytoram=n, so this only happens when
  # someone edits the kernel command line.
  [[ -d $BOOT_MEDIUM_MOUNT ]] || fail "boot medium is not mounted at $BOOT_MEDIUM_MOUNT: the live system was copied to RAM (copytoram) and the medium released; boot with copytoram=n"
  fail "root image missing: $IMAGE"
fi
[[ -f $CHECKSUM ]] || fail "root image checksum missing: $CHECKSUM"

# The \r progress line needs terminating before anything else writes to the
# terminal. Only a verified image gets the cosmetic 100%; a failure (which
# includes a timed-out, unfinished read) just ends the line. progress_drawn is
# await_verdict's.
finish_progress() {
  [[ $progress_drawn == true ]] || return 0
  [[ ${1:-} == full ]] &&
    printf '\r%*s%s: 100%%' "${OMARCHY_VERIFY_PROGRESS_INDENT:-0}" '' "$label" >>"$OMARCHY_VERIFY_PROGRESS" 2>/dev/null
  printf '\n' >>"$OMARCHY_VERIFY_PROGRESS" 2>/dev/null || true
}

# Whatever the kernel said about the medium lately, for the failure message.
# Empty when dmesg is unavailable: the forensics then just omit it.
cold_medium_lines() {
  command -v dmesg >/dev/null 2>&1 || return 0
  dmesg 2>/dev/null | grep -iE 'sda|usb|I/O error|Buffer' | tail -n 10 || true
}

# One best-effort page-cache drop. False (quietly) when there is nothing
# usable to drop through: the caller then keeps the unit's verdict.
drop_page_cache() {
  [[ -w /proc/sys/vm/drop_caches ]] || return 1
  echo 3 > /proc/sys/vm/drop_caches 2>/dev/null
}

# Sorted basenames the offline mirror's own sums reject; empty when it all
# matches. --strict keeps unreadable files failures too, so a vanished
# package cannot look verified.
cold_mirror_failures() {
  ( cd "$MIRROR_DIR" && sha256sum --check --strict --quiet "$(basename "$MIRROR_SUMS")" 2>/dev/null || true ) |
    sed -n 's/: FAILED.*$//p' | sort
}

# Re-read one cold verdict for the image: full sha256 hex of a fresh read, or
# nothing when it could not be read. Echoes the hex, if any.
cold_image_hex() {
  [[ -f $IMAGE ]] || return 1
  sha256sum "$IMAGE" 2>/dev/null | sed -n 's/^\([0-9a-f]*\) .*/\1/p'
}

# Re-read the verdict cold, bypassing possibly poisoned page cache. Prints the
# verdict word on the first line -- pass (a cold read matched), unstable (two
# cold reads disagreed with each other), corrupt (two cold reads agreed, but
# not with the expected sums), unknown (could not re-read: no permission or
# files unreadable) -- followed by the forensics lines for the failure message
# (none unless corrupt or unstable). Failure-path only: the happy path returns
# from the active branch without ever coming here.
cold_recheck() {
  local expected first second size medium lines verdict
  if [[ $UNIT == "$MIRROR_UNIT" ]]; then
    [[ -f $MIRROR_SUMS && -d $MIRROR_DIR ]] || { echo unknown; return 0; }
    drop_page_cache || { echo unknown; return 0; }
    first=$(cold_mirror_failures) || { echo unknown; return 0; }
    if [[ -z $first ]]; then echo pass; return 0; fi
    drop_page_cache || { echo unknown; return 0; }
    second=$(cold_mirror_failures) || { echo unknown; return 0; }
    if [[ -z $second ]]; then echo pass; return 0; fi
    if [[ $first == "$second" ]]; then
      verdict=corrupt
      lines="failing files (both cold reads):"$'\n'"$first"
    else
      verdict=unstable
      lines="first cold read failures:"$'\n'"$first"$'\n'"second cold read failures (differ):"$'\n'"$second"
    fi
  else
    [[ -f $CHECKSUM ]] || { echo unknown; return 0; }
    # A checksum file without a trailing newline still yields its hash; only
    # an empty or unreadable one means there is nothing to compare against.
    read -r expected _ < "$CHECKSUM" 2>/dev/null || true
    [[ -n $expected ]] || { echo unknown; return 0; }
    # No cache to drop (no permission, /proc unavailable): stay with the
    # unit's verdict rather than invent one.
    drop_page_cache || { echo unknown; return 0; }
    first=$(cold_image_hex) || { echo unknown; return 0; }
    if [[ $first == "$expected" ]]; then echo pass; return 0; fi
    drop_page_cache || { echo unknown; return 0; }
    second=$(cold_image_hex) || { echo unknown; return 0; }
    if [[ $second == "$expected" ]]; then echo pass; return 0; fi
    size=$(stat -c %s "$IMAGE" 2>/dev/null || echo unknown)
    if [[ $first == "$second" ]]; then
      verdict=corrupt
      lines="expected $expected"$'\n'"computed $first"$'\n'"size $size bytes"
    else
      verdict=unstable
      lines="expected $expected"$'\n'"first cold read $first"$'\n'"second cold read $second (differ)"$'\n'"size $size bytes"
    fi
  fi
  medium=$(cold_medium_lines)
  [[ -n $medium ]] && lines+=$'\n'"$medium"
  printf '%s\n' "$verdict" "$lines"
  return 0
}

# Wait for one verify unit's verdict: return when it passed, fail() otherwise.
# $UNIT is global because unit_prop and hash_pct read it.
await_verdict() {
  UNIT=$1
  local what=$2 load_state state tail msg pct cold verdict COLD_EVIDENCE
  local reported=false progress_drawn=false settling=0 unanswered=0
  local where last_where="" last_move=$SECONDS starting=""
  local label="verifying the install medium"
  [[ $UNIT == "$MIRROR_UNIT" ]] && label="verifying the install medium's packages"
  load_state=$(unit_prop LoadState)
  [[ -n $load_state ]] || fail "systemd is not answering about $UNIT; cannot verify $what"
  [[ $load_state == loaded ]] || fail "$UNIT is not on this live system; cannot verify $what"

  # inactive -> never started. `systemctl start` blocks until the oneshot
  # exits, so it runs in the background: the wait below must watch the hash
  # for a stall while it does. Until it returns, the job may still be queued.
  if [[ "$(unit_prop ActiveState)" == inactive ]]; then
    systemctl start "$UNIT" >/dev/null 2>&1 &
    starting=$!
  fi

  while :; do
    state=$(systemctl show "$UNIT" -p ActiveState --value 2>/dev/null)
    # An empty answer is systemctl failing, not a unit state: PID 1 did not
    # reply within D-Bus's 25 s (it can stall on the same dying medium while
    # it stops the hasher) or the call was interrupted. That is transient, so
    # ask again rather than report a unit that is mid-stop as never started;
    # give up only after the wait has clearly outlived any stop.
    if [[ -z $state ]]; then
      if ((unanswered < 12)); then
        unanswered=$((unanswered + 1))
        sleep 5
        continue
      fi
      finish_progress
      fail "systemd is not answering about $UNIT; cannot verify $what"
    fi
    unanswered=0
    case "$state" in
      active)
        finish_progress full
        return 0
        ;;
      failed)
        finish_progress
        # Result=timeout: systemd killed the hash at the size-based
        # TimeoutStartSec the build wrote into the unit (2 MiB/s floor over the
        # image size). The medium is stalling reads, not returning bad data, so
        # re-flashing the same stick is not the advice.
        if [[ "$(unit_prop Result)" == timeout ]]; then
          fail "install medium is too slow: try another USB stick or port"$'\n'"reading $what did not finish within its size-based timeout"
        fi
        # The dashboard centres each line in ~80 columns, so the action comes
        # first and on its own line; the journal tail (the hasher's own output)
        # follows for debugging.
        msg="install medium is corrupt: re-flash it"$'\n'"sha256 mismatch on $what"
        # sha256sum's lines reach the journal through journald's stream and can
        # land a moment after systemd reports the unit failed. Its last line is
        # the "WARNING: ..." summary (did NOT match, could not be read), so read
        # again until that is there: for up to 10 s, which only a failed
        # install waits, because journald can be slow when the hash has filled
        # a small machine's memory with page cache. The lines are matched by
        # the unit's cgroup, not by _COMM=sha256sum: journald fills _COMM from
        # its cached view of the stream's writer, which can be the pre-exec
        # "(sha256sum)".
        journalctl --sync >/dev/null 2>&1 || true
        for _ in {1..50}; do
          tail=$(journalctl -b _SYSTEMD_UNIT="$UNIT" --no-pager -o cat 2>/dev/null)
          [[ $tail == *"WARNING:"* ]] && break
          sleep 0.2
        done
        [[ -n $tail ]] && msg+=$'\n'"$tail"
        # A first-touch read can hash wrong while the bytes on the medium are
        # fine (transient page-cache corruption on the read path: the unit
        # above then hashed poisoned cache). Before declaring the medium
        # corrupt, re-read cold and let the cold verdict decide. Failure-path
        # only: the happy path returned from the active branch, so the F1
        # install budget is untouched.
        # Verdict on the first line, forensics after it (command substitution
        # cannot see the function's variables, so they travel as text).
        cold=$(cold_recheck)
        verdict=${cold%%$'\n'*}
        COLD_EVIDENCE=""
        if [[ $cold == *$'\n'* ]]; then
          COLD_EVIDENCE=${cold#*$'\n'}
        fi
        case "$verdict" in
          pass)
            finish_progress full
            return 0
            ;;
          unstable)
            fail "install medium reads are unstable: suspect USB stick/port, controller, or RAM"$'\n'"try another USB stick or port, and run memtest; re-flashing the same stick may not help"$'\n'"$COLD_EVIDENCE"
            ;;
          corrupt)
            fail "$msg"$'\n'"$COLD_EVIDENCE"
            ;;
          *)  # unknown: could not re-read, keep the unit's verdict
            fail "$msg"
            ;;
        esac
        ;;
      activating)
        if [[ $reported == false ]]; then
          echo "waiting for $UNIT to finish hashing $what..."
          reported=true
        fi
        # Opt-in live progress for interactive callers (the free-space
        # configurator gate): a \r-updating percent line written to the path in
        # OMARCHY_VERIFY_PROGRESS (normally /dev/tty). Kept out of stdout, which
        # the orchestrator logs line by line, and stderr, whose first line
        # headlines the dashboard on failure. OMARCHY_VERIFY_PROGRESS_INDENT
        # spaces line it up with the caller's own text.
        if [[ -n ${OMARCHY_VERIFY_PROGRESS:-} ]] && pct=$(hash_pct); then
          printf '\r%*s%s: %3d%%' "${OMARCHY_VERIFY_PROGRESS_INDENT:-0}" '' "$label" "$pct" >>"$OMARCHY_VERIFY_PROGRESS" 2>/dev/null || true
          progress_drawn=true
        fi
        # A medium that stopped answering stalls the read without failing it,
        # and the size-based timeout behind it is minutes away: tens of them
        # for a 4 GB image. When the hasher's offset has not moved for a
        # minute while an install waits on it, say so now. A slow medium moves
        # (the slow-medium scenario's 64 KB/s does); a read hung in the driver
        # does not. No offset to read (between files, /proc gone) is not a
        # stall: the timeout still stands behind it.
        if where=$(hash_where); then
          if [[ $where != "$last_where" ]]; then
            last_where=$where last_move=$SECONDS
          elif ((SECONDS - last_move >= ${OMARCHY_VERIFY_STALL_SECONDS:-60})); then
            finish_progress
            fail "install medium stopped responding: try another USB stick or port"$'\n'"reading $what made no progress for $((SECONDS - last_move)) s"
          fi
        fi
        sleep 0.5
        ;;
      deactivating)
        # A start timeout stops the unit before it settles into failed, and the
        # stop is what the medium makes slow: SIGTERM does not land on a read
        # stuck in the driver. Classifying this state now would answer "did not
        # run" for the one case the size-based TimeoutStartSec exists to name,
        # so wait for the terminal state -- bounded past DefaultTimeoutStopSec,
        # because a read on a dead medium may never be reaped at all.
        if ((settling < 240)); then
          settling=$((settling + 1))
          sleep 0.5
          continue
        fi
        finish_progress
        fail "install medium is too slow: try another USB stick or port"$'\n'"$what read could not be stopped after its size-based timeout"
        ;;
      reloading|refreshing|maintenance)
        sleep 0.5
        ;;
      *)
        # inactive while the start above still waits: its job is queued.
        if [[ $state == inactive && -n $starting ]] && kill -0 "$starting" 2>/dev/null; then
          sleep 0.5
          continue
        fi
        # inactive after the start above: a condition kept it from running
        # (the image or its checksum is not where the unit expects them).
        fail "$UNIT did not run ($state); cannot verify $what"
        ;;
    esac
  done
}

# The mirror is hashed first (its unit is ordered Before= the image's, so the
# image is the last thing read before the install writes it); its verdict comes
# first too. Without the mirror's sums file there is nothing to verify.
IMAGE_UNIT=$UNIT
if [[ -f $MIRROR_SUMS ]]; then
  await_verdict "$MIRROR_UNIT" "the package mirror"
fi
await_verdict "$IMAGE_UNIT" "the root image"
exit 0
