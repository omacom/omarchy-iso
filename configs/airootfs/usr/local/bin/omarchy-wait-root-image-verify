#!/bin/bash
# Single source of truth for validating the install medium before anything
# formats a disk: the offline package mirror the install pacstraps its
# per-machine packages from, then the root image.
#
# The root image is streamed from the boot medium (copytoram is off), so a bad
# medium must be caught before the full-disk orchestrator hands off to
# archinstall *and* before the free-space configurator partitions the target.
# omarchy-root-image-verify.service hashes the image in the background from boot
# (idle-class, so it yields to the live system under the boot-medium BFQ rule);
# this collects that verdict, waiting for the hash if it is still running and
# starting it if it never did.
#
# Also logs the boot device and its I/O scheduler to stdout (the idle class only
# takes effect under bfq) -- this folds in what used to be omarchy-iso-boot-medium.
#
# Exit 0: image verified (device/scheduler line on stdout; a failed hash adds
# one line reporting its re-read). Non-zero: corrupt, missing, or unverifiable.
# The message is on stderr with the first line written to headline the install
# dashboard. A hash mismatch is re-read cold before it is called corrupt: the
# first cold read must match every file listed in the checksum file (the image
# and any platform layer) to pass, two cold reads that agree on the same wrong
# hash vector keep the corrupt verdict, two that disagree are reported as
# unstable reads rather than a corrupt medium, and a cold read that does not
# finish within the unit's size-based timeout reports a slow medium. Every
# added read is failure-path only and bounded, so the F1 install budget on the
# happy path is untouched.
set -uo pipefail

# The failure message on stderr is capped for the dashboard; the full cold
# evidence goes to stdout, which the orchestrator puts in the install log for
# support. fd 3 keeps those lines out of the command substitution that
# collects the cold verdict.
exec 3>&1

UNIT=omarchy-root-image-verify.service
MIRROR_UNIT=omarchy-mirror-verify.service
MIRROR_SUMS=/usr/share/omarchy-iso/offline-mirror.sha256
MIRROR_DIR=/var/cache/omarchy/mirror/offline
BOOT_MEDIUM_MOUNT=/run/archiso/bootmnt
# archiso names the directory after the architecture, as uname -m does.
IMAGE="$BOOT_MEDIUM_MOUNT/arch/$(uname -m)/omarchy-root.img.zst"
CHECKSUM="$IMAGE.sha256"
# A platform layer beside the image (the N1x's) is in the same sums file, read
# right after the image, in this glob's order.
LAYER_GLOB="${IMAGE%/*}/omarchy-layer.*.tar.zst"

fail() { echo "$1" >&2; exit 1; }

# A property of the unit, asked again while systemctl answers nothing. An empty
# answer is systemctl failing, not a value: PID 1 did not reply within D-Bus's
# 25 s, or systemctl itself is still being paged in from a dying medium (the
# live root is read from the stick on demand). After 12 tries, a minute, the
# empty answer stands and the caller reports systemd as not answering.
unit_prop() {
  local value tries=0
  while :; do
    value=$(systemctl show "$UNIT" -p "$1" --value 2>/dev/null)
    if [[ -n $value ]] || ((tries >= 12)); then
      break
    fi
    tries=$((tries + 1))
    sleep "${OMARCHY_VERIFY_RETRY_SECONDS:-5}"
  done
  printf '%s\n' "$value"
}

# Where the unit's hasher is: the file it has open on the medium (the image,
# a platform layer, or a mirror package) and its byte offset in it, from the fdinfo of the
# unit's MainPID (sha256sum while it runs; the same source the orchestrator
# mirrors into the dashboard). Fails silently between opens or once the unit
# is done; callers just skip that sample.
hash_where() {
  local pid fd path pos
  pid=$(systemctl show "$UNIT" -p MainPID --value 2>/dev/null)
  [[ $pid =~ ^[0-9]+$ && $pid -gt 0 ]] || return 1
  for fd in /proc/"$pid"/fd/*; do
    path=$(readlink "$fd" 2>/dev/null) || continue
    # shellcheck disable=SC2053 # LAYER_GLOB is a pattern on purpose
    [[ $path == "$IMAGE" || $path == $LAYER_GLOB || $path == "$MIRROR_DIR"/* ]] || continue
    pos=$(awk '/^pos:/ {print $2; exit}' "/proc/$pid/fdinfo/${fd##*/}" 2>/dev/null)
    [[ -n $pos ]] && { printf '%s\t%s\n' "$path" "$pos"; return 0; }
  done
  return 1
}

# How far the hasher is, as an integer percent: of the bytes of the image and
# the layers after it, or for the mirror (one package after another, in the sums file's order) the place
# of the package it has open in that list.
hash_pct() {
  local where path pos size line total file done=0
  where=$(hash_where) || return 1
  path=${where%$'\t'*} pos=${where##*$'\t'}
  if [[ $path != "$MIRROR_DIR"/* ]]; then
    total=0
    for file in "$IMAGE" $LAYER_GLOB; do
      [[ -f $file ]] || continue
      size=$(stat -c %s "$file" 2>/dev/null) || return 1
      [[ $file == "$path" ]] && done=$((total + pos))
      total=$((total + size))
    done
    ((total > 0)) || return 1
    echo $((done * 100 / total))
    return 0
  fi
  total=$(grep -c . "$MIRROR_SUMS" 2>/dev/null) || return 1
  line=$(grep -n -F -- "  ${path##*/}" "$MIRROR_SUMS" | head -n1 | cut -d: -f1)
  [[ -n $line ]] || return 1
  echo $(((line - 1) * 100 / total))
}

# --- boot medium + scheduler (absorbed from omarchy-iso-boot-medium) ---
src=$(findmnt -no SOURCE "$BOOT_MEDIUM_MOUNT" 2>/dev/null || true)
if [[ -n $src ]]; then
  disk=$(lsblk -no PKNAME "$src" 2>/dev/null | head -n1)
  disk=${disk:-${src#/dev/}}
  sched=unknown
  [[ -r /sys/block/$disk/queue/scheduler ]] && sched=$(cat "/sys/block/$disk/queue/scheduler")
  echo "boot medium: $src on /dev/$disk, scheduler: $sched"
fi

if [[ ! -f $IMAGE ]]; then
  # The archiso hook unmounts the boot medium after copying the airootfs to RAM
  # (copytoram). The boot entries pin copytoram=n, so this only happens when
  # someone edits the kernel command line.
  [[ -d $BOOT_MEDIUM_MOUNT ]] || fail "boot medium is not mounted at $BOOT_MEDIUM_MOUNT: the live system was copied to RAM (copytoram) and the medium released; boot with copytoram=n"
  fail "root image missing: $IMAGE"
fi
[[ -f $CHECKSUM ]] || fail "root image checksum missing: $CHECKSUM"

# The \r progress line needs terminating before anything else writes to the
# terminal. Only a verified image gets the cosmetic 100%; a failure (which
# includes a timed-out, unfinished read) just ends the line. progress_drawn is
# await_verdict's.
finish_progress() {
  [[ $progress_drawn == true ]] || return 0
  [[ ${1:-} == full ]] &&
    printf '\r%*s%s: 100%%' "${OMARCHY_VERIFY_PROGRESS_INDENT:-0}" '' "$label" >>"$OMARCHY_VERIFY_PROGRESS" 2>/dev/null
  printf '\n' >>"$OMARCHY_VERIFY_PROGRESS" 2>/dev/null || true
}

# What the kernel said lately about reads failing, for the failure message:
# I/O errors and disconnects, never a stick's ordinary USB enumeration. On a
# machine booted from one a looser match finds nothing else, and the failure
# screen shows every line of this, then echoes each into its log tail. Not
# narrowed to the medium's own disk: its kernel name is not known here in
# every boot mode (under Ventoy the ISO is mapped through /dev/mapper/ventoy,
# a loopback boot mounts a loop device). So an error on another disk can be
# among them; each line names the device or port it is about. Empty when
# dmesg is unavailable or the kernel said nothing, which is the usual case
# for a misread.
cold_medium_lines() {
  command -v dmesg >/dev/null 2>&1 || return 0
  dmesg 2>/dev/null |
    grep -iE 'I/O error|Buffer I/O|blk_update_request|print_req_error|Sense Key|Unrecovered|Medium Error|FAILED Result|USB disconnect' |
    tail -n 5 || true
}

# One best-effort page-cache drop. False (quietly) when there is nothing
# usable to drop through: the caller then keeps the unit's verdict.
drop_page_cache() {
  [[ -w /proc/sys/vm/drop_caches ]] || return 1
  echo 3 > /proc/sys/vm/drop_caches 2>/dev/null
}

# Parse a sha256sum file into the expected hashes and file names, in file
# order, and sum the listed files' sizes for the cold timeout. The build
# writes one line per shipped file: the root image and its platform layers,
# or every package and database in the offline mirror. A malformed line, a
# missing sums file, or a listed file that is gone is a failed check (status
# 2), never a clean one: the caller keeps the unit's verdict.
COLD_HASHES=()
COLD_FILES=()
COLD_BYTES=0
COLD_DIR=
cold_sums_load() { # $1: sums file, $2: directory holding the listed files
  local line hash file size total=0 re='^([0-9a-fA-F]{64})[[:space:]][* ](.+)$'
  COLD_HASHES=()
  COLD_FILES=()
  COLD_BYTES=0
  [[ -f $1 && -d $2 ]] || return 2
  while IFS= read -r line || [[ -n $line ]]; do
    [[ -z $line || $line == \#* ]] && continue
    if [[ $line =~ $re ]]; then
      hash=${BASH_REMATCH[1],,}
      file=${BASH_REMATCH[2]}
      size=$(stat -L -c %s -- "$2/$file" 2>/dev/null) || return 2
      COLD_HASHES+=("$hash")
      COLD_FILES+=("$file")
      total=$((total + size))
    else
      return 2
    fi
  done <"$1"
  (( ${#COLD_FILES[@]} > 0 )) || return 2
  COLD_BYTES=$total
  return 0
}

# The expected vector in sha256sum's output form, in sums order.
cold_expected() {
  local i
  for i in "${!COLD_FILES[@]}"; do
    printf '%s  %s\n' "${COLD_HASHES[i]}" "${COLD_FILES[i]}"
  done
}

# Ask to continue when only the first cold read failed with a read error and
# the second matched every checksum. The full-disk install's dashboard owns
# the terminal, so the helper leaves a request in the orchestrator's state
# directory and waits for its answer there; the free-space configurator has
# no dashboard and prompts /dev/tty itself. Headless, a declined answer, and
# no answer within the timeout all stop: the medium is still suspect even when
# the second read looked clean.
confirm_read_error_continue() {
  local state_dir=${OMARCHY_INSTALL_STATE_DIR:-} request answer waited=0 limit=${OMARCHY_VERIFY_CONFIRM_TIMEOUT:-300}
  local question='The first cold read of the install medium had a read error, but the second read matched every checksum. Continuing may write a bad install; a different USB stick or port is safer.'
  if [[ -n $state_dir && -d $state_dir ]]; then
    local monitor="$state_dir/medium-confirm.dashboard" dashboard_pid
    # Only the running dashboard can answer the request. Without its marker,
    # fall through to /dev/tty (a manual run) rather than wait out the timeout
    # for an answer that cannot come.
    if [[ -f $monitor ]]; then
      dashboard_pid=$(cat "$monitor" 2>/dev/null || true)
      [[ $dashboard_pid =~ ^[0-9]+$ ]] && kill -0 "$dashboard_pid" 2>/dev/null || return 1
      request="$state_dir/medium-confirm"
      answer="$state_dir/medium-confirm.answer"
      rm -f "$answer"
      printf '%s\n' "$question" >"$request" 2>/dev/null || return 1
      while [[ ! -f $answer ]]; do
        kill -0 "$dashboard_pid" 2>/dev/null || { rm -f "$request"; return 1; }
        ((waited++ >= limit)) && { rm -f "$request"; return 1; }
        sleep 1
      done
      answer=$(cat "$answer" 2>/dev/null || true)
      rm -f "$request" "$answer"
      [[ $answer == yes ]]
      return
    fi
  fi
  [[ ${OMARCHY_UI_INTERACTIVE:-} == no ]] && return 1
  [[ -r /dev/tty && -w /dev/tty ]] || return 1
  printf '\n%s\nContinue the installation? [y/N] ' "$question" >/dev/tty
  IFS= read -r answer </dev/tty || answer=
  case $answer in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

# One cold pass over every listed file. Prints sha256sum's vector; 124 when
# the size-based timeout expires; 1 when a listed file cannot be read (the
# caller retries that, as a read error can be transient too).
cold_vector() { # $1: seconds
  local out rc=0
  out=$(cd "$COLD_DIR" && timeout "$1" sha256sum -- "${COLD_FILES[@]}" 2>/dev/null) || rc=$?
  if (( rc == 124 )); then echo TIMEOUT; return 124; fi
  (( rc != 0 )) && return 1
  printf '%s\n' "$out"
}

# Per-file differences for the failure message. $1: corrupt|unstable|single,
# $2: expected vector, $3: first cold vector, $4: second cold vector. The
# complete report goes to stdout (fd 3) for the support log; the failure
# message is capped at COLD_REPORT_MAX (8) lines so a broadly damaged mirror
# cannot turn one failure into hundreds of screen lines.
cold_report() {
  local mode=$1 expected=$2 first=$3 second=$4 max=${COLD_REPORT_MAX:-8} full
  full=$(awk -v mode="$mode" '
    BEGIN { FS=OFS="  " }
    FNR == 1 { src++ }
    src == 1 { want[$2] = $1; next }
    src == 2 { first[$2] = $1; next }
    src == 3 { second[$2] = $1; next }
    END {
      for (f in want) {
        if (mode == "corrupt" || mode == "single") {
          if (want[f] == first[f]) continue
          printf "%s: expected %s, computed %s%s\n", f, want[f], first[f], (mode == "corrupt" ? " (both cold reads)" : "")
        } else {
          if (want[f] == first[f] && want[f] == second[f]) continue
          printf "%s: expected %s, first cold read %s, second cold read %s (differ)\n", f, want[f], first[f], second[f]
        }
      }
    }
  ' <(printf '%s\n' "$expected") <(printf '%s\n' "$first") <(printf '%s\n' "$second") | sort)
  [[ -n $full ]] || return 0
  printf '%s\n' "$full" | sed 's/^/cold evidence: /' >&3
  printf '%s\n' "$full" |
    awk -v max="$max" '
      { lines[NR] = $0 }
      END {
        n = NR
        for (i = 1; i <= (n < max ? n : max); i++) print lines[i]
        if (n > max) printf "... and %d more\n", n - max
      }
    '
}

# Bound for one cold read, mirroring the unit's size-based TimeoutStartSec
# (build-iso.sh: bytes at 2 MiB/s plus a 10-minute base): a medium that
# stalls reads instead of erroring must report slow, not hang the installer.
cold_timeout_for() { # $1: bytes -> seconds on stdout
  echo $(($1 / (2 * 1024 * 1024) + 600))
}

# Re-read the verdict cold, bypassing possibly poisoned page cache. Every file
# in the checksum file is hashed, not just the root image: the file lists the
# platform layers too, and the boot unit checks all of them. Prints the verdict
# word on the first line -- pass (the first cold read matched every expected
# hash), unstable (the reads disagree: two different wrong vectors, one wrong
# and one right, or one vector and one read error), corrupt (both cold reads
# produced the same wrong vector), slow (a cold read did not finish within its
# size-based timeout; after a first read that did not, there is no second: it
# could only say the same), unknown (both cold reads failed, or no timeout
# helper, no permission, sums file malformed, a listed file missing) --
# followed by the forensics lines for the failure message (none unless corrupt,
# unstable or slow). Failure-path only: the happy path returns from the active
# branch without ever coming here.
cold_recheck() {
  local sums dir expected first second lines verdict secs rc1 rc2
  if [[ $UNIT == "$MIRROR_UNIT" ]]; then
    sums=$MIRROR_SUMS
    dir=$MIRROR_DIR
  else
    sums=$CHECKSUM
    dir=${IMAGE%/*}
  fi
  command -v timeout >/dev/null 2>&1 || { echo unknown; return 0; }
  COLD_DIR=$dir
  cold_sums_load "$sums" "$dir" || { echo unknown; return 0; }
  secs=$(cold_timeout_for "$COLD_BYTES")
  expected=$(cold_expected)
  drop_page_cache || { echo unknown; return 0; }
  first=$(cold_vector "$secs"); rc1=$?
  if (( rc1 == 0 )) && [[ $first == "$expected" ]]; then echo pass; return 0; fi
  if (( rc1 == 124 )); then
    verdict=slow
    lines="a cold re-read timed out after ${secs}s"
  elif (( rc1 > 1 )); then
    echo unknown; return 0
  else
    # rc1 is 0 (wrong vector) or 1 (read error). A read that came back wrong
    # is only evidence, and a read error can be transient too: the second
    # read decides whether the reads disagree.
    drop_page_cache || { echo unknown; return 0; }
    second=$(cold_vector "$secs"); rc2=$?
    if (( rc2 == 124 )); then
      verdict=slow
      lines="a cold re-read timed out after ${secs}s"
    elif (( rc2 > 1 )); then
      echo unknown; return 0
    elif (( rc1 == 1 || rc2 == 1 )); then
      # One read could not produce a vector. Both read errors keep the unit's
      # verdict; one bad read and one vector are reads that disagree.
      if (( rc1 == 1 && rc2 == 0 )) && [[ $second == "$expected" ]]; then
        if confirm_read_error_continue; then
          printf '%s\n' "warning: first cold read had a read error; second matched every checksum; continued by user" >&3
          echo pass
          return 0
        fi
      fi
      if (( rc1 == 1 && rc2 == 1 )); then
        echo unknown; return 0
      elif (( rc1 == 1 )); then
        [[ -n $second ]] || { echo unknown; return 0; }
        verdict=unstable
        lines="first cold read: read error"
        if [[ $second == "$expected" ]]; then
          lines+=$'\n'"second cold read: every checksum matched (the reads differ)"
        else
          lines+=$'\n'"second cold read differences:"$'\n'"$(cold_report single "$expected" "$second" "$second")"
        fi
      else
        [[ -n $first ]] || { echo unknown; return 0; }
        verdict=unstable
        lines="second cold read: read error"$'\n'"first cold read differences:"$'\n'"$(cold_report single "$expected" "$first" "$first")"
      fi
      lines+=$'\n'"size $COLD_BYTES bytes"
    elif [[ -z $first || -z $second ]]; then
      echo unknown; return 0
    elif [[ $first == "$second" ]]; then
      verdict=corrupt
      lines="$(cold_report corrupt "$expected" "$first" "$second")"$'\n'"size $COLD_BYTES bytes"
    else
      verdict=unstable
      lines="$(cold_report unstable "$expected" "$first" "$second")"$'\n'"size $COLD_BYTES bytes"
      [[ $second == "$expected" ]] && lines+=$'\n'"second cold read: every checksum matched (the reads differ)"
    fi
  fi
  medium=$(cold_medium_lines)
  [[ -n $medium ]] && lines+=$'\n'"$medium"
  printf '%s\n' "$verdict" "$lines"
  return 0
}

# Wait for one verify unit's verdict: return when it passed, fail() otherwise.
# $UNIT is global because unit_prop and hash_pct read it.
await_verdict() {
  UNIT=$1
  local what=$2 load_state state tail msg pct cold verdict COLD_EVIDENCE cold_began
  local reported=false progress_drawn=false settling=0 unanswered=0
  local where last_where="" last_move=$SECONDS starting=""
  local label="verifying the install medium"
  [[ $UNIT == "$MIRROR_UNIT" ]] && label="verifying the install medium's packages"
  load_state=$(unit_prop LoadState)
  [[ -n $load_state ]] || fail "systemd is not answering about $UNIT; cannot verify $what"
  [[ $load_state == loaded ]] || fail "$UNIT is not on this live system; cannot verify $what"

  # inactive -> never started. `systemctl start` blocks until the oneshot
  # exits, so it runs in the background: the wait below must watch the hash
  # for a stall while it does. Until it returns, the job may still be queued.
  if [[ "$(unit_prop ActiveState)" == inactive ]]; then
    # 3>&-: the support-log copy of stdout must not be inherited by the
    # background start, or a caller capturing the helper would wait for the
    # unit's whole hash before seeing the helper exit.
    systemctl start "$UNIT" >/dev/null 2>&1 3>&- &
    starting=$!
  fi

  while :; do
    state=$(systemctl show "$UNIT" -p ActiveState --value 2>/dev/null)
    # An empty answer is systemctl failing, not a unit state: PID 1 did not
    # reply within D-Bus's 25 s (it can stall on the same dying medium while
    # it stops the hasher) or the call was interrupted. That is transient, so
    # ask again rather than report a unit that is mid-stop as never started;
    # give up only after the wait has clearly outlived any stop.
    if [[ -z $state ]]; then
      if ((unanswered < 12)); then
        unanswered=$((unanswered + 1))
        sleep 5
        continue
      fi
      finish_progress
      fail "systemd is not answering about $UNIT; cannot verify $what"
    fi
    unanswered=0
    case "$state" in
      active)
        finish_progress full
        return 0
        ;;
      failed)
        finish_progress
        # Result=timeout: systemd killed the hash at the size-based
        # TimeoutStartSec the build wrote into the unit (2 MiB/s floor over the
        # image size). The medium is stalling reads, not returning bad data, so
        # re-flashing the same stick is not the advice.
        if [[ "$(unit_prop Result)" == timeout ]]; then
          fail "install medium is too slow: try another USB stick or port"$'\n'"reading $what did not finish within its size-based timeout"
        fi
        # The dashboard centres each line in ~80 columns, so the action comes
        # first and on its own line; the journal tail (the hasher's own output)
        # follows for debugging.
        msg="install medium is corrupt: re-flash it"$'\n'"sha256 mismatch on $what"
        # sha256sum's lines reach the journal through journald's stream and can
        # land a moment after systemd reports the unit failed. Its last line is
        # the "WARNING: ..." summary (did NOT match, could not be read), so read
        # again until that is there: for up to 10 s, which only a failed
        # install waits, because journald can be slow when the hash has filled
        # a small machine's memory with page cache. The lines are matched by
        # the unit's cgroup, not by _COMM=sha256sum: journald fills _COMM from
        # its cached view of the stream's writer, which can be the pre-exec
        # "(sha256sum)".
        journalctl --sync >/dev/null 2>&1 || true
        for _ in {1..50}; do
          tail=$(journalctl -b _SYSTEMD_UNIT="$UNIT" --no-pager -o cat 2>/dev/null)
          [[ $tail == *"WARNING:"* ]] && break
          sleep 0.2
        done
        [[ -n $tail ]] && msg+=$'\n'"$tail"
        # A first-touch read can hash wrong while the bytes on the medium are
        # fine (transient page-cache corruption on the read path: the unit
        # above then hashed poisoned cache). Before declaring the medium
        # corrupt, re-read cold and let the cold verdict decide. Failure-path
        # only: the happy path returned from the active branch, so the F1
        # install budget is untouched.
        # Verdict on the first line, forensics after it (command substitution
        # cannot see the function's variables, so they travel as text).
        cold_began=$SECONDS
        cold=$(cold_recheck)
        verdict=${cold%%$'\n'*}
        COLD_EVIDENCE=""
        if [[ $cold == *$'\n'* ]]; then
          COLD_EVIDENCE=${cold#*$'\n'}
        fi
        # The orchestrator logs this script's stdout line by line once it
        # exits: the support log then says what the re-read found, and how
        # long the installer sat apparently still.
        echo "re-read $what cold after the failed hash: $verdict, $((SECONDS - cold_began)) s"
        case "$verdict" in
          pass)
            finish_progress full
            return 0
            ;;
          unstable)
            fail "install medium reads are unstable: suspect USB stick/port, controller, or RAM"$'\n'"try another USB stick or port, and run memtest; re-flashing the same stick may not help"$'\n'"$COLD_EVIDENCE"
            ;;
          corrupt)
            fail "$msg"$'\n'"$COLD_EVIDENCE"
            ;;
          slow)
            fail "install medium is too slow: try another USB stick or port"$'\n'"reading $what did not finish within its size-based timeout"$'\n'"$COLD_EVIDENCE"
            ;;
          *)  # unknown: could not re-read, keep the unit's verdict
            fail "$msg"
            ;;
        esac
        ;;
      activating)
        if [[ $reported == false ]]; then
          echo "waiting for $UNIT to finish hashing $what..."
          reported=true
        fi
        # Opt-in live progress for interactive callers (the free-space
        # configurator gate): a \r-updating percent line written to the path in
        # OMARCHY_VERIFY_PROGRESS (normally /dev/tty). Kept out of stdout, which
        # the orchestrator logs line by line, and stderr, whose first line
        # headlines the dashboard on failure. OMARCHY_VERIFY_PROGRESS_INDENT
        # spaces line it up with the caller's own text.
        if [[ -n ${OMARCHY_VERIFY_PROGRESS:-} ]] && pct=$(hash_pct); then
          printf '\r%*s%s: %3d%%' "${OMARCHY_VERIFY_PROGRESS_INDENT:-0}" '' "$label" "$pct" >>"$OMARCHY_VERIFY_PROGRESS" 2>/dev/null || true
          progress_drawn=true
        fi
        # A medium that stopped answering stalls the read without failing it,
        # and the size-based timeout behind it is minutes away: tens of them
        # for a 4 GB image. When the hasher's offset has not moved for a
        # minute while an install waits on it, say so now. A slow medium moves
        # (the slow-medium scenario's 64 KB/s does); a read hung in the driver
        # does not. No offset to read (between files, /proc gone) is not a
        # stall: the timeout still stands behind it.
        if where=$(hash_where); then
          if [[ $where != "$last_where" ]]; then
            last_where=$where last_move=$SECONDS
          elif ((SECONDS - last_move >= ${OMARCHY_VERIFY_STALL_SECONDS:-60})); then
            finish_progress
            fail "install medium stopped responding: try another USB stick or port"$'\n'"reading $what made no progress for $((SECONDS - last_move)) s"
          fi
        fi
        sleep 0.5
        ;;
      deactivating)
        # A start timeout stops the unit before it settles into failed, and the
        # stop is what the medium makes slow: SIGTERM does not land on a read
        # stuck in the driver. Classifying this state now would answer "did not
        # run" for the one case the size-based TimeoutStartSec exists to name,
        # so wait for the terminal state -- bounded past DefaultTimeoutStopSec,
        # because a read on a dead medium may never be reaped at all.
        if ((settling < 240)); then
          settling=$((settling + 1))
          sleep 0.5
          continue
        fi
        finish_progress
        fail "install medium is too slow: try another USB stick or port"$'\n'"$what read could not be stopped after its size-based timeout"
        ;;
      reloading|refreshing|maintenance)
        sleep 0.5
        ;;
      *)
        # inactive while the start above still waits: its job is queued.
        if [[ $state == inactive && -n $starting ]] && kill -0 "$starting" 2>/dev/null; then
          sleep 0.5
          continue
        fi
        # inactive after the start above: a condition kept it from running
        # (the image or its checksum is not where the unit expects them).
        fail "$UNIT did not run ($state); cannot verify $what"
        ;;
    esac
  done
}

# The mirror is hashed first (its unit is ordered Before= the image's, so the
# image is the last thing read before the install writes it); its verdict comes
# first too. Without the mirror's sums file there is nothing to verify.
IMAGE_UNIT=$UNIT
if [[ -f $MIRROR_SUMS ]]; then
  await_verdict "$MIRROR_UNIT" "the package mirror"
fi
await_verdict "$IMAGE_UNIT" "the root image"
exit 0
