#!/usr/bin/env bash

set -u

log=/var/log/omarchy-n1x-live-probe.log

section() {
  echo
  echo "===== $* ====="
}

{
  echo "Omarchy N1x live recovery probe"
  date --iso-8601=seconds

  section kernel
  uname -a
  cat /proc/cmdline

  section consoles
  cat /sys/class/tty/console/active 2>/dev/null || true
  cat /proc/fb 2>/dev/null || true
  for name in /sys/class/graphics/fb*/name; do
    [[ -r $name ]] || continue
    printf '%s: ' "$name"
    cat "$name"
  done

  section "NVIDIA PCI identity"
  lspci -Dnnk -d 10de: || true

  section DRM
  find /sys/class/drm -maxdepth 2 -type f \
    \( -name status -o -name enabled -o -name modes -o -name modalias \) \
    -print -exec cat {} \; 2>/dev/null || true

  section modules
  lsmod

  section network
  ip -brief link || true
  ip -brief address || true

  section "kernel display and platform log"
  journalctl -b -k --no-pager | \
    grep -Ei 'efi|framebuffer|fbcon|simpledrm|drm|nvidia|nouveau|acpi|i2c|hid|r8127|mt79|mlx5' || true

  section network
  ip -4 -brief address | awk '$1 != "lo" && $3 { print $1, $3 }'
  # Only a --dev-ssh image lets anyone log in remotely.
  if [[ -x /usr/local/sbin/omarchy-n1x-dev-ssh ]]; then
    echo "DEV image: the development key logs in as root:"
    ip -4 -brief address | awk '$1 != "lo" && $3 { print "  ssh root@" $3 }' | sed 's|/[0-9]*$||'
    echo "  or, where mDNS works: ssh root@omarchy-n1x-rescue.local"
  fi
} > >(tee "$log") 2>&1
