#!/bin/bash
#
# Boots an aarch64 Omarchy ISO the way a machine would: UEFI firmware, GRUB
# from the ISO, the live kernel and initramfs, the live root. The live system
# must offer a login on its serial port or the installer on the screen. Where
# the installer's welcome offers Try Omarchy (the medium has the Try layer),
# Space there must then bring up Try's desktop.
#
#   test/arm64-live-boot <omarchy.iso> <evidence_dir>
#
# Needs an arm64 host with a usable /dev/kvm, qemu-system-aarch64 and the
# AAVMF/edk2 firmware. evidence_dir gets serial.log, screen.png and timing,
# and with Try try-welcome.png and try-desktop.png.
#
# Env: TIMEOUT (seconds for each wait, default 600), NO_TRY=1 (a medium from
#      before Try on aarch64: 4.5 and older), SMP (4), MEM (8G), MACHINE. The
#      default machine is the one that works under nested KVM on Namespace's
#      Apple-backed runners: with the interrupt translation service on, MSIs
#      are lost and virtio disks hang.
set -euo pipefail
[[ $# -eq 2 ]] || { sed -n '2,19p' "$0" >&2; exit 2; }
iso=$(realpath "$1")
out=$(realpath -m "$2")
mkdir -p "$out"

[[ $(uname -m) == aarch64 ]] || { echo "arm64-live-boot: this needs an arm64 host" >&2; exit 1; }
for tool in jq tesseract; do
  command -v "$tool" >/dev/null || { echo "arm64-live-boot: $tool is missing" >&2; exit 1; }
done
[[ -r /dev/kvm && -w /dev/kvm ]] || { echo "arm64-live-boot: /dev/kvm is not usable" >&2; exit 1; }
source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)/bin/lib/aarch64-firmware.sh"
aarch64_uefi_firmware || { echo "arm64-live-boot: no aarch64 UEFI firmware found" >&2; exit 1; }
code=$AARCH64_UEFI_CODE vars=$AARCH64_UEFI_VARS

state=$(mktemp -d /var/tmp/arm64-live.XXXXXX)
cleanup() {
  local status=$? pid
  if [[ -f $state/qemu.pid ]]; then
    pid=$(cat "$state/qemu.pid")
    kill "$pid" 2>/dev/null || true
    for _ in $(seq 1 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
  fi
  rm -rf "$state"
  exit "$status"
}
trap cleanup EXIT
cp "$vars" "$state/vars.fd"
: >"$out/serial.log"

# One QMP command, as JSON, after the capabilities handshake.
qmp() {
  python3 - "$state/qmp.sock" "$1" <<'PY'
import json, socket, sys
s = socket.socket(socket.AF_UNIX); s.settimeout(20); s.connect(sys.argv[1]); f = s.makefile("rw")
f.readline()
for command in ({"execute": "qmp_capabilities"}, json.loads(sys.argv[2])):
    f.write(json.dumps(command) + "\n"); f.flush()
    while "return" not in (reply := json.loads(f.readline())):
        if "error" in reply: sys.exit(reply["error"]["desc"])
PY
}

# The screen into $out/<name>.png, screen.png by default. It fails when QEMU
# takes no picture, and an older picture of that name is gone by then.
screenshot() {
  local file="$out/${1:-screen}.png" command
  rm -f "$file" || return 1
  command=$(jq -cn --arg file "$file" '{execute: "screendump", arguments: {filename: $file, format: "png"}}') || return 1
  qmp "$command" && [[ -s $file ]]
}

# The screen's text, read off $out/<name>.png.
screen_text() {
  screenshot "$1" 2>/dev/null && tesseract "$out/$1.png" - 2>/dev/null
}

qemu_running() {
  kill -0 "$(cat "$state/qemu.pid")" 2>/dev/null
}

start=$(date +%s)
qemu-system-aarch64 -machine "${MACHINE:-virt,gic-version=3,msi=gicv2m,acpi=off}" -accel kvm -cpu host \
  -smp "${SMP:-4}" -m "${MEM:-8G}" \
  -drive "if=pflash,format=raw,readonly=on,file=$code" -drive "if=pflash,format=raw,file=$state/vars.fd" \
  -device virtio-scsi-pci -drive "file=$iso,format=raw,if=none,id=iso,media=cdrom,readonly=on" \
  -device scsi-cd,drive=iso,bootindex=0 \
  -device virtio-gpu-pci -device qemu-xhci -device usb-kbd -device usb-tablet \
  -netdev user,id=net -device virtio-net-pci,netdev=net -device virtio-rng-pci \
  -serial "file:$out/serial.log" -display none \
  -qmp "unix:$state/qmp.sock,server,nowait" -pidfile "$state/qemu.pid" -daemonize

# The live system is up when it offers a login on the serial port, or shows the
# installer on the screen: an image whose kernel command line names no serial
# console (linux-omarchy, for the laptops' panel) says nothing on the port.
installer_on_screen() {
  local text
  text=$(screen_text screen) && grep -q 'Start Install' <<<"$text"
}
# The welcome, drawn whole: Start Install, and Just try under it unless the
# medium is one from before the aarch64 Try layer (NO_TRY=1).
welcome_on_screen() {
  local text
  text=$(screen_text screen) || return 1
  grep -q 'Start Install' <<<"$text" || return 1
  [[ ${NO_TRY:-} == "1" ]] || grep -qi 'just to try' <<<"$text"
}
# Omarchy's first-login notifications, or the Try session's own ("Install
# apps, change themes, anything", builder/try-layer/omarchy-try-welcome):
# either is Try's desktop. Not its title: the installer's own "Try Omarchy
# could not start" carries that too, and ends the test at once.
try_desktop_on_screen() {
  local text
  text=$(screen_text try-desktop) || return 1
  if grep -qi 'could not start' <<<"$text"; then
    echo "arm64-live-boot: the installer says Try Omarchy could not start:" >&2
    echo "$text" >&2
    exit 1
  fi
  grep -qi 'change themes\|Keybindings' <<<"$text"
}
# Fails the test, with the port's last lines, once QEMU has exited or $1
# seconds have passed since $2. Called before each look at the screen, so
# nothing seen after the deadline passes.
give_up_after() {
  local what=$3
  if ! qemu_running; then
    echo "arm64-live-boot: qemu exited before $what" >&2
  elif (( $(date +%s) - $2 >= $1 )); then
    echo "arm64-live-boot: no $what after $1 s; the port's last lines:" >&2
  else
    return 0
  fi
  tail -n 30 "$out/serial.log" | tr -d '\r' >&2
  exit 1
}

[[ ${TIMEOUT:-600} =~ ^[0-9]+$ ]] || { echo "arm64-live-boot: TIMEOUT must be a number of seconds" >&2; exit 2; }
timeout=$((10#${TIMEOUT:-600}))
while give_up_after "$timeout" "$start" "login prompt on the serial port or installer on the screen" &&
  ! grep -aq 'login:' "$out/serial.log" && ! installer_on_screen; do
  sleep 1
done
elapsed=$(( $(date +%s) - start ))
echo "login_prompt_seconds=$elapsed" | tee "$out/timing"
echo "arm64-live-boot: the live system was up after $elapsed s"

while give_up_after "$timeout" "$start" "installer welcome on the screen" && ! welcome_on_screen; do
  sleep 2
done
[[ ${NO_TRY:-} != "1" ]] || exit 0

# Try Omarchy: Space on the welcome soft-reboots the live system into the
# desktop from the medium (omarchy-try).
cp "$out/screen.png" "$out/try-welcome.png"
try_start=$(date +%s)
qmp '{"execute": "send-key", "arguments": {"keys": [{"type": "qcode", "data": "spc"}]}}'
while give_up_after "$timeout" "$try_start" "Try Omarchy desktop" && ! try_desktop_on_screen; do
  sleep 3
done
try_elapsed=$(( $(date +%s) - try_start ))
echo "try_desktop_seconds=$try_elapsed" | tee -a "$out/timing"
echo "arm64-live-boot: Try Omarchy reached the desktop $try_elapsed s after Space"
