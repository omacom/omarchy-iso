#!/bin/bash
# Run inside the privileged build container with the project's /builder mount.
set -euo pipefail

work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT
mkdir -p "$work/base/omarchy-root" "$work/squash" "$work/airootfs"
echo shared >"$work/base/omarchy-root/shared"
cp -p "$work/base/omarchy-root/shared" "$work/airootfs/shared"
echo live >"$work/airootfs/live-only"
truncate -s 160M "$work/squash/omarchy-root.img"
mkfs.btrfs -q --rootdir "$work/base" --subvol rw:omarchy-root "$work/squash/omarchy-root.img"
mksquashfs "$work/squash" "$work/root.sfs" -comp zstd -noappend -no-progress -quiet

# Reproduce Docker's /dev after the root-image build has released its one node.
# Only this mount namespace sees the replacement /dev.
unshare --mount --propagation private bash -euo pipefail -s -- "$work" <<'SH'
work=$1
mount -t tmpfs -o mode=0755 tmpfs /dev
mknod -m 0666 /dev/null c 1 3
mknod /dev/loop-control c 10 237
first=$(losetup --find)
first=${first%% *}
mknod "$first" b 7 "${first#/dev/loop}"
OMARCHY_ROOT_SFS="$work/root.sfs" /builder/live-layer/mksquashfs \
  "$work/airootfs" "$work/live.sfs" -noappend -no-progress -quiet
SH

[[ $(unsquashfs -cat "$work/live.sfs" live-only) == live ]]
listing=$(unsquashfs -ls "$work/live.sfs")
if grep -Fxq 'squashfs-root/shared' <<<"$listing"; then
  echo "FAIL: the live layer included a file it should share with the base image" >&2
  exit 1
fi
echo "ok - the live layer builds with one initial loop device node"
