#!/bin/bash
#
# Build, and afterwards audit, a disk shaped like the machine the LVM install
# mode exists for: one disk already given over to LVM, holding a sibling Linux
# system the owner still boots, a populated /home they cannot lose, swap, and
# one empty spare volume for Omarchy. An ESP already carries the sibling's
# bootloader.
#
# The point is the `verify` half. Creating a disk with a volume group on it is
# easy and proves nothing; what an install of this kind has to prove is that
# everything it did NOT nominate came through untouched. So every volume the
# installer must leave alone is seeded with marker files, and `verify` reads
# them back after the install and fails on the first byte that moved. A test
# that only checks Omarchy booted would pass while the sibling's root was
# being erased.
#
# No root: libguestfs runs its own appliance, so this builds an LVM stack
# without touching the host's device mapper. That also means a mistake here
# cannot reach the developer's own disks.
#
# Usage:
#   test/lvm-fixture-disk create [--out PATH] [--size GB] [--force]
#   test/lvm-fixture-disk verify [--out PATH]
#   test/lvm-fixture-disk boot-check-supported
#
# Then boot it beside the ISO, e.g.:
#   qemu-system-x86_64 -enable-kvm -m 8192 \
#     -drive file=<iso>,media=cdrom \
#     -drive file=<out>,if=virtio,format=qcow2 ...

set -euo pipefail

# The appliance talks to qemu directly rather than through libvirt, which needs
# neither a session daemon nor a policy exception on a developer machine.
export LIBGUESTFS_BACKEND="${LIBGUESTFS_BACKEND:-direct}"

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
OUT="$ROOT/release/lvm-fixture.qcow2"
SIZE_GB=24
FORCE=false

# The sibling's identity, and the volume names the scenario is written around.
VG=pool
LV_SIBLING=kde
LV_HOME=data
LV_SWAP=swap
LV_SPARE=omarchy
HOME_LABEL=DATA
HOME_USER=owner

# A real bootloader, so the sibling's boot path can be executed rather than
# merely inspected. Reading the sibling's files back byte-identical proves the
# install did not corrupt them; it does not prove firmware can still start the
# other system. Only booting it proves that, and booting needs a genuine PE
# binary rather than a text stand-in.
#
# When systemd-boot is not installed on the build host the fixture falls back to
# the stand-in and the boot check is skipped rather than silently weakened.
SIBLING_BOOTLOADER="${SIBLING_BOOTLOADER:-/usr/lib/systemd/boot/efi/systemd-bootx64.efi}"
SIBLING_BOOTLOADER_STANDIN="sibling bootloader binary stand-in"

# The sibling's boot entry. SiblingOS is what the boot check looks for on
# screen, so this string is the contract between the fixture and that check.
SIBLING_LOADER_ENTRY="title SiblingOS
linux /vmlinuz-linux"

# Marker files, as "path-within-volume|contents". Read back verbatim by verify.
# Deliberately spread across both volumes and into a deep directory: an install
# that truncates or reformats fails the first, one that reformats and restores
# a skeleton still fails the last.
SIBLING_MARKERS=(
  "/etc/os-release|NAME=SiblingOS"
  "/etc/fstab|# sibling fstab, must survive the Omarchy install"
  "/home/.keep|sibling root marker"
)
HOME_MARKERS=(
  "/$HOME_USER/.bashrc|# sibling home dotfile, must survive"
  "/$HOME_USER/Documents/notes.txt|stands in for the irreplaceable half of a shared home"
  "/$HOME_USER/.config/deep/nested/value|nested marker"
)

usage() {
  cat <<USAGE
Usage: test/lvm-fixture-disk create [--out PATH] [--size GB] [--force]
       test/lvm-fixture-disk verify [--out PATH]
       test/lvm-fixture-disk boot-check-supported

create  Build the fixture disk.
verify  Re-read the markers and fail if anything the installer had to leave
        alone has changed. Run this after an install against the fixture.
boot-check-supported
        Exit 0 when the fixture can carry a real bootloader, so a caller knows
        whether booting the sibling is a meaningful test on this host.
USAGE
}

command=${1:-}
shift || true
case "$command" in
  create | verify | boot-check-supported) ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac

while (($#)); do
  case "$1" in
    --out)
      OUT="${2:?--out needs a path}"
      shift 2
      ;;
    --size)
      SIZE_GB="${2:?--size needs a number}"
      shift 2
      ;;
    --force)
      FORCE=true
      shift
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

for tool in guestfish qemu-img; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "Error: $tool is required (install libguestfs and qemu-img)" >&2
    exit 1
  fi
done

# Emit the guestfish commands that write one marker into an already-mounted
# volume. Shared by create so the paths cannot drift from what verify reads.
emit_marker_writes() {
  local marker path contents
  for marker in "$@"; do
    path="${marker%%|*}"
    contents="${marker#*|}"
    printf 'mkdir-p %s\n' "$(dirname "$path")"
    printf 'write %s "%s"\n' "$path" "$contents"
  done
}

have_real_bootloader() {
  [[ -r $SIBLING_BOOTLOADER ]]
}

# The sibling's bootloader, at both the vendor path and the UEFI fallback path.
# The fallback is what firmware boots when no NVRAM entry matches, which is
# exactly the state the boot check recreates.
emit_bootloader_writes() {
  if have_real_bootloader; then
    printf 'upload %s /EFI/systemd/systemd-bootx64.efi\n' "$SIBLING_BOOTLOADER"
    printf 'upload %s /EFI/BOOT/BOOTX64.EFI\n' "$SIBLING_BOOTLOADER"
  else
    printf 'write /EFI/systemd/systemd-bootx64.efi "%s"\n' "$SIBLING_BOOTLOADER_STANDIN"
    printf 'write /EFI/BOOT/BOOTX64.EFI "%s"\n' "$SIBLING_BOOTLOADER_STANDIN"
  fi
}

# Whether this host can give the fixture a bootloader that actually executes.
# The boot check is only a test when it can; against the text stand-in it would
# wait for a menu that can never appear and report a healthy install as broken.
boot-check-supported() {
  have_real_bootloader
}

create() {
  if [[ -e $OUT ]] && ! $FORCE; then
    echo "Error: $OUT already exists (use --force to replace it)" >&2
    exit 1
  fi

  mkdir -p "$(dirname "$OUT")"
  rm -f "$OUT"
  qemu-img create -f qcow2 "$OUT" "${SIZE_GB}G" >/dev/null

  # Sizes in MB. The spare takes what is left; everything else is only as big
  # as it needs to be to hold a filesystem and its markers.
  local esp_mb=512 sibling_mb=3072 home_mb=3072 swap_mb=1024

  # Written on the host because a loader entry needs two lines and guestfish
  # write takes one.
  local entry_file
  entry_file=$(mktemp)
  printf '%s\n' "$SIBLING_LOADER_ENTRY" >"$entry_file"

  guestfish --rw -a "$OUT" <<EOF
launch
part-init /dev/sda gpt

# p1: the ESP the sibling already boots from. The install must adopt this
# without reformatting it, so it is seeded like a real one.
part-add /dev/sda p 2048 $(( esp_mb * 2048 ))
part-set-bootable /dev/sda 1 true
part-set-gpt-type /dev/sda 1 C12A7328-F81F-11D2-BA4B-00A0C93EC93B
mkfs vfat /dev/sda1 label:SIBLINGEFI

# p2: everything else is one physical volume, which is what makes the disk
# report no free space and forces the full-disk path without the LVM mode.
part-add /dev/sda p $(( esp_mb * 2048 + 2048 )) -1024
pvcreate /dev/sda2
vgcreate $VG /dev/sda2

lvcreate $LV_SIBLING $VG $sibling_mb
lvcreate $LV_HOME $VG $home_mb
lvcreate $LV_SWAP $VG $swap_mb
lvcreate-free $LV_SPARE $VG 100

mkfs ext4 /dev/$VG/$LV_SIBLING
mkfs ext4 /dev/$VG/$LV_HOME label:$HOME_LABEL
mkswap-opts /dev/$VG/$LV_SWAP

# The spare is left with no filesystem at all. That is what the picker shows
# as "empty", and it is the only volume the install is allowed to format.

mount /dev/sda1 /
mkdir-p /EFI/systemd
mkdir-p /EFI/BOOT
mkdir-p /loader/entries
$(emit_bootloader_writes)
write /loader/loader.conf "timeout 30"
upload $entry_file /loader/entries/sibling.conf
# A kernel at the ESP root, which is where pacman's linux package puts it. If
# an install writes its own vmlinuz-linux here, this file changes and verify
# catches the collision.
write /vmlinuz-linux "sibling kernel stand-in"
write /initramfs-linux.img "sibling initramfs stand-in"
umount /

mount /dev/$VG/$LV_SIBLING /
$(emit_marker_writes "${SIBLING_MARKERS[@]}")
umount /

mount /dev/$VG/$LV_HOME /
$(emit_marker_writes "${HOME_MARKERS[@]}")
umount /
EOF

  rm -f "$entry_file"

  echo "Created $OUT"
  echo
  echo "Volume group $VG:"
  echo "  /dev/$VG/$LV_SIBLING  ext4, populated  — the sibling root; must survive"
  echo "  /dev/$VG/$LV_HOME     ext4 \"$HOME_LABEL\", populated — the home to adopt; must survive"
  echo "  /dev/$VG/$LV_SWAP     swap             — adopt, never reformat"
  echo "  /dev/$VG/$LV_SPARE    empty            — the only volume Omarchy may format"
  echo "  /dev/sda1             vfat, sibling bootloader — adopt, never reformat"
}

# Read a marker back. Prints nothing and returns non-zero when it is gone.
verify() {
  if [[ ! -e $OUT ]]; then
    echo "Error: $OUT does not exist; run 'create' first" >&2
    exit 1
  fi

  local failures=0 marker path contents actual

  check_marker() {
    local device="$1" path="$2" expected="$3" actual
    if ! actual=$(guestfish --ro -a "$OUT" -m "$device" cat "$path" 2>/dev/null); then
      printf '  FAIL %s:%s is gone\n' "$device" "$path"
      failures=$((failures + 1))
      return
    fi
    if [[ $actual == "$expected" ]]; then
      printf '  ok   %s:%s intact\n' "$device" "$path"
    else
      printf '  FAIL %s:%s changed\n    expected: %s\n    actual:   %s\n' \
        "$device" "$path" "$expected" "$actual"
      failures=$((failures + 1))
    fi
  }

  # A real binary is compared by digest rather than read into a shell.
  check_bootloader() {
    local path="$1" expected actual
    if ! have_real_bootloader; then
      check_marker /dev/sda1 "$path" "$SIBLING_BOOTLOADER_STANDIN"
      return
    fi
    expected=$(sha256sum "$SIBLING_BOOTLOADER" | cut -d' ' -f1)
    actual=$(guestfish --ro -a "$OUT" -m /dev/sda1 checksum sha256 "$path" 2>/dev/null || true)
    if [[ $actual == "$expected" ]]; then
      printf '  ok   /dev/sda1:%s intact (sha256)\n' "$path"
    else
      printf '  FAIL /dev/sda1:%s changed\n' "$path"
      failures=$((failures + 1))
    fi
  }

  printf '==> the sibling root must be untouched\n'
  for marker in "${SIBLING_MARKERS[@]}"; do
    check_marker "/dev/$VG/$LV_SIBLING" "${marker%%|*}" "${marker#*|}"
  done

  printf '==> the adopted home must be untouched\n'
  for marker in "${HOME_MARKERS[@]}"; do
    check_marker "/dev/$VG/$LV_HOME" "${marker%%|*}" "${marker#*|}"
  done

  printf '==> the sibling bootloader must still be on the ESP\n'
  check_bootloader /EFI/systemd/systemd-bootx64.efi
  check_marker /dev/sda1 /loader/entries/sibling.conf "$SIBLING_LOADER_ENTRY"
  # The fallback path every UEFI firmware will boot when an NVRAM entry is
  # missing. A bootloader installer that claims it takes the sibling's last
  # resort with it, which is worse than losing an entry: nothing on the boot
  # menu changes and the machine still stops booting the other system.
  check_bootloader /EFI/BOOT/BOOTX64.EFI
  # The sibling's own bootloader configuration, as opposed to its entries.
  check_marker /dev/sda1 /loader/loader.conf "timeout 30"
  # Round 2 of the adversarial review flagged this one specifically: an install
  # that mounts the adopted ESP at /boot has pacman write vmlinuz-linux to the
  # ESP root, over the sibling's.
  check_marker /dev/sda1 /vmlinuz-linux "sibling kernel stand-in"
  check_marker /dev/sda1 /initramfs-linux.img "sibling initramfs stand-in"

  printf '==> the home filesystem must not have been recreated\n'
  local label
  # No -m here, so the handle needs an explicit run: without it guestfish
  # never launches and vfs-label returns empty, which reads as a wiped label.
  label=$(guestfish --ro -a "$OUT" run : vfs-label "/dev/$VG/$LV_HOME" 2>/dev/null || true)
  if [[ $label == "$HOME_LABEL" ]]; then
    printf '  ok   %s still labelled %s\n' "$LV_HOME" "$HOME_LABEL"
  else
    printf '  FAIL %s label is "%s", expected "%s"\n' "$LV_HOME" "$label" "$HOME_LABEL"
    failures=$((failures + 1))
  fi

  if ((failures > 0)); then
    printf '\n%d check(s) failed — the install touched something it must not have\n' "$failures"
    exit 1
  fi
  printf '\nall markers intact\n'
}

"$command"
