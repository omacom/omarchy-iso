#!/bin/bash
# Prints the name a release's x86_64 ISO is published under.
#
#   release-iso-name <version>
#
# 4.5.0 and later are published as omarchy-<version>-x86.iso, the releases
# before it as omarchy-<version>.iso. Release candidates have used both
# <version>-rc<N> (4.5.0-rc2 onward) and <version>rc<N> (earlier candidates),
# so for a candidate we check both spellings across both layouts. Only a 404
# moves on to the next candidate: any other answer, a network error included,
# fails instead of naming the wrong file.
#
# Env: ISO_SITE (https://iso.omarchy.org)
set -euo pipefail
[[ $# -eq 1 ]] || { sed -n '2,13p' "$0" >&2; exit 2; }
version=$1
iso_site=${ISO_SITE:-https://iso.omarchy.org}
fail() { echo "release-iso-name: $*" >&2; exit 1; }

candidates=("omarchy-$version-x86.iso")
if [[ $version =~ ^([0-9]+(\.[0-9]+)+)-rc([0-9]+)$ ]]; then
  alt="${BASH_REMATCH[1]}rc${BASH_REMATCH[3]}"
  candidates+=("omarchy-$alt-x86.iso" "omarchy-$version.iso" "omarchy-$alt.iso")
elif [[ $version =~ ^([0-9]+(\.[0-9]+)+)rc([0-9]+)$ ]]; then
  alt="${BASH_REMATCH[1]}-rc${BASH_REMATCH[3]}"
  candidates+=("omarchy-$alt-x86.iso" "omarchy-$version.iso" "omarchy-$alt.iso")
else
  candidates+=("omarchy-$version.iso")
fi

last=$((${#candidates[@]} - 1))
for ((i = 0; i < last; i++)); do
  iso=${candidates[i]}
  status=$(curl -sSIL --retry 3 --retry-all-errors -o /dev/null -w '%{http_code}' "$iso_site/$iso") ||
    fail "could not reach $iso_site/$iso"
  case $status in
    200) echo "$iso"; exit 0 ;;
    404) ;;
    *) fail "$iso_site/$iso answered $status" ;;
  esac
done
echo "${candidates[last]}"
